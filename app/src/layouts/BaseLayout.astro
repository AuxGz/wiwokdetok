---
import "../styles/global.css";
import "lenis/dist/lenis.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SmoothScroll from "../components/common/SmoothScroll.astro";
import ChatbotWidget from "../components/landing/ChatbotWidget.astro";
import SeoHead from "../components/common/SeoHead.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  robots?: string;
  breadcrumbTitle?: string;
}

const {
  title,
  description,
  canonical,
  ogImage,
  ogType,
  robots,
  breadcrumbTitle,
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <SeoHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      ogType={ogType}
      robots={robots}
      breadcrumbTitle={breadcrumbTitle}
    />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="image" type="image/png" href="/images/brand/logo-telkom-schools.png" fetchpriority="high" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Poppins:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <ChatbotWidget />
    <SmoothScroll />
  </body>
</html>
