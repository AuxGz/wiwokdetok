---
import "../styles/global.css";
import "lenis/dist/lenis.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SmoothScroll from "../components/common/SmoothScroll.astro";
import ChatbotWidget from "../components/landing/ChatbotWidget.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "SMK Telkom Purwokerto | Official Website",
  description = "Portal Resmi SMK Telkom Purwokerto - Sekolah Menengah Kejuruan Berbasis Teknologi dan Industri Digital di Bawah Yayasan Pendidikan Telkom.",
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" type="image/png" href="/images/brand/logo-telkom-schools.png" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Poppins:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <ChatbotWidget />
    <SmoothScroll />
  </body>
</html>

