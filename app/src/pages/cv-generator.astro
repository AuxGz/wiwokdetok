---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
---

<BaseLayout
  title="CV Generator Siswa & Alumni | SMK Telkom Purwokerto"
  description="Buat CV profesional standar industri secara instan dan gratis khusus siswa dan alumni SMK Telkom Purwokerto."
>
  <!-- 1. HERO SECTION -->
  <section class="relative pt-6 pb-12 sm:pb-16 bg-[#fdfdfd] overflow-hidden" id="hero-cv">
    <Container>
      <div class="relative bg-gradient-to-br from-[#d62730] via-[#cd1820] to-[#c41d24] rounded-[24px] sm:rounded-[36px] pt-10 sm:pt-14 pb-10 sm:pb-14 px-6 sm:px-10 lg:px-16 shadow-[0_24px_48px_-12px_rgba(214,39,48,0.32)] overflow-hidden text-center">
        <!-- Concentric rings watermark -->
        <svg class="absolute inset-0 w-full h-full pointer-events-none z-0" viewBox="0 0 1440 400" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
          <circle cx="200" cy="160" r="140" stroke="rgba(0, 0, 0, 0.065)" stroke-width="42" />
          <circle cx="1200" cy="180" r="150" stroke="rgba(0, 0, 0, 0.06)" stroke-width="42" />
        </svg>

        <div class="relative z-10 max-w-3xl mx-auto flex flex-col items-center">
          <div class="inline-flex items-center gap-2 bg-white/15 backdrop-blur-md px-4 py-1.5 rounded-full text-white text-xs font-jakarta font-semibold tracking-wider uppercase mb-4 border border-white/20">
            <span>Layanan Siswa & Alumni</span>
          </div>

          <h1 class="font-poppins text-white font-bold text-3xl sm:text-4xl lg:text-5xl leading-[1.15] tracking-tight mb-4">
            CV Generator Profesional
          </h1>

          <p class="font-jakarta text-white/92 text-sm sm:text-base leading-relaxed max-w-xl">
            Buat curriculum vitae profesional berstandar industri dengan format modern ATS-friendly yang siap dikirim ke ratusan mitra industri teknologi.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- 2. SPLIT BUILDER INTERACTION -->
  <section class="py-10 sm:py-16 bg-white" id="cv-builder">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- LEFT: Form Input (7 Cols) -->
        <div class="lg:col-span-6 xl:col-span-6 bg-gray-50/70 border border-gray-200 rounded-3xl p-6 sm:p-8">
          <h2 class="font-poppins text-xl font-bold text-[#111827] mb-6 flex items-center justify-between">
            <span>Isi Data Resume</span>
            <span class="text-xs font-jakarta font-normal text-gray-400">Live Preview Real-time</span>
          </h2>

          <form id="cv-form" class="flex flex-col gap-6">
            <!-- Data Diri -->
            <div class="border-b border-gray-200 pb-5">
              <h3 class="font-jakarta text-sm font-bold text-[#111827] uppercase tracking-wider mb-3">1. Data Diri</h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                <div>
                  <label class="block font-jakarta text-xs font-medium text-gray-700 mb-1">Nama Lengkap</label>
                  <input type="text" id="input-name" class="w-full bg-white border border-gray-300 rounded-xl px-3.5 py-2.5 text-sm font-jakarta focus:outline-none focus:border-[#ed1e28]" placeholder="contoh: Muhammad Rizky Pratama" value="Muhammad Rizky Pratama" />
                </div>
                <div>
                  <label class="block font-jakarta text-xs font-medium text-gray-700 mb-1">Role / Keahlian</label>
                  <input type="text" id="input-title" class="w-full bg-white border border-gray-300 rounded-xl px-3.5 py-2.5 text-sm font-jakarta focus:outline-none focus:border-[#ed1e28]" placeholder="contoh: Junior Web Developer" value="Junior Web Developer" />
                </div>
                <div>
                  <label class="block font-jakarta text-xs font-medium text-gray-700 mb-1">Email</label>
                  <input type="email" id="input-email" class="w-full bg-white border border-gray-300 rounded-xl px-3.5 py-2.5 text-sm font-jakarta focus:outline-none focus:border-[#ed1e28]" placeholder="email@domain.com" value="rizky.pratama@gmail.com" />
                </div>
                <div>
                  <label class="block font-jakarta text-xs font-medium text-gray-700 mb-1">Nomor Telepon / WA</label>
                  <input type="tel" id="input-phone" class="w-full bg-white border border-gray-300 rounded-xl px-3.5 py-2.5 text-sm font-jakarta focus:outline-none focus:border-[#ed1e28]" placeholder="081234567890" value="0812-3456-7890" />
                </div>
              </div>
            </div>

            <!-- Pendidikan & Jurusan -->
            <div class="border-b border-gray-200 pb-5">
              <h3 class="font-jakarta text-sm font-bold text-[#111827] uppercase tracking-wider mb-3">2. Jurusan & Pendidikan</h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                <div>
                  <label class="block font-jakarta text-xs font-medium text-gray-700 mb-1">Program Keahlian</label>
                  <select id="input-jurusan" class="w-full bg-white border border-gray-300 rounded-xl px-3.5 py-2.5 text-sm font-jakarta focus:outline-none focus:border-[#ed1e28]">
                    <option value="Rekayasa Perangkat Lunak (RPL)" selected>Rekayasa Perangkat Lunak (RPL)</option>
                    <option value="Teknik Komputer & Jaringan (TKJ)">Teknik Komputer & Jaringan (TKJ)</option>
                    <option value="Pengembangan Game (PG)">Pengembangan Game (PG)</option>
                    <option value="Teknik Jaringan Akses (TJA)">Teknik Jaringan Akses (TJA)</option>
                  </select>
                </div>
                <div>
                  <label class="block font-jakarta text-xs font-medium text-gray-700 mb-1">Tahun Kelulusan / Angkatan</label>
                  <input type="text" id="input-year" class="w-full bg-white border border-gray-300 rounded-xl px-3.5 py-2.5 text-sm font-jakarta focus:outline-none focus:border-[#ed1e28]" value="2024 - 2027 (Kelas XI)" />
                </div>
              </div>
            </div>

            <!-- Ringkasan Profil -->
            <div class="border-b border-gray-200 pb-5">
              <h3 class="font-jakarta text-sm font-bold text-[#111827] uppercase tracking-wider mb-3">3. Ringkasan Pribadi (Summary)</h3>
              <textarea id="input-summary" rows="3" class="w-full bg-white border border-gray-300 rounded-xl px-3.5 py-2.5 text-sm font-jakarta focus:outline-none focus:border-[#ed1e28]" placeholder="Ceritakan ketertarikan dan keahlian Anda secara ringkas...">Siswa jurusan Rekayasa Perangkat Lunak SMK Telkom Purwokerto yang memiliki ketertarikan tinggi pada pemrograman frontend dan backend. Memiliki pengalaman membangun proyek web berbasis modern stack dan aktif dalam kegiatan riset coding sekolah.</textarea>
            </div>

            <!-- Keahlian Teknis -->
            <div class="border-b border-gray-200 pb-5">
              <h3 class="font-jakarta text-sm font-bold text-[#111827] uppercase tracking-wider mb-3">4. Keahlian Teknis (Skills)</h3>
              <input type="text" id="input-skills" class="w-full bg-white border border-gray-300 rounded-xl px-3.5 py-2.5 text-sm font-jakarta focus:outline-none focus:border-[#ed1e28]" placeholder="Pisahkan dengan koma" value="HTML, CSS, JavaScript, TypeScript, React, Tailwind CSS, Git & GitHub, REST API, SQL" />
            </div>

            <!-- Proyek & Pengalaman -->
            <div>
              <h3 class="font-jakarta text-sm font-bold text-[#111827] uppercase tracking-wider mb-3">5. Pengalaman Proyek Utama</h3>
              <div class="flex flex-col gap-3">
                <input type="text" id="input-project-title" class="w-full bg-white border border-gray-300 rounded-xl px-3.5 py-2.5 text-sm font-jakarta focus:outline-none focus:border-[#ed1e28]" value="Website E-Commerce Produk Siswa Telkom" />
                <textarea id="input-project-desc" rows="2" class="w-full bg-white border border-gray-300 rounded-xl px-3.5 py-2.5 text-sm font-jakarta focus:outline-none focus:border-[#ed1e28]">Mengembangkan platform jual-beli karya kreatif siswa menggunakan stack modern dengan integrasi payment gateway dan panel admin terpusat.</textarea>
              </div>
            </div>
          </form>
        </div>

        <!-- RIGHT: Live Document Preview (6 Cols) -->
        <div class="lg:col-span-6 xl:col-span-6 sticky top-24">
          <div class="flex items-center justify-between mb-4">
            <span class="font-jakarta text-xs font-semibold text-gray-500 uppercase tracking-wider">Format Standar Industri</span>
            <button
              type="button"
              id="print-cv-btn"
              class="bg-[#ed1e28] hover:bg-[#d81820] text-white font-jakarta text-xs font-bold px-4 py-2 rounded-full cursor-pointer shadow-xs transition-all flex items-center gap-1.5"
            >
              <span>🖨️ Cetak / Unduh PDF</span>
            </button>
          </div>

          <!-- Document Sheet Preview -->
          <div id="cv-paper" class="bg-white border border-gray-300 rounded-2xl shadow-xl p-8 sm:p-10 text-gray-900 transition-all font-jakarta">
            <!-- Header Bar -->
            <div class="border-b-2 border-[#ed1e28] pb-5 mb-5">
              <h1 id="preview-name" class="font-poppins font-extrabold text-2xl text-[#111827] leading-tight mb-1">
                Muhammad Rizky Pratama
              </h1>
              <p id="preview-title" class="text-sm font-semibold text-[#ed1e28] mb-2">
                Junior Web Developer
              </p>
              <div class="flex items-center gap-3 text-xs text-gray-500 flex-wrap">
                <span id="preview-email">rizky.pratama@gmail.com</span>
                <span>•</span>
                <span id="preview-phone">0812-3456-7890</span>
                <span>•</span>
                <span>Purwokerto, Jawa Tengah</span>
              </div>
            </div>

            <!-- Profile Summary -->
            <div class="mb-5">
              <h4 class="font-poppins text-xs font-bold uppercase tracking-wider text-gray-800 mb-1.5 border-b border-gray-100 pb-1">
                Ringkasan Profesional
              </h4>
              <p id="preview-summary" class="text-xs text-gray-600 leading-relaxed">
                Siswa jurusan Rekayasa Perangkat Lunak SMK Telkom Purwokerto yang memiliki ketertarikan tinggi pada pemrograman frontend dan backend. Memiliki pengalaman membangun proyek web berbasis modern stack dan aktif dalam kegiatan riset coding sekolah.
              </p>
            </div>

            <!-- Education -->
            <div class="mb-5">
              <h4 class="font-poppins text-xs font-bold uppercase tracking-wider text-gray-800 mb-1.5 border-b border-gray-100 pb-1">
                Pendidikan
              </h4>
              <div class="flex justify-between items-start">
                <div>
                  <strong class="text-xs font-bold text-[#111827] block">SMK Telkom Purwokerto</strong>
                  <span id="preview-jurusan" class="text-xs text-gray-600">Rekayasa Perangkat Lunak (RPL)</span>
                </div>
                <span id="preview-year" class="text-[0.6875rem] text-gray-400 font-medium">2024 - 2027 (Kelas XI)</span>
              </div>
            </div>

            <!-- Skills -->
            <div class="mb-5">
              <h4 class="font-poppins text-xs font-bold uppercase tracking-wider text-gray-800 mb-1.5 border-b border-gray-100 pb-1">
                Keahlian Teknis
              </h4>
              <p id="preview-skills" class="text-xs text-gray-600 leading-relaxed font-mono">
                HTML, CSS, JavaScript, TypeScript, React, Tailwind CSS, Git & GitHub, REST API, SQL
              </p>
            </div>

            <!-- Projects -->
            <div>
              <h4 class="font-poppins text-xs font-bold uppercase tracking-wider text-gray-800 mb-1.5 border-b border-gray-100 pb-1">
                Portofolio Proyek
              </h4>
              <strong id="preview-project-title" class="text-xs font-bold text-[#111827] block mb-0.5">
                Website E-Commerce Produk Siswa Telkom
              </strong>
              <p id="preview-project-desc" class="text-xs text-gray-600 leading-relaxed">
                Mengembangkan platform jual-beli karya kreatif siswa menggunakan stack modern dengan integrasi payment gateway dan panel admin terpusat.
              </p>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

<script>
  const inputName = document.getElementById("input-name") as HTMLInputElement;
  const inputTitle = document.getElementById("input-title") as HTMLInputElement;
  const inputEmail = document.getElementById("input-email") as HTMLInputElement;
  const inputPhone = document.getElementById("input-phone") as HTMLInputElement;
  const inputJurusan = document.getElementById("input-jurusan") as HTMLSelectElement;
  const inputYear = document.getElementById("input-year") as HTMLInputElement;
  const inputSummary = document.getElementById("input-summary") as HTMLTextAreaElement;
  const inputSkills = document.getElementById("input-skills") as HTMLInputElement;
  const inputProjectTitle = document.getElementById("input-project-title") as HTMLInputElement;
  const inputProjectDesc = document.getElementById("input-project-desc") as HTMLTextAreaElement;

  const previewName = document.getElementById("preview-name");
  const previewTitle = document.getElementById("preview-title");
  const previewEmail = document.getElementById("preview-email");
  const previewPhone = document.getElementById("preview-phone");
  const previewJurusan = document.getElementById("preview-jurusan");
  const previewYear = document.getElementById("preview-year");
  const previewSummary = document.getElementById("preview-summary");
  const previewSkills = document.getElementById("preview-skills");
  const previewProjectTitle = document.getElementById("preview-project-title");
  const previewProjectDesc = document.getElementById("preview-project-desc");

  function bindInput(input: HTMLElement | null, preview: HTMLElement | null) {
    if (!input || !preview) return;
    input.addEventListener("input", () => {
      preview.textContent = (input as HTMLInputElement).value || "—";
    });
  }

  bindInput(inputName, previewName);
  bindInput(inputTitle, previewTitle);
  bindInput(inputEmail, previewEmail);
  bindInput(inputPhone, previewPhone);
  bindInput(inputJurusan, previewJurusan);
  bindInput(inputYear, previewYear);
  bindInput(inputSummary, previewSummary);
  bindInput(inputSkills, previewSkills);
  bindInput(inputProjectTitle, previewProjectTitle);
  bindInput(inputProjectDesc, previewProjectDesc);

  const printBtn = document.getElementById("print-cv-btn");
  if (printBtn) {
    printBtn.addEventListener("click", () => {
      window.print();
    });
  }
</script>
