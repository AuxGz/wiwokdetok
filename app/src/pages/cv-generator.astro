---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import { CvApp } from "../components/cv/CvApp";
---

<BaseLayout
  title="CV Generator Siswa RPL - SMK Telkom Purwokerto"
  description="Buat CV ATS-friendly profesional standar industri langsung di browsermu dengan preview interaktif A4 dan ekspor PDF siap kirim."
>
  <style is:global>
    /* Print Layout Styling for A4 Paper */
    @page {
      size: A4 portrait;
      margin: 0;
    }

    @media print {
      /* Sembunyikan semua elemen navigasi, header, footer, tombol, dan chatbot */
      header,
      footer,
      nav,
      #chatbot-widget,
      .cv-no-print,
      button {
        display: none !important;
      }

      body, html {
        background: white !important;
        margin: 0 !important;
        padding: 0 !important;
        width: 210mm !important;
        height: auto !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }

      main {
        margin: 0 !important;
        padding: 0 !important;
      }

      /* Tampilkan hanya container preview kertas CV */
      .cv-preview-paper {
        box-shadow: none !important;
        margin: 0 !important;
        padding: 16mm 18mm !important;
        width: 210mm !important;
        min-height: 297mm !important;
        transform: none !important;
      }

      .cv-section-block,
      .cv-entry-item {
        break-inside: avoid !important;
        page-break-inside: avoid !important;
      }
    }

    /* Penyesuaian widget chatbot agar tidak menutupi aksi CV di layar mobile */
    @media (max-width: 768px) {
      #chatbot-widget {
        bottom: 5.5rem !important;
        right: 1rem !important;
        transform: scale(0.9);
        transform-origin: bottom right;
      }
      #chat-callout {
        display: none !important;
      }
    }
  </style>

  <div class="py-6 sm:py-10 bg-[#F7F8F9]">
    <Container>
      <!-- Section 1: Hero Card (Figma Section #1557:1627: radius 32px) -->
      <div class="relative overflow-hidden rounded-[32px] bg-gradient-to-tr from-[#ED1E28] via-[#D0161F] to-[#B6252A] p-8 sm:p-12 md:p-16 text-white text-center shadow-xl mb-10 cv-no-print">
        <div class="absolute -top-24 -left-24 w-96 h-96 rounded-full bg-white/10 blur-[80px] pointer-events-none"></div>
        <div class="absolute -bottom-24 -right-24 w-96 h-96 rounded-full bg-black/20 blur-[80px] pointer-events-none"></div>

        <div class="relative z-10 max-w-4xl mx-auto space-y-5">
          <!-- Pill Badge (Figma #1557:1633) -->
          <div class="inline-flex items-center px-4 py-1.5 rounded-full bg-white/10 border border-white/20 backdrop-blur-md text-xs sm:text-sm font-semibold tracking-wide">
            CV GENERATOR SISWA RPL
          </div>

          <!-- Heading 1 (Figma #1557:1638) -->
          <h1 class="font-extrabold text-3xl sm:text-5xl md:text-6xl font-sans tracking-tight leading-[1.15]">
            Buat CV Impianmu,<br class="hidden sm:inline" /> Langsung Lihat Hasilnya
          </h1>

          <!-- Subtitle (Figma #1557:1642) -->
          <p class="text-white/85 text-sm sm:text-base md:text-lg max-w-3xl mx-auto leading-relaxed">
            Ruang kerja interaktif standar ATS untuk siswa kejuruan. Susun data diri, pendidikan, pengalaman proyek aplikasi, dan keahlian teknis secara langsung dengan audit kelengkapan dan pratinjau kertas A4 siap cetak ke PDF.
          </p>
        </div>
      </div>

      <!-- Section 2: React Interactive Application Island -->
      <CvApp client:load />
    </Container>
  </div>
</BaseLayout>
