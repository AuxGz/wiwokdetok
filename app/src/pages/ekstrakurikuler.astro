---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";

// 6 Kegiatan Ekstrakurikuler exact from Figma frame #682:1059 (fallback default)
const defaultEkskulList = [
  {
    name: "Badminton",
    image: "/images/kegiatan/kegiatan-seni.png",
    desc: "Olahraga bulutangkis untuk melatih ketangkasan, refleks, stamina, serta teknik bertanding yang kompetitif di berbagai kejuaraan.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />`
  },
  {
    name: "Basket",
    image: "/images/kegiatan/kegiatan-basket.png",
    desc: "Olahraga basket kompetitif antar sekolah yang melatih kerjasama tim, strategi, dan kebugaran fisik para siswa.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />`
  },
  {
    name: "Futsal",
    image: "/images/kegiatan/kegiatan-futsal.png",
    desc: "Olahraga futsal tim sekolah yang mengasah kemampuan teknis, kecepatan, dan kerjasama dalam pertandingan antar sekolah.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />`
  },
  {
    name: "Paskibra",
    image: "/images/kegiatan/kegiatan-paskibra.png",
    desc: "Paskibra adalah ekskul baris-berbaris untuk melatih kedisiplinan dan mempersiapkan petugas pengibar bendera sekolah.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9" />`
  },
  {
    name: "Pramuka",
    image: "/images/kegiatan/kegiatan-pramuka.png",
    desc: "Kegiatan kepanduan untuk membentuk karakter siswa yang disiplin, mandiri, dan bertanggung jawab melalui berbagai kegiatan alam dan sosial.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z" />`
  },
  {
    name: "PMR (Palang Merah Remaja)",
    image: "/images/kegiatan/kegiatan-paduan-suara.png",
    desc: "Kegiatan palang merah remaja dan pertolongan pertama yang melatih siswa untuk siap membantu sesama dalam situasi darurat.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />`
  }
];

let ekskulList = defaultEkskulList;

try {
  const { prisma } = await import("../server/lib/prisma.js");
  const dbEkskul = await prisma.extracurricular.findMany({
    orderBy: { order: "asc" },
  });

  if (dbEkskul && dbEkskul.length > 0) {
    ekskulList = dbEkskul.map((e, idx) => ({
      name: e.name,
      image: e.imageUrl || defaultEkskulList[idx % defaultEkskulList.length]?.image || "/images/kegiatan/kegiatan-seni.png",
      desc: e.description,
      icon: e.icon || defaultEkskulList[idx % defaultEkskulList.length]?.icon || defaultEkskulList[0].icon,
    }));
  }
} catch {
  // Gunakan data default jika database offline atau belum terisi
}
---

<BaseLayout
  title="Ekstrakurikuler - SMK Telkom Purwokerto"
  description="Kegiatan ekstrakurikuler di SMK Telkom Purwokerto untuk mengembangkan bakat, minat, dan potensi siswa di luar akademik."
>
  <!-- Section 1: Hero Banner (Figma Section #1145:4204) -->
  <section class="relative w-full h-[380px] sm:h-[420px] overflow-hidden">
    <!-- Background Image -->
    <img
      src="/images/kegiatan/extrakurikuler-banner.png"
      alt="Kegiatan Ekstrakurikuler SMK Telkom Purwokerto"
      class="absolute inset-0 w-full h-full object-cover object-center"
      width="1920"
      height="420"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    
    <!-- Exact Gradient Overlay from Figma: linear-gradient(180deg, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0.55) 50%, rgba(0, 0, 0, 0.7) 100%) -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/55 to-black/70"></div>

    <!-- Centered Content -->
    <div class="relative z-10 w-full h-full flex items-center justify-center">
      <h1 class="font-poppins font-bold text-4xl sm:text-5xl md:text-6xl text-white tracking-[-0.025em] text-center drop-shadow-md">
        Ekstrakurikuler
      </h1>
    </div>

    <!-- Exact Red Bottom Accent Bar (height: 25px, fill: #ED1E28) -->
    <div class="absolute bottom-0 left-0 right-0 h-[20px] sm:h-[25px] bg-[#ED1E28]"></div>
  </section>

  <!-- Section 2: Main Content (Figma ekstrakurikuler #1145:4220) -->
  <section class="py-16 md:py-24 bg-white">
    <Container>
      <!-- Title & Description Container (Figma #1145:4221) -->
      <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
        <h2 class="font-bold text-2xl sm:text-3xl md:text-[30px] leading-tight text-black tracking-[0.001em] font-sans">
          Kegiatan Ekstrakurikuler
        </h2>

        <!-- Red Accent Indicator (width: 80px, height: 4px, fill: #BD0C12, borderRadius: 9999px) -->
        <div class="w-20 h-1 bg-[#BD0C12] rounded-full mx-auto"></div>

        <!-- Description (Figma #1145:4227) -->
        <p class="text-[#55565B] text-sm sm:text-base leading-relaxed pt-2 max-w-2xl mx-auto">
          SMK Telkom Purwokerto menyediakan berbagai kegiatan ekstrakurikuler untuk mengembangkan bakat, minat, dan potensi siswa di luar kegiatan akademik. Setiap kegiatan dirancang untuk membentuk karakter unggul dan profesional.
        </p>
      </div>

      <!-- 6 Grid Cards (Figma HoverEskul #1641:13986: 3 cols, gap: 52px) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10 lg:gap-12 max-w-[1320px] mx-auto">
        {ekskulList.map((item) => (
          <div class="group bg-white rounded-xl border border-[#F3F4F6] shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden flex flex-col justify-between">
            <!-- Card Image Container -->
            <div class="relative w-full aspect-[16/11] overflow-hidden bg-neutral-100">
              <img
                src={item.image}
                alt={item.name}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                width="400"
                height="275"
                loading="lazy"
                decoding="async"
              />
            </div>

            <!-- Card Body Container (Figma #1641:13691) -->
            <div class="p-6 sm:p-7 space-y-3.5 flex-1 flex flex-col justify-between">
              <div class="space-y-3">
                <div class="flex items-center gap-3">
                  <!-- Red Badge Overlay (Figma #1641:13693: bg: rgba(189,12,18,0.1), borderRadius: 9999px) -->
                  <div class="w-9 h-9 rounded-full bg-[#BD0C12]/10 flex items-center justify-center text-[#BD0C12] shrink-0">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <Fragment set:html={item.icon} />
                    </svg>
                  </div>
                  <h3 class="font-bold text-lg sm:text-xl text-black font-sans">
                    {item.name}
                  </h3>
                </div>

                <p class="text-[#55565B] text-sm leading-relaxed">
                  {item.desc}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>
</BaseLayout>
