---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/landing/HeroSection.astro";
import StatsSection from "../components/landing/StatsSection.astro";
import AboutSection from "../components/landing/AboutSection.astro";
import SambutanSection from "../components/landing/SambutanSection.astro";
import KerjasamaSection from "../components/landing/KerjasamaSection.astro";
import WhyUsSection from "../components/landing/WhyUsSection.astro";
import JurusanSection from "../components/landing/JurusanSection.astro";
import PpdbCtaSection from "../components/landing/PpdbCtaSection.astro";
import AlumniSection from "../components/landing/AlumniSection.astro";
import BeritaSection from "../components/landing/BeritaSection.astro";
import NexelSection from "../components/landing/NexelSection.astro";
import FaqSection from "../components/landing/FaqSection.astro";
---

<BaseLayout
  title="SMK Telkom Purwokerto | Pelopor Pendidikan Vokasi Teknologi Digital"
  description="Website resmi SMK Telkom Purwokerto. Menyelenggarakan program keahlian RPL, TKJ, TJA, dan DKV berstandar industri bersama Yayasan Pendidikan Telkom."
>
  <HeroSection />

  <StatsSection />

  <div class="reveal-on-scroll">
    <AboutSection />
  </div>

  <div class="reveal-on-scroll">
    <SambutanSection />
  </div>

  <div class="reveal-on-scroll">
    <WhyUsSection />
  </div>

  <div class="reveal-on-scroll">
    <KerjasamaSection />
  </div>

  <div class="reveal-on-scroll">
    <JurusanSection />
  </div>

  <div class="reveal-on-scroll">
    <PpdbCtaSection />
  </div>

  <div class="reveal-on-scroll">
    <AlumniSection />
  </div>

  <div class="reveal-on-scroll">
    <BeritaSection />
  </div>

  <div class="reveal-on-scroll">
    <NexelSection />
  </div>

  <div class="reveal-on-scroll">
    <FaqSection />
  </div>
</BaseLayout>

<script>
  function initScrollReveal() {
    const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (prefersReduced) return;

    // Tandai dokumen siap scroll reveal
    document.documentElement.classList.add("scroll-ready");

    const revealElements = document.querySelectorAll<HTMLElement>(".reveal-on-scroll");
    if (!revealElements.length) return;

    // Pengecekan instan awal
    const windowHeight = window.innerHeight;
    revealElements.forEach((el) => {
      const rect = el.getBoundingClientRect();
      if (rect.top <= windowHeight * 0.65) {
        el.classList.add("is-visible");
      }
    });

    // IntersectionObserver dengan konfigurasi aman
    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            obs.unobserve(entry.target);
          }
        });
      },
      {
        root: null,
        rootMargin: "0px 0px -25% 0px",
        threshold: 0.04,
      }
    );

    revealElements.forEach((el) => {
      if (!el.classList.contains("is-visible")) {
        observer.observe(el);
      }
    });

    // Safety scroll listener cadangan agar konten dijamin 100% selalu muncul saat user scroll
    window.addEventListener(
      "scroll",
      () => {
        revealElements.forEach((el) => {
          if (!el.classList.contains("is-visible")) {
            const rect = el.getBoundingClientRect();
            if (rect.top <= windowHeight * 0.88) {
              el.classList.add("is-visible");
            }
          }
        });
      },
      { passive: true }
    );
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initScrollReveal);
  } else {
    initScrollReveal();
  }
</script>
