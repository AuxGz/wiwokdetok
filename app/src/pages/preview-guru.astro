---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import SymmetryCarousel from "../components/guru/SymmetryCarousel.astro";
import { dataPimpinan, dataKaur } from "../data/guru-data";

const stats = [
  {
    number: "60+",
    display: "60+",
    title: "Guru Bersertifikat",
    desc: "Tenaga pengajar profesional tersertifikasi nasional & industri",
  },
  {
    number: "4",
    display: "4",
    title: "Jurusan Unggulan",
    desc: "Program studi kejuruan berstandar industri teknologi terkemuka",
  },
  {
    number: "100%",
    display: "100%",
    title: "Tingkat Kelulusan",
    desc: "Persentase kelulusan siswa berkarakter unggul setiap tahun",
  },
  {
    number: "50+",
    display: "50+",
    title: "Penghargaan Nasional",
    desc: "Prestasi akademik dan kejuruan tingkat regional hingga nasional",
  },
];
---

<BaseLayout
  title="[Preview] Profil Pimpinan & Tenaga Pendidik | SMK Telkom Purwokerto"
  description="Halaman pratinjau struktur kepemimpinan, wakil kepala sekolah, dan tim urusan SMK Telkom Purwokerto Tahun Ajaran 2025/2026."
>
  <!-- Interactive Preview Badge Notice -->
  <div class="bg-[#111827] text-white py-2.5 px-4 text-center border-b border-white/10 relative z-20">
    <div class="max-w-[1140px] mx-auto flex flex-wrap items-center justify-between gap-3 text-xs font-jakarta">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-[#ed1e28] text-white uppercase tracking-wider">
          Draft Preview
        </span>
        <span class="text-slate-300">
          Uji Coba Struktur Hierarki Sidoarjo & Symmetry 3D Carousel (Halaman Asli Tetap Aman di <a href="/profile-guru" class="underline hover:text-white">/profile-guru</a>)
        </span>
      </div>
      <div class="flex items-center gap-3">
        <a href="#waka-carousel" class="text-slate-300 hover:text-white transition-colors">Wakil Kepala</a>
        <span class="text-slate-600">•</span>
        <a href="#tim-kaur" class="text-slate-300 hover:text-white transition-colors">Kepala Urusan</a>
        <span class="text-slate-600">•</span>
        <a href="#bagan-organisasi" class="text-slate-300 hover:text-white transition-colors">Bagan Lengkap</a>
      </div>
    </div>
  </div>

  <!-- Hero Section: Profil Kepala Sekolah -->
  <section class="relative pt-10 sm:pt-16 pb-16 sm:pb-24 bg-white overflow-hidden" id="kepala-sekolah">
    <Container>
      <div class="max-w-[1140px] mx-auto grid grid-cols-1 lg:grid-cols-[1.18fr_0.82fr] gap-10 lg:gap-14 items-center">
        <!-- Left Column: Copy & Identity -->
        <div class="flex flex-col items-start text-left z-2">
          <!-- Red Pill Tag -->
          <div class="inline-flex items-center bg-[#ed1e28] text-white font-poppins text-xs font-bold py-1.5 px-4 rounded-full mb-6 tracking-[0.06em] shadow-[0_2px_8px_rgba(237,30,40,0.25)]">
            <span>Kepala Sekolah</span>
          </div>

          <!-- Main Name -->
          <h1 class="font-poppins text-3xl sm:text-5xl lg:text-[3.5rem] font-bold text-[#111827] leading-[1.12] tracking-[-0.025em] mb-6">
            Aris Puji Santoso,<br />S.Kom., M.M
          </h1>

          <!-- Vision Quote -->
          <p class="font-jakarta text-base sm:text-lg text-[#64748b] leading-[1.7] max-w-[540px]">
            "Mendidik generasi unggul dengan karakter kuat, kompetensi teknologi berdaya saing global, dan integritas kepemimpinan yang berakhlak mulia."
          </p>

          <!-- Quick Roles Tags -->
          <div class="mt-8 flex flex-wrap gap-2.5">
            <span class="text-xs font-semibold font-jakarta px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-700 border border-slate-200">
              SMK Telkom Purwokerto
            </span>
            <span class="text-xs font-semibold font-jakarta px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-700 border border-slate-200">
              Periode 2025/2026
            </span>
            <span class="text-xs font-semibold font-jakarta px-3.5 py-1.5 rounded-full bg-[#fef2f2] text-[#ed1e28] border border-[#ed1e28]/20">
              Akreditasi A Unggul
            </span>
          </div>
        </div>

        <!-- Right Column: Photo Card with Red Accent Frame -->
        <div class="flex justify-center lg:justify-end items-center z-2">
          <div class="relative w-[280px] sm:w-[320px] lg:w-[340px]">
            <!-- Decorative Red Offset Card Behind -->
            <div class="absolute -top-2.5 -right-2.5 w-full h-full bg-[#fef2f2] border-2 border-[#ed1e28] rounded-[24px] pointer-events-none -z-1" aria-hidden="true"></div>

            <!-- Main White Card Container -->
            <div class="relative bg-white border-2 border-[#ed1e28] rounded-[22px] overflow-hidden shadow-[0_16px_36px_rgba(237,30,40,0.08)] flex flex-col items-center">
              <div class="w-full pt-4 px-4 flex justify-center items-end h-[360px] sm:h-[410px]">
                <img
                  src="/images/guru/kepala-sekolah.png"
                  alt="Aris Puji Santoso, S.Kom., M.M - Kepala Sekolah SMK Telkom Purwokerto"
                  class="h-full w-auto object-contain object-bottom block"
                  width="530"
                  height="796"
                  loading="eager"
                />
              </div>

              <!-- Bottom Red Banner Label -->
              <div class="w-full bg-[#ed1e28] py-2.5 text-center">
                <span class="font-poppins text-xs font-bold text-white tracking-[0.14em] uppercase block">
                  KEPALA SEKOLAH
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Seksi 1: Wakil Kepala Bidang & Manajemen (Symmetry 3D Carousel) -->
  <section class="relative pt-16 sm:pt-24 pb-20 sm:pb-28 bg-[#fafafa] border-t border-slate-100 overflow-hidden" id="waka-carousel">
    <!-- Subtle Dot Grid Background -->
    <svg class="absolute inset-0 w-full h-full pointer-events-none z-0" viewBox="0 0 1440 600" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <defs>
        <pattern id="waka-dot-pat" x="0" y="0" width="32" height="32" patternUnits="userSpaceOnUse">
          <circle cx="16" cy="16" r="1.5" fill="#ed1e28" fill-opacity="0.06" />
        </pattern>
      </defs>
      <rect width="1440" height="600" fill="url(#waka-dot-pat)" />
    </svg>

    <Container>
      <div class="relative z-1 max-w-[1140px] mx-auto">
        <!-- Section Header -->
        <div class="text-center max-w-[700px] mx-auto mb-10 sm:mb-14">
          <div class="inline-flex items-center gap-2 text-xs font-bold text-[#ed1e28] uppercase tracking-[0.15em] font-poppins mb-2.5">
            <span class="w-2 h-2 rounded-full bg-[#ed1e28]"></span>
            <span>SMK Telkom Purwokerto</span>
          </div>
          <h2 class="font-poppins text-2xl sm:text-4xl lg:text-[2.75rem] font-bold text-[#111827] tracking-[-0.02em] leading-tight mb-4">
            Wakil Kepala Bidang & Manajemen
          </h2>
          <p class="font-jakarta text-sm sm:text-base text-[#64748b] leading-relaxed">
            Jajaran pimpinan operasional yang memegang komando strategis dalam tata kelola akademik, infrastruktur teknologi, hubungan industri, kesiswaan, dan administrasi sekolah.
          </p>
        </div>

        <!-- 3D Symmetry Carousel Component -->
        <SymmetryCarousel items={dataPimpinan} />
      </div>
    </Container>
  </section>

  <!-- Seksi 2: Tim Urusan (Kaur) & Program Keahlian (Filterable Interactive Grid) -->
  <section class="relative pt-16 sm:pt-24 pb-20 sm:pb-28 bg-white border-t border-slate-100" id="tim-kaur">
    <Container>
      <div class="max-w-[1140px] mx-auto">
        <!-- Section Header -->
        <div class="text-center max-w-[650px] mx-auto mb-10 sm:mb-12">
          <div class="inline-flex items-center gap-2 text-xs font-bold text-[#ed1e28] uppercase tracking-[0.15em] font-poppins mb-2">
            <span class="w-2 h-2 rounded-full bg-[#ed1e28]"></span>
            <span>Tata Kelola Operasional</span>
          </div>
          <h2 class="font-poppins text-2xl sm:text-4xl font-bold text-[#111827] tracking-[-0.02em] mb-4">
            Kepala Urusan & Koordinator
          </h2>
          <p class="font-jakarta text-sm sm:text-base text-[#64748b]">
            Para penggerak operasional di setiap lini unit kerja yang memastikan seluruh program kejuruan, layanan kesiswaan, dan tata kelola berjalan dengan standar mutu prima.
          </p>
        </div>

        <!-- Filter Tabs -->
        <div class="flex flex-wrap justify-center gap-2 mb-10" id="kaur-filter-group">
          <button
            type="button"
            class="kaur-filter-btn px-4 py-2 rounded-full text-xs font-bold font-jakarta transition-all duration-200 bg-[#ed1e28] text-white shadow-xs cursor-pointer"
            data-filter="all"
          >
            Semua Tim Urusan ({dataKaur.length})
          </button>
          <button
            type="button"
            class="kaur-filter-btn px-4 py-2 rounded-full text-xs font-bold font-jakarta transition-all duration-200 bg-slate-100 text-slate-700 hover:bg-slate-200 cursor-pointer"
            data-filter="Kurikulum"
          >
            Kurikulum & Akademik
          </button>
          <button
            type="button"
            class="kaur-filter-btn px-4 py-2 rounded-full text-xs font-bold font-jakarta transition-all duration-200 bg-slate-100 text-slate-700 hover:bg-slate-200 cursor-pointer"
            data-filter="IT & SarPra"
          >
            IT & Sarpras
          </button>
          <button
            type="button"
            class="kaur-filter-btn px-4 py-2 rounded-full text-xs font-bold font-jakarta transition-all duration-200 bg-slate-100 text-slate-700 hover:bg-slate-200 cursor-pointer"
            data-filter="Hubin"
          >
            Hubin & Kemitraan
          </button>
          <button
            type="button"
            class="kaur-filter-btn px-4 py-2 rounded-full text-xs font-bold font-jakarta transition-all duration-200 bg-slate-100 text-slate-700 hover:bg-slate-200 cursor-pointer"
            data-filter="Kesiswaan"
          >
            Kesiswaan & Prestasi
          </button>
          <button
            type="button"
            class="kaur-filter-btn px-4 py-2 rounded-full text-xs font-bold font-jakarta transition-all duration-200 bg-slate-100 text-slate-700 hover:bg-slate-200 cursor-pointer"
            data-filter="Administrasi"
          >
            Administrasi & TU
          </button>
        </div>

        <!-- Kaur Cards Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="kaur-grid">
          {
            dataKaur.map((item) => (
              <div
                class="kaur-card bg-white border border-slate-200/90 rounded-[22px] p-6 shadow-xs hover:-translate-y-1 hover:shadow-md hover:border-[#ed1e28]/40 transition-all duration-200 flex flex-col justify-between"
                data-bidang={item.bidang}
              >
                <div>
                  <div class="flex items-center gap-4 mb-4">
                    <div class="w-16 h-16 rounded-full p-0.5 bg-gradient-to-tr from-[#ed1e28] to-slate-200 shrink-0">
                      <div class="w-full h-full rounded-full bg-white overflow-hidden p-0.5">
                        <img
                          src={item.image}
                          alt={item.name}
                          class="w-full h-full object-cover object-top rounded-full"
                          loading="lazy"
                        />
                      </div>
                    </div>
                    <div>
                      <span class="inline-block text-[10px] font-bold uppercase tracking-wider font-poppins text-[#ed1e28] bg-[#fef2f2] px-2.5 py-0.5 rounded-full mb-1">
                        {item.categoryLabel}
                      </span>
                      <h4 class="font-poppins text-base font-bold text-[#111827] leading-tight">
                        {item.name}
                      </h4>
                    </div>
                  </div>
                  <div class="font-jakarta text-xs font-semibold text-[#ed1e28] mb-2">
                    {item.title}
                  </div>
                  <p class="font-jakarta text-xs text-[#64748b] leading-relaxed m-0">
                    {item.description}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </Container>
  </section>

  <!-- Seksi 3: Bagan Struktur Organisasi Lengkap (Horizontal High-Res View) -->
  <section class="relative pt-16 sm:pt-20 pb-16 sm:pb-24 bg-[#fafafa] border-t border-slate-100 overflow-hidden" id="bagan-organisasi">
    <Container>
      <div class="max-w-[1140px] mx-auto">
        <!-- Section Header -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
          <div>
            <div class="inline-flex items-center gap-2 text-xs font-bold text-[#ed1e28] uppercase tracking-[0.15em] font-poppins mb-2">
              <span class="w-2 h-2 rounded-full bg-[#ed1e28]"></span>
              <span>Dokumen Resmi</span>
            </div>
            <h2 class="font-poppins text-2xl sm:text-4xl font-bold text-[#111827] tracking-[-0.02em]">
              Bagan Struktur Organisasi Resmi
            </h2>
            <p class="font-jakarta text-sm text-[#64748b] mt-1 max-w-[560px]">
              Alur garis komando dan jalur koordinasi tata kelola SMK Telkom Purwokerto Tahun Ajaran 2025/2026 berstandar ISO 21001:2018.
            </p>
          </div>

          <!-- Action Buttons -->
          <div class="flex items-center gap-3 shrink-0">
            <button
              type="button"
              id="btn-open-lightbox"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-white border border-slate-200 text-slate-700 hover:border-[#ed1e28] hover:text-[#ed1e28] text-xs font-bold font-jakarta shadow-xs transition-colors cursor-pointer"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                <line x1="11" y1="8" x2="11" y2="14"></line>
                <line x1="8" y1="11" x2="14" y2="11"></line>
              </svg>
              <span>Perbesar Bagan</span>
            </button>
            <a
              href="/images/guru/bagan-struktur-organisasi-horizontal.png"
              download="Bagan-Struktur-Organisasi-SMK-Telkom-Purwokerto-2025-2026.png"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-[#ed1e28] text-white hover:bg-[#d91922] text-xs font-bold font-jakarta shadow-xs transition-colors"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>Unduh Diagram</span>
            </a>
          </div>
        </div>

        <!-- Chart Container with Scroll Viewport -->
        <div class="relative bg-white border-2 border-slate-200/80 rounded-[26px] p-4 sm:p-8 shadow-xs overflow-hidden">
          <div class="w-full overflow-x-auto scrollbar-thin">
            <div class="min-w-[880px] lg:min-w-full flex justify-center">
              <img
                src="/images/guru/bagan-struktur-organisasi-horizontal.png"
                alt="Struktur Organisasi SMK Telkom Purwokerto Tahun Ajaran 2025/2026"
                class="w-full max-w-[1080px] h-auto block object-contain select-none cursor-pointer rounded-xl hover:opacity-95 transition-opacity"
                id="preview-bagan-img"
                loading="lazy"
              />
            </div>
          </div>
          <div class="mt-4 flex items-center justify-between text-[11px] font-jakarta text-slate-400 border-t border-slate-100 pt-3">
            <span>* Klik gambar untuk melihat resolusi penuh tanpa kompresi.</span>
            <span>SMK Telkom Purwokerto • Terakhir diperbarui Oktober 2026</span>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Modal Lightbox for High-Res Chart View -->
  <div id="chart-lightbox" class="fixed inset-0 bg-black/80 backdrop-blur-md z-50 hidden items-center justify-center p-4">
    <div class="relative max-w-[95vw] max-h-[92vh] bg-white rounded-[24px] overflow-hidden flex flex-col p-4 shadow-2xl">
      <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-3">
        <h3 class="font-poppins text-sm font-bold text-slate-800">
          Struktur Organisasi SMK Telkom Purwokerto (2025/2026)
        </h3>
        <button
          type="button"
          id="btn-close-lightbox"
          class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 flex items-center justify-center cursor-pointer transition-colors"
          aria-label="Tutup"
        >
          ✕
        </button>
      </div>
      <div class="overflow-auto max-h-[80vh] flex justify-center items-center">
        <img
          src="/images/guru/bagan-struktur-organisasi-horizontal.png"
          alt="Bagan Lengkap Resolusi Penuh"
          class="max-w-none w-auto max-h-[78vh] object-contain"
        />
      </div>
    </div>
  </div>

  <!-- Seksi 4: Stats Section -->
  <section class="relative pt-12 sm:pt-16 pb-20 sm:pb-28 bg-[#fafafa] overflow-hidden" id="stats-guru">
    <Container>
      <div class="relative z-1 max-w-[1140px] mx-auto">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {
            stats.map((item) => (
              <div class="bg-white border border-black/[0.06] rounded-[22px] p-6 sm:p-7 shadow-[0_8px_24px_rgba(0,0,0,0.04)] hover:-translate-y-1 hover:shadow-[0_16px_36px_rgba(0,0,0,0.08)] transition-all duration-200 text-center flex flex-col items-center justify-center">
                <div class="stat-num font-poppins text-3xl sm:text-[2.5rem] font-bold text-[#ed1e28] leading-[1.1] mb-2 [font-variant-numeric:tabular-nums]" data-value={item.display}>
                  {item.display}
                </div>
                <h3 class="font-jakarta text-sm sm:text-base font-bold text-[#111827] mb-1">
                  {item.title}
                </h3>
                <p class="font-jakarta text-xs sm:text-[0.8125rem] text-[#64748b] leading-[1.5] m-0 max-w-[200px]">
                  {item.desc}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

<script>
  // Filter logic for Kaur Cards
  const filterBtns = document.querySelectorAll(".kaur-filter-btn");
  const kaurCards = document.querySelectorAll(".kaur-card");

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      // Toggle active style
      filterBtns.forEach((b) => {
        b.classList.remove("bg-[#ed1e28]", "text-white");
        b.classList.add("bg-slate-100", "text-slate-700");
      });
      btn.classList.remove("bg-slate-100", "text-slate-700");
      btn.classList.add("bg-[#ed1e28]", "text-white");

      const filterVal = btn.getAttribute("data-filter");
      kaurCards.forEach((card) => {
        const cardBidang = card.getAttribute("data-bidang");
        if (filterVal === "all" || cardBidang === filterVal) {
          (card as HTMLElement).style.display = "flex";
        } else {
          (card as HTMLElement).style.display = "none";
        }
      });
    });
  });

  // Lightbox logic
  const lightbox = document.getElementById("chart-lightbox");
  const openBtn = document.getElementById("btn-open-lightbox");
  const closeBtn = document.getElementById("btn-close-lightbox");
  const chartImg = document.getElementById("preview-bagan-img");

  function openLightbox() {
    if (lightbox) {
      lightbox.classList.remove("hidden");
      lightbox.classList.add("flex");
      document.body.style.overflow = "hidden";
    }
  }

  function closeLightbox() {
    if (lightbox) {
      lightbox.classList.add("hidden");
      lightbox.classList.remove("flex");
      document.body.style.overflow = "";
    }
  }

  if (openBtn) openBtn.addEventListener("click", openLightbox);
  if (chartImg) chartImg.addEventListener("click", openLightbox);
  if (closeBtn) closeBtn.addEventListener("click", closeLightbox);
  if (lightbox) {
    lightbox.addEventListener("click", (e) => {
      if (e.target === lightbox) closeLightbox();
    });
  }

  // Animation for Stats Counter
  const isReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!isReduced) {
    const statCards = document.querySelectorAll("#stats-guru .stat-num");
    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const numEl = entry.target as HTMLElement;
            if (numEl && !numEl.classList.contains("counted")) {
              numEl.classList.add("counted");
              const rawVal = numEl.getAttribute("data-value") || "";
              const target = parseInt(rawVal.replace(/\D/g, ""), 10);
              const suffix = rawVal.replace(/[0-9]/g, "");
              const duration = 1800;
              let startTime: number | null = null;

              numEl.textContent = `0${suffix}`;

              const step = (now: number) => {
                if (startTime === null) startTime = now;
                const elapsed = now - startTime;
                const progress = Math.max(0, Math.min(elapsed / duration, 1));
                const ease = 1 - Math.pow(1 - progress, 3);
                const current = Math.round(ease * target);
                numEl.textContent = `${current.toLocaleString("id-ID")}${suffix}`;
                if (progress < 1) {
                  requestAnimationFrame(step);
                } else {
                  numEl.textContent = rawVal;
                }
              };
              requestAnimationFrame(step);
            }
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 }
    );

    statCards.forEach((c) => observer.observe(c));
  }
</script>
