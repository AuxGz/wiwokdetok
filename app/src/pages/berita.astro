---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";

// Data Berita exact from Figma frame Berita #1663:14638 (fallback default)
let featuredNews = {
  category: "PRESTASI",
  date: "18 FEBRUARI 2026",
  title: "Siswa SMK Telkom Raih Juara 1 Lomba Kompetensi Siswa Tingkat Provinsi",
  desc: "Tim jurusan Teknik Jaringan Komputer dan Telekomunikasi berhasil membawa pulang medali emas dalam ajang LKS tingkat Provinsi Jawa Tengah 2026, mengalahkan puluhan sekolah vokasi lain di bidang instalasi jaringan.",
  image: "/images/berita/berita-prestasi.png",
};

let sideNews = [
  {
    category: "KERJASAMA INDUSTRI",
    title: "Telkomsel dan PT Telkom Indonesia Jalin MoU Praktik Kerja Lapangan",
    date: "12 Februari 2026",
    badgeColor: "bg-[#7A1216] text-white",
    borderLeft: "border-l-4 border-l-[#E31E24]",
    image: "/images/mitra/mitra-telkom.png",
  },
  {
    category: "KEGIATAN SEKOLAH",
    title: "Workshop AI & Machine Learning bersama Praktisi Industri Digital",
    date: "5 Februari 2026",
    badgeColor: "bg-white border border-[#E7E8EA] text-[#33343A]",
    borderLeft: "border-l-4 border-l-[#33343A]",
    image: "/images/berita/berita-technopreneur.png",
  },
  {
    category: "TEKNOLOGI",
    title: "Peresmian Laboratorium Cloud Computing Bantuan Kementerian Kominfo",
    date: "28 Januari 2026",
    badgeColor: "bg-white border border-[#E7E8EA] text-[#33343A]",
    borderLeft: "border-l-4 border-l-neutral-300",
    image: "/images/profile/smart-school-fasilitas.png",
  },
];

let secondaryNews = [
  {
    category: "PENGUMUMAN",
    date: "22 JANUARI 2026",
    title: "Jadwal Pendaftaran PPDB 2026 Gelombang Pertama Resmi Dibuka",
    desc: "Pendaftar dapat mengajukan berkas melalui portal PPDB mulai 1 Maret hingga 30 April 2026.",
    image: "/images/berita/berita-spmb.png",
  },
  {
    category: "KUNJUNGAN INDUSTRI",
    date: "15 JANUARI 2026",
    title: "Kunjungan Industri ke Data Center PT Telkom Indonesia Regional Jateng",
    desc: "40 siswa kelas XI melihat langsung pengelolaan server dan sistem keamanan data center berskala nasional.",
    image: "/images/brand/gedung-sekolah.png",
  },
];

// Pembacaan data Prisma secara aman dengan fallback transparan
try {
  const { prisma } = await import("../server/lib/prisma.js");
  const dbArticles = await prisma.newsArticle.findMany({
    where: { isPublished: true },
    orderBy: [{ isFeatured: "desc" }, { order: "asc" }, { createdAt: "desc" }],
  });

  if (dbArticles && dbArticles.length > 0) {
    const featured = dbArticles.find((a) => a.isFeatured) || dbArticles[0];
    featuredNews = {
      category: featured.category || "BERITA",
      date: featured.date || "2026",
      title: featured.title,
      desc: featured.excerpt || featured.content?.slice(0, 200) || "",
      image: featured.imageUrl || "/images/berita/berita-prestasi.png",
    };

    const remaining = dbArticles.filter((a) => a.id !== featured.id);
    if (remaining.length > 0) {
      sideNews = remaining.slice(0, 3).map((item, idx) => ({
        category: item.category || "KEGIATAN",
        title: item.title,
        date: item.date || "2026",
        badgeColor: idx === 0 ? "bg-[#7A1216] text-white" : "bg-white border border-[#E7E8EA] text-[#33343A]",
        borderLeft: idx === 0 ? "border-l-4 border-l-[#E31E24]" : idx === 1 ? "border-l-4 border-l-[#33343A]" : "border-l-4 border-l-neutral-300",
        image: item.imageUrl || "/images/berita/berita-technopreneur.png",
      }));
    }

    if (remaining.length > 3) {
      secondaryNews = remaining.slice(3, 5).map((item) => ({
        category: item.category || "PENGUMUMAN",
        date: item.date || "2026",
        title: item.title,
        desc: item.excerpt || item.content?.slice(0, 150) || "",
        image: item.imageUrl || "/images/berita/berita-spmb.png",
      }));
    }
  }
} catch {
  // Silent fallback
}
---

<BaseLayout
  title="Berita & Agenda - SMK Telkom Purwokerto"
  description="Kabar terkini, liputan kegiatan, pengumuman, dan prestasi civitas akademika SMK Telkom Purwokerto."
>
  <!-- Section 1: Hero Banner (Figma Section #1663:14735: bg: #33343A, height: ~540px) -->
  <section class="relative bg-[#33343A] text-white py-16 sm:py-20 md:py-24 overflow-hidden">
    <!-- Decorative Blurs & Gradients from Figma (#1663:14738, #1663:14739) -->
    <div class="absolute -top-20 -left-20 w-80 h-80 rounded-full bg-[#E31E24] opacity-20 blur-[80px] pointer-events-none"></div>
    <div class="absolute bottom-10 right-10 w-64 h-64 rounded-full bg-[#E31E24] opacity-25 blur-[90px] pointer-events-none"></div>

    <Container>
      <div class="max-w-3xl space-y-6 relative z-10">
        <!-- Eyebrow Pill (Figma #1663:14742) -->
        <div class="inline-flex items-center px-4 py-1.5 rounded-full bg-[#E31E24] text-white text-xs font-bold tracking-[0.04em]">
          PENERIMAAN SISWA BARU 2026
        </div>

        <!-- Heading 1 (Figma #1663:14746: Plus Jakarta Sans ExtraBold 44px, line-height 52px) -->
        <h1 class="font-extrabold text-3xl sm:text-4xl md:text-[44px] leading-tight md:leading-[52px] tracking-[-0.02em] font-sans">
          Membentuk Talenta Digital<br class="hidden sm:inline" />
          Masa Depan Indonesia
        </h1>

        <!-- Subtitle -->
        <p class="text-neutral-300 text-base sm:text-lg leading-relaxed max-w-2xl">
          SMK Telkom Purwokerto menghadirkan kurikulum vokasi teknologi informasi terdepan, fasilitas lab berstandar industri, dan jaringan kemitraan BUMN terluas.
        </p>

        <!-- CTA Buttons (Figma #1663:14747) -->
        <div class="pt-2 flex flex-wrap items-center gap-4">
          <a
            href="https://ppdb.smktelkom-pwt.sch.id"
            target="_blank"
            rel="noopener noreferrer"
            class="px-7 py-3.5 rounded-full bg-[#E31E24] hover:bg-[#c9181e] text-white font-bold text-sm shadow-lg shadow-[#E31E24]/30 transition-all duration-300"
          >
            Daftar PPDB Online
          </a>
          <a
            href="/jurusan"
            class="px-7 py-3.5 rounded-full bg-transparent hover:bg-white/10 text-white border border-white/40 font-semibold text-sm transition-all duration-300"
          >
            Pelajari Program
          </a>
        </div>
      </div>
    </Container>
  </section>

  <!-- Section 2: Stats Banner (Figma Section #1663:14772: bg: #F7F7F8, padding: 48px 80px) -->
  <section class="py-10 md:py-12 bg-[#F7F7F8] border-b border-neutral-200">
    <Container>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8 max-w-[1280px] mx-auto text-center">
        <!-- Stat 1 -->
        <div class="space-y-1">
          <p class="text-3xl sm:text-4xl font-extrabold text-[#E31E24] font-sans">128+</p>
          <p class="text-xs sm:text-sm font-medium text-neutral-600">Siswa Berprestasi</p>
        </div>

        <!-- Stat 2 -->
        <div class="space-y-1">
          <p class="text-3xl sm:text-4xl font-extrabold text-[#E31E24] font-sans">64</p>
          <p class="text-xs sm:text-sm font-medium text-neutral-600">Kegiatan Tahunan</p>
        </div>

        <!-- Stat 3 -->
        <div class="space-y-1">
          <p class="text-3xl sm:text-4xl font-extrabold text-[#E31E24] font-sans">35</p>
          <p class="text-xs sm:text-sm font-medium text-neutral-600">Mitra Industri Aktif</p>
        </div>

        <!-- Stat 4 -->
        <div class="space-y-1">
          <p class="text-3xl sm:text-4xl font-extrabold text-[#E31E24] font-sans">210+</p>
          <p class="text-xs sm:text-sm font-medium text-neutral-600">Prestasi Diraih</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Section 3: Featured News & Side News (Figma Section #1663:14791: padding: 72px 80px) -->
  <section class="py-16 md:py-24 bg-white">
    <Container>
      <div class="max-w-[1280px] mx-auto space-y-16">
        <!-- Top Row: Featured Card (Left) + Side News List (Right) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <!-- Featured Story (Figma #1663:14823: 7 cols) -->
          <div class="lg:col-span-7 bg-white rounded-3xl border border-neutral-200 overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
            <!-- Image & Badge Container -->
            <div class="relative w-full aspect-[16/10] overflow-hidden bg-neutral-100">
              <img
                src={featuredNews.image}
                alt={featuredNews.title}
                class="w-full h-full object-cover"
                width="740"
                height="462"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
              <div class="absolute top-6 left-6 px-4 py-1.5 rounded-full bg-[#E31E24] text-white text-xs font-bold tracking-wider">
                {featuredNews.category}
              </div>
            </div>

            <!-- Content -->
            <div class="p-8 sm:p-10 space-y-4">
              <p class="text-xs sm:text-sm font-semibold text-neutral-400">
                {featuredNews.date}
              </p>
              <h2 class="text-2xl sm:text-3xl font-extrabold text-[#33343A] leading-tight font-sans">
                {featuredNews.title}
              </h2>
              <p class="text-neutral-600 text-sm sm:text-base leading-relaxed">
                {featuredNews.desc}
              </p>
              <div class="pt-2">
                <a
                  href="#"
                  class="inline-flex items-center gap-2 text-[#E31E24] font-bold text-sm hover:underline"
                >
                  Baca Selengkapnya
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
              </div>
            </div>
          </div>

          <!-- Side News List (Figma #1663:14847: 5 cols) -->
          <div class="lg:col-span-5 space-y-5">
            {sideNews.map((news) => (
              <div class={`bg-[#F7F7F8] rounded-2xl p-6 shadow-sm hover:shadow-md transition-all duration-300 flex gap-4 items-center ${news.borderLeft}`}>
                <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-xl overflow-hidden bg-neutral-200 shrink-0">
                  <img src={news.image} alt={news.title} class="w-full h-full object-cover" width="96" height="96" loading="lazy" decoding="async" />
                </div>
                <div class="space-y-2 flex-1">
                  <span class={`inline-block px-3 py-1 rounded-full text-[10px] font-bold tracking-wider ${news.badgeColor}`}>
                    {news.category}
                  </span>
                  <h3 class="font-bold text-sm sm:text-base text-[#33343A] leading-snug line-clamp-2 hover:text-[#E31E24] transition-colors">
                    {news.title}
                  </h3>
                  <p class="text-xs text-neutral-400 font-medium">
                    {news.date}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Secondary Row: 2 Highlight Cards (Figma #1663:14881, #1663:14893) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {secondaryNews.map((item) => (
            <div class="bg-white rounded-3xl border border-[#E7E8EA] overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col justify-between">
              <div class="relative w-full aspect-[16/9] overflow-hidden bg-neutral-100">
                <img src={item.image} alt={item.title} class="w-full h-full object-cover" width="600" height="338" loading="lazy" decoding="async" />
                <div class="absolute top-4 left-4 px-3.5 py-1 rounded-full bg-[#E31E24] text-white text-[11px] font-bold">
                  {item.category}
                </div>
              </div>
              <div class="p-6 sm:p-8 space-y-3">
                <p class="text-xs font-semibold text-neutral-400">{item.date}</p>
                <h3 class="text-xl font-extrabold text-[#33343A] leading-snug font-sans">
                  {item.title}
                </h3>
                <p class="text-neutral-600 text-sm leading-relaxed">
                  {item.desc}
                </p>
              </div>
            </div>
          ))}
        </div>

        <!-- Slider Navigation & Pagination Dots (Figma #3168:3463, #3168:3469) -->
        <div class="flex items-center justify-between pt-8 border-t border-neutral-100">
          <!-- Dots -->
          <div class="flex items-center gap-2">
            <span class="w-8 h-2 rounded-full bg-[#ED1E28]"></span>
            <span class="w-2 h-2 rounded-full bg-[#D9D9DE]"></span>
            <span class="w-2 h-2 rounded-full bg-[#D9D9DE]"></span>
            <span class="w-2 h-2 rounded-full bg-[#D9D9DE]"></span>
          </div>

          <!-- Prev/Next Buttons -->
          <div class="flex items-center gap-3">
            <button
              type="button"
              class="w-12 h-12 rounded-full bg-white border border-[#E7E8EA] text-[#33343A] flex items-center justify-center hover:bg-neutral-50 shadow-sm transition-all"
              aria-label="Previous"
            >
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
            </button>
            <button
              type="button"
              class="w-12 h-12 rounded-full bg-[#ED1E28] text-white flex items-center justify-center hover:bg-[#d01620] shadow-md shadow-[#ED1E28]/30 transition-all"
              aria-label="Next"
            >
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </div>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
