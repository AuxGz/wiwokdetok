---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";

// Data Program Keahlian exact from Figma (fallback default)
const defaultMajorsData = {
  pg: {
    code: "PG",
    number: "02",
    shortName: "Pengembangan Gim (PG)",
    titleHighlight: "Pengembangan",
    titleWord: "Game",
    tagline: "Keunggulan Jurusan",
    desc: "Ubah imajinasimu menjadi karya interaktif yang memikat dunia. Kamu akan mempelajari seluruh alur pembuatan gim, mulai dari desain karakter, mekanik permainan, hingga animasi 2D/3D. Dengan fasilitas lab canggih, siswa diarahkan menjadi inovator kreatif yang mampu menciptakan produk gim yang memiliki nilai jual di pasar digital.",
    image: "/images/jurusan/siswa-vr.png",
    cardTags: ["Game Design", "3D Animation", "Interactive Art"],
    badges: [
      { text: "Game QA & Tester", icon: "qa" },
      { text: "Pemrograman Game (Unity & C#)", icon: "code" },
      { text: "Multiplayer & Game Networking", icon: "network" },
      { text: "Publishing & Monetisasi Game", icon: "publish" },
      { text: "Tata Suara & Audio Efek Game", icon: "audio" },
      { text: "Game UI/UX Designer", icon: "uiux" },
    ]
  },
  rpl: {
    code: "RPL",
    number: "01",
    shortName: "Rekayasa Perangkat Lunak (RPL)",
    titleHighlight: "Rekayasa",
    titleWord: "Perangkat Lunak",
    tagline: "Keunggulan Jurusan",
    desc: "Jadilah kreator di balik aplikasi dan perangkat lunak masa depan. Di sini, kamu tidak hanya belajar menulis kode, tapi membangun solusi digital mulai dari aplikasi web hingga mobile. Fokus pada pengembangan produk nyata (MVP) yang siap bersaing di industri startup global maupun menjadi Technopreneur muda.",
    image: "/images/jurusan/siswa-pplg.png",
    cardTags: ["Web Development", "Mobile Dev", "Technopreneur"],
    badges: [
      { text: "Web Development (Front-end & Back-end)", icon: "code" },
      { text: "Mobile Development", icon: "mobile" },
      { text: "UI/UX & Product Design", icon: "uiux" },
      { text: "Database & Software Architecture", icon: "database" },
      { text: "Software Quality Assurance (QA) & Testing", icon: "qa" },
      { text: "MVP Development & Technopreneurship", icon: "publish" },
    ]
  },
  tkj: {
    code: "TKJ",
    number: "03",
    shortName: "Teknik Komputer & Jaringan (TKJ)",
    titleHighlight: "Teknik",
    titleWord: "Komputer Jaringan",
    tagline: "Keunggulan Jurusan",
    desc: "Kuasai infrastruktur digital, keamanan siber (Cybersecurity), dan sistem awan (Cloud Computing). Dibekali dengan sertifikasi kompetensi industri internasional (seperti Cisco/Mikrotik), kamu akan dididik menjadi ahli IT profesional yang siap menjaga dan membangun jaringan teknologi di perusahaan-perusahaan raksasa.",
    image: "/images/jurusan/siswa-game.png",
    cardTags: ["Cybersecurity", "Cloud Sys", "Networking"],
    badges: [
      { text: "Network Engineering & Routing", icon: "network" },
      { text: "Cyber Security & Ethical Hacking", icon: "security" },
      { text: "System & Server Administration", icon: "server" },
      { text: "Cloud Computing & Virtualization", icon: "cloud" },
      { text: "Network Troubleshooting", icon: "tools" },
      { text: "Cisco Certified Networking & Routing", icon: "cert" },
    ]
  },
  tja: {
    code: "TJA",
    number: "04",
    shortName: "Teknik Jaringan Akses (TJAT)",
    titleHighlight: "Teknik",
    titleWord: "Jaringan Akses",
    tagline: "Keunggulan Jurusan",
    desc: "Pelajari teknologi inti yang menghubungkan jutaan orang melalui jaringan pita lebar (Broadband) dan Fiber Optik. Sebagai bagian dari ekosistem Telkom Indonesia, siswa dibekali keahlian teknis tingkat tinggi untuk membangun dan mengelola infrastruktur telekomunikasi modern yang menjadi tulang punggung konektivitas dunia.",
    image: "/images/jurusan/siswa-tjkt.png",
    cardTags: ["Fiber Optic", "Broadband", "Telkom Eco"],
    badges: [
      { text: "Fiber Optic & FTTH Engineering", icon: "fiber" },
      { text: "Broadband & Wireless Communication", icon: "wireless" },
      { text: "Telecommunication Network Infrastructure", icon: "tower" },
      { text: "VSAT & Satellite Communication", icon: "satellite" },
      { text: "Smart Access & IoT Connectivity", icon: "iot" },
      { text: "Network Measurement & Troubleshooting", icon: "tools" },
    ]
  }
};

let majorsData = { ...defaultMajorsData };

try {
  const { prisma } = await import("../server/lib/prisma.js");
  const dbMajors = await prisma.schoolMajor.findMany({
    orderBy: { order: "asc" },
  });

  if (dbMajors && dbMajors.length > 0) {
    for (const m of dbMajors) {
      const codeKey = (m.code || "").toLowerCase();
      if (majorsData[codeKey as keyof typeof defaultMajorsData]) {
        const cur = majorsData[codeKey as keyof typeof defaultMajorsData];
        let titleHighlight = cur.titleHighlight;
        let titleWord = cur.titleWord;
        if (m.headlineTitle) {
          const parts = m.headlineTitle.trim().split(" ");
          titleHighlight = parts[0] || cur.titleHighlight;
          titleWord = parts.slice(1).join(" ") || cur.titleWord;
        }

        let parsedBadges = cur.badges;
        if (m.competencies && Array.isArray(m.competencies)) {
          parsedBadges = m.competencies.map((c: any) =>
            typeof c === "string" ? { text: c, icon: "code" } : { text: c.text || c.name || "", icon: c.icon || "code" }
          );
        }

        majorsData[codeKey as keyof typeof defaultMajorsData] = {
          ...cur,
          shortName: m.name || cur.shortName,
          titleHighlight,
          titleWord,
          tagline: m.tagline || cur.tagline,
          desc: m.description || cur.desc,
          image: m.imageUrl || cur.image,
          cardTags: m.cardTags && m.cardTags.length > 0 ? m.cardTags : cur.cardTags,
          badges: parsedBadges.length > 0 ? parsedBadges : cur.badges,
        };
      }
    }
  }
} catch {
  // Gunakan data default jika database offline atau belum terisi
}
---

<BaseLayout
  title="Program Keahlian - SMK Telkom Purwokerto"
  description="Pilihan Program Keahlian unggulan di SMK Telkom Purwokerto: Rekayasa Perangkat Lunak, Pengembangan Gim, Teknik Komputer & Jaringan, dan Teknik Jaringan Akses."
>
  <!-- Section 1: Hero Banner (Figma Frame JurusanO #1592:1593) -->
  <section class="relative bg-[#F5F5F5] pt-14 pb-20 md:py-24 overflow-hidden border-b border-neutral-200">
    <!-- Decorative Accents -->
    <div class="absolute -top-12 -left-12 w-80 h-80 rounded-full bg-[#ED1E28]/5 blur-[60px] pointer-events-none"></div>
    <div class="absolute bottom-4 right-10 w-[350px] h-[350px] rounded-full bg-[#ED1E28]/10 blur-[45px] pointer-events-none"></div>
    
    <Container>
      <div class="max-w-4xl mx-auto text-center space-y-6">
        <!-- Heading 1 -->
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-[#1A1A1A] tracking-tight leading-[1.15]">
          4 Jurusan Siap Kerja<br class="hidden sm:inline" /> di Era Digital
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg md:text-xl text-[#55565B] max-w-2xl mx-auto leading-relaxed">
          Kurikulum berbasis industri, sertifikasi internasional, dan fasilitas modern untuk mencetak talenta digital terbaik.
        </p>

        <!-- CTA Buttons -->
        <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
          <a
            href="#profil-jurusan"
            class="px-8 py-3.5 rounded-full bg-[#ED1E28] hover:bg-[#d01620] text-white font-bold text-sm sm:text-base shadow-lg shadow-[#ED1E28]/25 transition-all duration-300"
          >
            Telusuri Jurusan
          </a>
          <a
            href="https://wa.me/6281229701800"
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-3.5 rounded-full bg-white hover:bg-neutral-50 text-[#55565B] border border-[#E2E8F0] font-semibold text-sm sm:text-base shadow-sm transition-all duration-300"
          >
            Konsultasi Minat
          </a>
        </div>
      </div>
    </Container>
  </section>

  <!-- Section 2 (Sebelumnya Section 3): Interactive Detailed Major Showcase (Figma Profil Jurusan #1208:4367) -->
  <section id="profil-jurusan" class="py-16 md:py-24 bg-[#FAFAFA] overflow-hidden scroll-mt-12">
    <Container>
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto mb-12 space-y-4">
        <div class="inline-flex items-center gap-2">
          <span class="w-6 h-0.5 bg-[#ED1E28]"></span>
          <span class="text-[#ED1E28] font-poppins font-semibold text-sm tracking-wide">Program Keahlian</span>
          <span class="w-6 h-0.5 bg-[#ED1E28]"></span>
        </div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold font-poppins text-[#2B2C31]">
          Pilih jurusan di SMK Telkom Purwokerto
        </h2>

        <!-- Interactive Switcher Tabs -->
        <div class="pt-4 flex justify-center">
          <div class="inline-flex p-1.5 rounded-full bg-[#F4F5F6] border border-[#E7E8EA] gap-2 shadow-inner">
            <button
              type="button"
              data-major-btn="pg"
              class="major-tab-btn px-6 py-2.5 rounded-full text-sm font-semibold transition-all duration-300 bg-[#ED1E28] text-white shadow-md shadow-[#ED1E28]/30"
            >
              PG
            </button>
            <button
              type="button"
              data-major-btn="rpl"
              class="major-tab-btn px-6 py-2.5 rounded-full text-sm font-semibold transition-all duration-300 text-[#55565B] hover:text-[#111827]"
            >
              RPL
            </button>
            <button
              type="button"
              data-major-btn="tkj"
              class="major-tab-btn px-6 py-2.5 rounded-full text-sm font-semibold transition-all duration-300 text-[#55565B] hover:text-[#111827]"
            >
              TKJ
            </button>
            <button
              type="button"
              data-major-btn="tja"
              class="major-tab-btn px-6 py-2.5 rounded-full text-sm font-semibold transition-all duration-300 text-[#55565B] hover:text-[#111827]"
            >
              TJA
            </button>
          </div>
        </div>
      </div>

      <!-- Detail Showcase Panes -->
      {Object.entries(majorsData).map(([key, item]) => (
        <div
          id={`major-pane-${key}`}
          class={`major-pane ${key === 'pg' ? '' : 'hidden'} transition-opacity duration-300`}
        >
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center max-w-[1340px] mx-auto bg-white rounded-[32px] p-8 sm:p-12 md:p-16 border border-[#E7E8EA] shadow-xl">
            <!-- Left Column: Copy & Details -->
            <div class="lg:col-span-6 space-y-6">
              <div class="space-y-2">
                <span class="text-sm font-bold text-[#ED1E28] uppercase tracking-wider block">
                  {item.tagline}
                </span>
                <h3 class="text-3xl sm:text-4xl font-extrabold text-[#2B2C31] font-poppins">
                  {item.titleHighlight} <span class="text-[#ED1E28]">{item.titleWord}</span>
                </h3>
              </div>
              
              <p class="text-[#55565B] text-base sm:text-lg leading-relaxed">
                {item.desc}
              </p>

              <!-- Competence badges grid -->
              <div class="pt-4 space-y-3">
                <p class="text-xs font-bold text-neutral-400 uppercase tracking-widest">Kompetensi Inti & Keahlian</p>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  {item.badges.map((badge) => (
                    <div class="flex items-center gap-3 p-3 rounded-xl bg-[#FFF2F2] border border-red-100 text-sm font-medium text-[#1E1E1E]">
                      <span class="w-7 h-7 rounded-lg bg-[#ED1E28] text-white flex items-center justify-center shrink-0">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                        </svg>
                      </span>
                      <span class="text-xs sm:text-sm leading-snug">{badge.text}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <!-- Right Column: Student Image & Decorative Layout -->
            <div class="lg:col-span-6 flex justify-center relative">
              <div class="relative w-full max-w-[480px] aspect-[4/5] flex items-center justify-center">
                <!-- Figma Backdrop Geometric Shape -->
                <div class="absolute inset-4 rounded-[80px_130px_80px_130px] bg-gradient-to-br from-[#ED1E28] via-[#DC2626] to-[#B91C1C] opacity-95 shadow-2xl"></div>
                <div class="absolute -top-6 -right-6 w-36 h-36 rounded-full border-4 border-dashed border-[#ED1E28]/30 animate-spin-slow"></div>

                <!-- Student Image -->
                <img
                  src={item.image}
                  alt={item.shortName}
                  class="relative z-10 w-full h-full object-contain drop-shadow-2xl"
                  width="480"
                  height="600"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
          </div>
        </div>
      ))}
    </Container>
  </section>

  <!-- Interactive Script for Tab Switching -->
  <script>
    function setupMajorTabs() {
      const tabButtons = document.querySelectorAll<HTMLButtonElement>('.major-tab-btn');
      const tabPanes = document.querySelectorAll<HTMLElement>('.major-pane');

      tabButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const targetKey = btn.getAttribute('data-major-btn');
          if (!targetKey) return;

          // Update active button
          tabButtons.forEach((b) => {
            b.classList.remove('bg-[#ED1E28]', 'text-white', 'shadow-md', 'shadow-[#ED1E28]/30');
            b.classList.add('text-[#55565B]');
          });
          btn.classList.add('bg-[#ED1E28]', 'text-white', 'shadow-md', 'shadow-[#ED1E28]/30');
          btn.classList.remove('text-[#55565B]');

          // Show target pane
          tabPanes.forEach((pane) => {
            if (pane.id === `major-pane-${targetKey}`) {
              pane.classList.remove('hidden');
            } else {
              pane.classList.add('hidden');
            }
          });
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupMajorTabs);
    } else {
      setupMajorTabs();
    }
  </script>
</BaseLayout>
