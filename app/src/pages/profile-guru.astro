---

<BaseLayout
  title="Guru & Pimpinan | SMK Telkom Purwokerto"
  description="Kenali jajaran pimpinan dan pejabat struktural SMK Telkom Purwokerto."
>
  <!-- Hero Section (Clean, Anti-Slop, No Redundant Eyebrow Pill) -->
  <section class="pt-14 sm:pt-18 pb-8 sm:pb-10 bg-white text-center">
    <Container>
      <div class="max-w-3xl mx-auto flex flex-col items-center">
        <h1 class="font-poppins text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight">
          Guru &amp; Pimpinan
        </h1>
        <p class="font-jakarta text-sm sm:text-base text-slate-600 mt-3 max-w-xl leading-relaxed">
          Struktur kepemimpinan dan pejabat pengelola SMK Telkom Purwokerto yang mengawal tata kelola akademik, sarana, dan pengembangan karakter siswa.
        </p>
      </div>
    </Container>
  </section>

  <!-- Sub-Navigation Bar (Static Anchor Navigation) -->
  <nav
    class="relative z-10 bg-white border-y border-slate-200/80 py-2.5 sm:py-3"
    aria-label="Navigasi Bidang Kepemimpinan"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div
        class="flex items-center gap-1.5 sm:gap-2 overflow-x-auto no-scrollbar py-1 justify-start md:justify-center"
      >
        {
          sections.map((section) => (
            <a
              href={`#${section.id}`}
              class="inline-flex items-center whitespace-nowrap px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-medium font-poppins text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors duration-150"
            >
              {section.shortTitle}
            </a>
          ))
        }
      </div>
    </div>
  </nav>

  <!-- 7 Seksi Bertingkat Showcase (Unified Rhythm, Honest Depth) -->
  <div class="showcase-sections-wrapper bg-white">
    {
      sections.map((section, sIdx) => {
        return (
          <section
            id={section.id}
            class={`scroll-mt-28 py-12 sm:py-16 ${sIdx > 0 ? "border-t border-slate-100" : ""}`}
            aria-labelledby={`heading-${section.id}`}
          >
            <Container>
              {/* Header Seksi (Clean Typographic Hierarchy, No Status Dots, No Cliché Bars) */}
              <div class="text-center max-w-xl mx-auto mb-10 sm:mb-12">
                <span class="text-xs font-semibold tracking-wider text-[#ed1e28] uppercase font-poppins block mb-1">
                  {section.badge}
                </span>
                <h2
                  id={`heading-${section.id}`}
                  class="font-poppins text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight"
                >
                  {section.title}
                </h2>
              </div>

              {/* Leader Cards Grid / Flex */}
              <div class="w-full flex flex-wrap items-stretch justify-center gap-6 sm:gap-8">
                {section.leaders.map((leader) => {
                  const isJpg =
                    leader.image.toLowerCase().endsWith(".jpg") ||
                    leader.image.toLowerCase().includes(".jpg");

                  return (
                    <article
                      class="leader-card group w-full max-w-[280px] sm:max-w-[300px] md:w-[270px] lg:w-[300px] bg-white rounded-xl border border-slate-200/80 shadow-xs hover:border-slate-300 transition-all duration-200 flex flex-col overflow-hidden"
                    >
                      {/* Foto Frame */}
                      <div class="relative w-full h-[290px] sm:h-[310px] lg:h-[340px] bg-slate-100/70 flex items-end justify-center overflow-hidden">
                        <img
                          src={leader.image}
                          alt={leader.name}
                          class={`w-full h-full pointer-events-none select-none transition-transform duration-300 ease-out group-hover:scale-[1.02] ${
                            isJpg
                              ? "object-cover object-top"
                              : "object-contain object-bottom p-4"
                          }`}
                          loading="lazy"
                          draggable="false"
                        />
                      </div>

                      {/* Informasi Pejabat: Nama & Jabatan */}
                      <div class="p-4 sm:p-5 text-center bg-white flex flex-col justify-center flex-1 border-t border-slate-100">
                        <h3 class="font-poppins font-bold text-base sm:text-[1.02rem] text-slate-900 leading-snug">
                          {leader.name}
                        </h3>
                        <p class="font-jakarta text-xs sm:text-sm font-medium text-slate-600 mt-1 leading-snug">
                          {leader.position}
                        </p>
                      </div>
                    </article>
                  );
                })}
              </div>
            </Container>
          </section>
        );
      })
    }
  </div>
</BaseLayout>

<style>
  /* No-scrollbar helper */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .leader-card {
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.22s ease, border-color 0.2s ease;
  }

  .leader-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px -6px rgba(15, 23, 42, 0.08), 0 4px 8px -2px rgba(15, 23, 42, 0.04);
  }

  .leader-card:active {
    transform: translateY(-1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .leader-card,
    .leader-card:hover {
      transform: none !important;
      transition: none !important;
    }
  }
</style>
