---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";

// Data Prestasi exact from Figma frame Prestasi #923:1287
const prestasiItems = [
  {
    category: "akademik",
    badge: "Juara 1 Nasional",
    meta: "2023 • Teknologi Informasi",
    title: "Lomba Kompetensi Siswa (LKS) Nasional 2023 - Cyber Security",
    desc: "Tim Cyber SMK Telkom Purwokerto berhasil mengamankan peringkat pertama dalam ajang bergengsi LKS Nasional.",
  },
  {
    category: "akademik",
    badge: "Top 3 International",
    meta: "2024 • Global Innovation",
    title: "Global Student Tech Innovation - Singapore",
    desc: "Mengembangkan aplikasi solusi lingkungan berbasis AI yang mendapatkan apresiasi di tingkat Asia Tenggara.",
  },
  {
    category: "non-akademik",
    badge: null,
    meta: "2023 • Olahraga",
    title: "Popda Jawa Tengah - Cabang Olahraga Basket",
    desc: "Tim Basket putra SMK Telkom Purwokerto menunjukkan sportivitas dan performa luar biasa di tingkat provinsi.",
  },
  {
    category: "akademik",
    badge: "Best Design",
    meta: "2024 • Robotics",
    title: "Kontes Robot Indonesia (KRI) Wilayah 2",
    desc: "Inovasi desain mekanik robot pencari korban bencana mendapatkan penghargaan desain terbaik.",
  },
  {
    category: "non-akademik",
    badge: "Juara 1 Regional",
    meta: "2023 • Multimedia",
    title: "Animasi Pendek FLS2N Jawa Tengah",
    desc: "Karya animasi 3D siswa meraih apresiasi tertinggi kategori kreativitas visual tingkat regional.",
  },
  {
    category: "akademik",
    badge: "Juara 2 Nasional",
    meta: "2024 • Networking",
    title: "Mikrotik Certified Student Competition 2024",
    desc: "Kompetisi konfigurasi router dan troubleshooting jaringan komputer tingkat nasional.",
  },
];
---

<BaseLayout
  title="Prestasi Siswa - SMK Telkom Purwokerto"
  description="Daftar pencapaian dan prestasi siswa-siswi SMK Telkom Purwokerto di berbagai ajang kompetisi tingkat Nasional dan Internasional."
>
  <div class="pt-6 pb-20 bg-[#F7F8F9]">
    <Container>
      <!-- Section 1: Hero Card (Figma Section #923:1288) -->
      <div class="relative overflow-hidden rounded-[32px] bg-gradient-to-tr from-[#ED1E28] via-[#D0161F] to-[#B6252A] p-8 sm:p-12 md:p-20 text-white text-center shadow-xl">
        <!-- Background Vector Glow -->
        <div class="absolute -top-24 -left-24 w-96 h-96 rounded-full bg-white/10 blur-[80px] pointer-events-none"></div>
        <div class="absolute -bottom-24 -right-24 w-96 h-96 rounded-full bg-black/20 blur-[80px] pointer-events-none"></div>

        <div class="relative z-10 max-w-4xl mx-auto space-y-6">
          <!-- Pill Badge (Figma #923:1295) -->
          <div class="inline-flex items-center gap-2 px-5 py-2 rounded-full bg-white/10 border border-white/20 backdrop-blur-md text-xs sm:text-sm font-semibold tracking-wide">
            School Of Global Technopreneur
          </div>

          <!-- Heading 1 (Figma #923:1300) -->
          <h1 class="font-extrabold text-4xl sm:text-6xl md:text-7xl font-sans tracking-[-0.025em] leading-[1.1]">
            Prestasi Kami
          </h1>

          <!-- Subtitle (Figma #923:1303) -->
          <p class="text-white/80 text-base sm:text-lg md:text-xl max-w-2xl mx-auto leading-relaxed">
            Dedikasi tanpa henti untuk meraih keunggulan. Telusuri jejak keberhasilan siswa-siswi SMK Telkom Purwokerto dalam berbagai ajang kompetisi tingkat Nasional dan Internasional.
          </p>

          <!-- Buttons (Figma #923:1304) -->
          <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
            <a
              href="#daftar-prestasi"
              class="px-8 py-4 rounded-full bg-white hover:bg-neutral-100 text-[#ED1E28] font-bold text-base shadow-lg transition-all duration-300"
            >
              Lihat Galeri
            </a>
            <a
              href="https://wa.me/6281229701800"
              target="_blank"
              rel="noopener noreferrer"
              class="px-8 py-3.5 rounded-full bg-transparent hover:bg-white/10 text-white border-2 border-white font-bold text-base transition-all duration-300"
            >
              Kontribusi Siswa
            </a>
          </div>
        </div>
      </div>

      <!-- Section 2: Stats Row (Figma Section #923:1533: width 1260, radius 24px) -->
      <div class="relative z-20 max-w-[1260px] mx-auto -mt-10 sm:-mt-14 md:-mt-16 bg-white border border-[#EDEEF0] rounded-[24px] shadow-[0px_20px_40px_0px_rgba(0,0,0,0.08)] p-6 sm:p-8">
        <div class="grid grid-cols-2 lg:grid-cols-4 divide-y lg:divide-y-0 lg:divide-x divide-[#EDEEF0]">
          <!-- Stat 1 -->
          <div class="p-4 sm:p-6 text-center">
            <p class="text-3xl sm:text-4xl lg:text-[40px] font-bold text-[#ED1E28] leading-none mb-2 font-sans">
              150+
            </p>
            <p class="text-[#959597] text-xs sm:text-sm font-medium">
              Juara Nasional
            </p>
          </div>

          <!-- Stat 2 -->
          <div class="p-4 sm:p-6 text-center">
            <p class="text-3xl sm:text-4xl lg:text-[40px] font-bold text-[#ED1E28] leading-none mb-2 font-sans">
              12
            </p>
            <p class="text-[#959597] text-xs sm:text-sm font-medium">
              Ajang Internasional
            </p>
          </div>

          <!-- Stat 3 -->
          <div class="p-4 sm:p-6 text-center">
            <p class="text-3xl sm:text-4xl lg:text-[40px] font-bold text-[#ED1E28] leading-none mb-2 font-sans">
              45
            </p>
            <p class="text-[#959597] text-xs sm:text-sm font-medium">
              Medali Emas 2024
            </p>
          </div>

          <!-- Stat 4 -->
          <div class="p-4 sm:p-6 text-center">
            <p class="text-3xl sm:text-4xl lg:text-[40px] font-bold text-[#ED1E28] leading-none mb-2 font-sans">
              500+
            </p>
            <p class="text-[#959597] text-xs sm:text-sm font-medium">
              Sertifikasi Industri
            </p>
          </div>
        </div>
      </div>

      <!-- Section 3: Prestasi Grid & Filters (Figma PrestasiHover #1025:891) -->
      <section id="daftar-prestasi" class="pt-20 md:pt-28">
        <!-- Section Header -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 max-w-[1260px] mx-auto">
          <div class="space-y-2">
            <div class="flex items-center gap-2">
              <span class="w-6 h-0.5 bg-[#ED1E28]"></span>
              <span class="text-[#ED1E28] font-bold text-sm tracking-wide">Daftar Prestasi</span>
            </div>
            <h2 class="text-3xl sm:text-4xl font-bold text-[#2B2C31] font-sans">
              Pencapaian Siswa-Siswi
            </h2>
          </div>

          <!-- Filter Buttons (Figma #1006:2202) -->
          <div class="flex items-center gap-2.5">
            <button
              type="button"
              data-filter="all"
              class="filter-btn px-6 py-2 rounded-full text-sm font-bold transition-all duration-300 bg-[#ED1E28] text-white shadow-md shadow-[#ED1E28]/25"
            >
              Semua
            </button>
            <button
              type="button"
              data-filter="akademik"
              class="filter-btn px-6 py-2 rounded-full text-sm font-semibold transition-all duration-300 bg-white border border-[#EDEEF0] text-[#959597] hover:text-[#2B2C31]"
            >
              Akademik
            </button>
            <button
              type="button"
              data-filter="non-akademik"
              class="filter-btn px-6 py-2 rounded-full text-sm font-semibold transition-all duration-300 bg-white border border-[#EDEEF0] text-[#959597] hover:text-[#2B2C31]"
            >
              Non-Akademik
            </button>
          </div>
        </div>

        <!-- 6 Prestasi Cards Grid (Figma #1006:2211: radius 24px) -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-[1260px] mx-auto">
          {prestasiItems.map((item) => (
            <div
              data-category={item.category}
              class="prestasi-card group bg-white border border-[#EDEEF0] rounded-[24px] overflow-hidden shadow-sm hover:shadow-xl hover:border-[#ED1E28]/20 transition-all duration-300 flex flex-col justify-between"
            >
              <!-- Card Image & Badge Container (Placeholder Image Not Found) -->
              <div class="relative w-full aspect-[16/10] overflow-hidden bg-[#F7F8F9] border-b border-[#EDEEF0] flex items-center justify-center p-6 select-none">
                <img
                  src="/images/placeholders/image-not-found.svg"
                  alt="Foto dokumentasi belum tersedia"
                  class="h-24 sm:h-28 w-auto object-contain opacity-70 group-hover:opacity-90 group-hover:scale-105 transition-all duration-300"
                  loading="lazy"
                />
                {item.badge && (
                  <div class="absolute top-4 left-4 px-3.5 py-1 rounded-full bg-[#ED1E28] text-white text-xs font-bold shadow-md">
                    {item.badge}
                  </div>
                )}
              </div>

              <!-- Card Body -->
              <div class="p-6 sm:p-7 space-y-3 flex-1 flex flex-col justify-between">
                <div class="space-y-2">
                  <p class="text-xs font-semibold text-[#959597]">
                    {item.meta}
                  </p>
                  <h3 class="font-bold text-lg sm:text-xl text-[#2B2C31] group-hover:text-[#ED1E28] transition-colors leading-snug">
                    {item.title}
                  </h3>
                  <p class="text-[#959597] text-sm leading-relaxed pt-1">
                    {item.desc}
                  </p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>
    </Container>
  </div>

  <!-- Interactive Filter Script -->
  <script>
    function setupPrestasiFilter() {
      const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
      const cards = document.querySelectorAll<HTMLElement>('.prestasi-card');

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const filter = btn.getAttribute('data-filter');
          if (!filter) return;

          // Toggle button styles
          buttons.forEach((b) => {
            b.classList.remove('bg-[#ED1E28]', 'text-white', 'shadow-md', 'shadow-[#ED1E28]/25');
            b.classList.add('bg-white', 'border', 'border-[#EDEEF0]', 'text-[#959597]');
          });
          btn.classList.add('bg-[#ED1E28]', 'text-white', 'shadow-md', 'shadow-[#ED1E28]/25');
          btn.classList.remove('bg-white', 'border', 'border-[#EDEEF0]', 'text-[#959597]');

          // Filter cards
          cards.forEach((card) => {
            const cat = card.getAttribute('data-category');
            if (filter === 'all' || cat === filter) {
              card.style.display = 'flex';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupPrestasiFilter);
    } else {
      setupPrestasiFilter();
    }
  </script>
</BaseLayout>
