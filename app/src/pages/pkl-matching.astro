      // 1. Render Skill Tags
      function renderSkillTags() {
        if (!skillsContainer) return;
        skillsContainer.innerHTML = '';
        activeSkills.forEach((skill, index) => {
          const tag = document.createElement('span');
          tag.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-white border border-[#E7E8EA] text-xs font-semibold text-[#111827] shadow-2xs animate-fadeIn';
          tag.innerHTML = `
            <span>${skill}</span>
            <button type="button" data-index="${index}" class="text-neutral-400 hover:text-[#ED1E28] font-bold focus:outline-none">✕</button>
          `;
          const removeBtn = tag.querySelector('button');
          removeBtn?.addEventListener('click', (e) => {
            e.stopPropagation();
            activeSkills.splice(index, 1);
            renderSkillTags();
          });
          skillsContainer.appendChild(tag);
        });
      }

      // 2. Render Suggested Skill Chips berdasarkan Jurusan yang dipilih
      function renderSuggestedChips() {
        if (!suggestedSkillsContainer || !majorSelect) return;
        const currentMajor = majorSelect.value || 'RPL';
        const suggestions = SKILL_SUGGESTIONS[currentMajor] || SKILL_SUGGESTIONS['RPL'];

        suggestedSkillsContainer.innerHTML = '';
        suggestions.forEach((skill) => {
          const isSelected = activeSkills.some(s => s.toLowerCase() === skill.toLowerCase());
          const chip = document.createElement('button');
          chip.type = 'button';
          chip.className = `px-2.5 py-1 rounded-md text-[11px] font-medium transition-all cursor-pointer ${
            isSelected
              ? 'bg-neutral-200 text-neutral-500 cursor-default'
              : 'bg-white hover:bg-neutral-100 text-neutral-700 border border-neutral-200'
          }`;
          chip.textContent = `+ ${skill}`;
          if (!isSelected) {
            chip.addEventListener('click', () => {
              activeSkills.push(skill);
              renderSkillTags();
              renderSuggestedChips();
            });
          }
          suggestedSkillsContainer.appendChild(chip);
        });
      }

      // Event tambah tag manual via input (Enter atau koma)
      skillInput?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ',') {
          e.preventDefault();
          const val = skillInput.value.replace(/,/g, '').trim();
          if (val && !activeSkills.some(s => s.toLowerCase() === val.toLowerCase())) {
            activeSkills.push(val);
            skillInput.value = '';
            renderSkillTags();
            renderSuggestedChips();
          }
        }
      });

      majorSelect?.addEventListener('change', () => {
        renderSuggestedChips();
      });

      // 3. Tarik Data dari CV Generator (localStorage 'jhic_student_cv')
      function pullDataFromCvGenerator() {
        if (!cvStatusAlert || !cvStatusMessage) return;

        try {
          const stored = localStorage.getItem(CV_STORAGE_KEY);
          if (!stored) {
            cvStatusAlert.className = 'flex p-3.5 rounded-xl text-xs sm:text-sm items-center justify-between border bg-amber-50 text-amber-800 border-amber-200 transition-all';
            cvStatusMessage.innerHTML = `
              <svg class="w-4 h-4 text-amber-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <span>Belum ada data CV yang tersimpan di CV Generator. Kamu dapat mengisi form secara manual atau buat CV terlebih dahulu di <a href="/cv-generator" class="font-bold underline text-amber-900">CV Generator</a>.</span>
            `;
            cvStatusAlert.classList.remove('hidden');
            return;
          }

          const parsed = JSON.parse(stored);

          // Pasang Jurusan
          if (majorSelect && parsed.major) {
            const rawMajor = (parsed.major || '').toUpperCase();
            if (rawMajor.includes('RPL')) majorSelect.value = 'RPL';
            else if (rawMajor.includes('TKJ')) majorSelect.value = 'TKJ';
            else if (rawMajor.includes('TJA')) majorSelect.value = 'TJA';
            else if (rawMajor.includes('PG') || rawMajor.includes('GIM')) majorSelect.value = 'PG';
          }

          // Pasang Skills
          if (parsed.skillsList && Array.isArray(parsed.skillsList) && parsed.skillsList.length > 0) {
            activeSkills = [...parsed.skillsList];
          } else if (parsed.skills && typeof parsed.skills === 'string') {
            activeSkills = parsed.skills.split(',').map((s: string) => s.trim()).filter(Boolean);
          }

          // Pasang Ringkasan
          if (summaryTextarea && parsed.about) {
            summaryTextarea.value = parsed.about;
          }

          // Pasang Nama Siswa
          if (parsed.name) {
            activeStudentName = parsed.name;
            if (studentNameDisplay) {
              studentNameDisplay.textContent = `Siswa: ${parsed.name}`;
            }
          }

          renderSkillTags();
          renderSuggestedChips();

          // Tampilkan Notifikasi Sukses
          cvStatusAlert.className = 'flex p-3.5 rounded-xl text-xs sm:text-sm items-center justify-between border bg-emerald-50 text-emerald-800 border-emerald-200 transition-all';
          cvStatusMessage.innerHTML = `
            <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Data profil <strong>${parsed.name || 'Siswa'}</strong> (${majorSelect?.value || 'SMK Telkom'}) berhasil ditarik dari CV Generator!</span>
          `;
          cvStatusAlert.classList.remove('hidden');
        } catch (e) {
          console.error('Gagal menarik profil CV:', e);
        }
      }

      btnPullCv?.addEventListener('click', pullDataFromCvGenerator);
      btnCloseAlert?.addEventListener('click', () => {
        cvStatusAlert?.classList.add('hidden');
      });

