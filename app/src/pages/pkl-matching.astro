---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";

// Data Lowongan PKL exact from Figma frame PKL Matching #1632:2101
const pklListings = [
  {
    company: "Telkom Indonesia",
    initials: "TI",
    logoBg: "bg-[#E4002B]",
    location: "Bandung",
    workMode: "Hybrid",
    title: "Frontend Developer Intern",
    tags: ["React", "TypeScript", "Tailwind"],
    desc: "Membantu pengembangan antarmuka portal layanan pelanggan berbasis web.",
    major: "RPL",
  },
  {
    company: "Telkom Akses",
    initials: "TA",
    logoBg: "bg-[#0761C7]",
    location: "Purwokerto",
    workMode: "On-site",
    title: "Fiber Optic Technician Intern",
    tags: ["FTTH", "OTDR", "Splicing"],
    desc: "Praktik langsung penanganan jaringan kabel serat optik dan terminasi ODP.",
    major: "TJA",
  },
  {
    company: "Telkomsigma",
    initials: "TS",
    logoBg: "bg-[#E4002B]",
    location: "Semarang",
    workMode: "On-site",
    title: "Data Center Support Intern",
    tags: ["Jaringan", "Server", "Monitoring"],
    desc: "Membantu pemantauan operasional pusat data perusahaan skala enterprise.",
    major: "TKJ",
  },
  {
    company: "Metra",
    initials: "MT",
    logoBg: "bg-[#E4002B]",
    location: "Jakarta",
    workMode: "Hybrid",
    title: "Multimedia Content Intern",
    tags: ["Video Editing", "Motion", "Desain UI"],
    desc: "Memproduksi konten multimedia untuk kebutuhan promosi digital perusahaan.",
    major: "PG",
  },
  {
    company: "PINS",
    initials: "PN",
    logoBg: "bg-[#0761C7]",
    location: "Purwokerto",
    workMode: "On-site",
    title: "IT Infrastructure Intern",
    tags: ["Jaringan", "Hardware", "Troubleshoot"],
    desc: "Mendukung instalasi dan pemeliharaan infrastruktur jaringan telekomunikasi.",
    major: "TKJ",
  },
];
---

<BaseLayout
  title="AI PKL Matching - SMK Telkom Purwokerto"
  description="Temukan tempat PKL yang paling cocok dengan dirimu melalui pencocokan berbasis AI bersama puluhan mitra industri Telkom Group dan perusahaan teknologi."
>
  <div class="py-6 sm:py-10 bg-[#F5F6F8]">
    <Container>
      <!-- Section 1: Hero Card (Figma Background+Shadow #1632:2438: radius 32px) -->
      <div class="relative overflow-hidden rounded-[32px] bg-gradient-to-tr from-[#ED1E28] via-[#D0161F] to-[#B6252A] p-8 sm:p-12 md:p-20 text-white text-center shadow-xl">
        <div class="absolute -top-24 -left-24 w-96 h-96 rounded-full bg-white/10 blur-[80px] pointer-events-none"></div>
        <div class="absolute -bottom-24 -right-24 w-96 h-96 rounded-full bg-black/20 blur-[80px] pointer-events-none"></div>

        <div class="relative z-10 max-w-4xl mx-auto space-y-6">
          <!-- Pill Badge (Figma #1632:2445) -->
          <div class="inline-flex items-center px-5 py-2 rounded-full bg-white/10 border border-white/20 backdrop-blur-md text-xs sm:text-sm font-semibold tracking-wide">
            AI PKL MATCHING
          </div>

          <!-- Heading 1 (Figma #1632:2449) -->
          <h1 class="font-extrabold text-3xl sm:text-5xl md:text-6xl font-sans tracking-tight leading-[1.15]">
            Temukan Tempat PKL<br class="hidden sm:inline" />
            yang Paling Cocok dengan Dirimu
          </h1>

          <!-- Subtitle (Figma #1632:2451) -->
          <p class="text-white/80 text-sm sm:text-base md:text-lg max-w-3xl mx-auto leading-relaxed">
            Sistem AI kami menganalisis CV-mu dan mencocokkannya dengan puluhan mitra dunia industri secara otomatis — lengkap dengan skor kecocokan, bukan sekadar daftar lowongan biasa.
          </p>
        </div>
      </div>

      <!-- Section 2: Floating Search Bar (Figma Background+Shadow #1632:2538: radius 16px) -->
      <div class="relative z-20 max-w-[1280px] mx-auto -mt-10 sm:-mt-14 md:-mt-16 bg-white border border-[#E7E8EA] rounded-2xl shadow-[0px_20px_50px_0px_rgba(0,0,0,0.12)] p-6 sm:p-8">
        <div class="flex flex-col md:flex-row items-stretch md:items-end gap-5">
          <!-- Input 1: Lokasi PKL (Figma #1632:2540) -->
          <div class="flex-1 space-y-2">
            <label class="block text-xs font-bold text-[#111827] uppercase tracking-wider">
              Lokasi PKL
            </label>
            <div class="relative">
              <input
                type="text"
                id="search-location"
                placeholder="Purwokerto, Jakarta, Bandung, Semarang..."
                class="w-full px-4 py-3.5 rounded-xl bg-[#F5F5F5] border border-[#E7E8EA] text-sm text-[#111827] placeholder:text-neutral-400 focus:bg-white focus:border-[#ED1E28] focus:outline-none transition-all"
              />
            </div>
          </div>

          <!-- Input 2: Jurusan (Figma #1632:2552) -->
          <div class="flex-1 space-y-2">
            <label class="block text-xs font-bold text-[#111827] uppercase tracking-wider">
              Jurusan
            </label>
            <div class="relative">
              <input
                type="text"
                id="search-major"
                placeholder="RPL, TKJ, PG, TJA..."
                class="w-full px-4 py-3.5 rounded-xl bg-[#F5F5F5] border border-[#E7E8EA] text-sm text-[#111827] placeholder:text-neutral-400 focus:bg-white focus:border-[#ED1E28] focus:outline-none transition-all"
              />
            </div>
          </div>

          <!-- Button: CARI PKL (Figma #1632:2563: fill #ED1E28) -->
          <button
            type="button"
            id="btn-search-pkl"
            class="px-8 py-3.5 sm:py-4 rounded-xl bg-[#ED1E28] hover:bg-[#d01620] text-white font-bold text-sm tracking-wider uppercase shadow-md shadow-[#ED1E28]/30 transition-all flex items-center justify-center gap-2"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            CARI PKL
          </button>
        </div>
      </div>

      <!-- Section 3: Industry Partner Listings (Figma Background #1632:2168: padding 80px) -->
      <section class="pt-16 pb-12">
        <div class="max-w-[1280px] mx-auto space-y-6">
          <div class="flex items-center justify-between pb-2">
            <h2 class="text-2xl font-bold text-[#111827] font-sans">
              Rekomendasi Tempat PKL Terbuka
            </h2>
            <span class="text-xs text-neutral-400 font-medium">5 Lowongan Tersedia</span>
          </div>

          <!-- Cards Grid -->
          <div id="pkl-cards-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
            {pklListings.map((job) => (
              <div
                data-location={job.location.toLowerCase()}
                data-major={job.major.toLowerCase()}
                class="pkl-job-card bg-white rounded-2xl p-6 sm:p-7 border border-[#E7E8EA] shadow-sm hover:shadow-xl hover:border-[#ED1E28]/25 transition-all duration-300 flex flex-col justify-between"
              >
                <div class="space-y-4">
                  <!-- Header: Logo, Company & Location -->
                  <div class="flex items-center gap-3">
                    <div class={`w-11 h-11 rounded-full ${job.logoBg} text-white font-bold text-sm flex items-center justify-center shadow-sm shrink-0`}>
                      {job.initials}
                    </div>
                    <div class="space-y-0.5">
                      <h4 class="font-bold text-sm text-[#111827] leading-none">
                        {job.company}
                      </h4>
                      <p class="text-xs text-neutral-400">
                        {job.location}
                      </p>
                    </div>
                  </div>

                  <!-- Job Title -->
                  <h3 class="font-bold text-lg text-[#111827] leading-snug">
                    {job.title}
                  </h3>

                  <!-- Metadata Tags -->
                  <div class="flex items-center gap-3 text-xs text-neutral-500 font-medium">
                    <span class="flex items-center gap-1">
                      <svg class="w-3.5 h-3.5 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      </svg>
                      {job.location}
                    </span>
                    <span>•</span>
                    <span class="px-2.5 py-0.5 rounded-full bg-neutral-100 text-neutral-600 text-[11px]">
                      {job.workMode}
                    </span>
                  </div>

                  <!-- Skill Badges (Figma #1632:2338: bg #F5F6F8, radius 8px) -->
                  <div class="flex flex-wrap gap-2 pt-1">
                    {job.tags.map((tag) => (
                      <span class="px-3 py-1 rounded-lg bg-[#F5F6F8] text-[#55565B] text-xs font-medium">
                        {tag}
                      </span>
                    ))}
                  </div>

                  <!-- Description -->
                  <p class="text-xs sm:text-sm text-[#55565B] leading-relaxed pt-1">
                    {job.desc}
                  </p>
                </div>

                <!-- Footer Action (Figma #1632:2346: Detail →) -->
                <div class="pt-6 border-t border-neutral-100 mt-5 flex items-center justify-between">
                  <span class="text-xs font-semibold text-neutral-400 uppercase">Jurusan: {job.major}</span>
                  <a
                    href="#"
                    class="text-sm font-bold text-[#ED1E28] hover:text-[#d01620] flex items-center gap-1 transition-colors"
                  >
                    Detail →
                  </a>
                </div>
              </div>
            ))}
          </div>

          <!-- Bottom Button: Lihat Semua Rekomendasi (Figma #1632:2435) -->
          <div class="pt-10 flex justify-center">
            <button
              type="button"
              class="px-10 py-3.5 sm:py-4 rounded-full bg-white hover:bg-neutral-50 text-[#111827] border border-[#E7E8EA] font-bold text-sm shadow-sm transition-all duration-300"
            >
              Lihat Semua Rekomendasi
            </button>
          </div>
        </div>
      </section>
    </Container>
  </div>

  <!-- Interactive Search Script -->
  <script>
    function setupPklSearch() {
      const locInput = document.getElementById('search-location') as HTMLInputElement | null;
      const majorInput = document.getElementById('search-major') as HTMLInputElement | null;
      const btn = document.getElementById('btn-search-pkl');
      const cards = document.querySelectorAll<HTMLElement>('.pkl-job-card');

      function filterCards() {
        const locVal = (locInput?.value || '').toLowerCase().trim();
        const majorVal = (majorInput?.value || '').toLowerCase().trim();

        cards.forEach((card) => {
          const cardLoc = card.getAttribute('data-location') || '';
          const cardMajor = card.getAttribute('data-major') || '';

          const matchLoc = !locVal || cardLoc.includes(locVal);
          const matchMajor = !majorVal || cardMajor.includes(majorVal);

          if (matchLoc && matchMajor) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      }

      btn?.addEventListener('click', filterCards);
      locInput?.addEventListener('input', filterCards);
      majorInput?.addEventListener('input', filterCards);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupPklSearch);
    } else {
      setupPklSearch();
    }
  </script>
</BaseLayout>
