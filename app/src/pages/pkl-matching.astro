  <!-- Interactive AI PKL Matching Script -->
  <script>
    interface PklJob {
      id: string;
      company: string;
      initials: string;
      logoBg: string;
      location: string;
      workMode: string;
      title: string;
      tags: string[];
      desc: string;
      major: string;
      quota?: string;
      requirements?: string[];
      contact?: string;
      applyUrl?: string;
      // Kolom dinamis hasil pencocokan AI
      score?: number;
      reason?: string;
      matchedSkills?: string[];
      skillsToImprove?: string[];
    }

    const CV_STORAGE_KEY = 'jhic_student_cv';

    // Saran keahlian per jurusan SMK Telkom
    const SKILL_SUGGESTIONS: Record<string, string[]> = {
      RPL: ['React', 'TypeScript', 'Tailwind CSS', 'Node.js', 'Python', 'REST APIs', 'Git & GitHub', 'Next.js', 'PostgreSQL'],
      TKJ: ['Jaringan Komputer', 'MikroTik', 'Cisco Packet Tracer', 'Linux Server', 'Routing & Switching', 'Hardware Troubleshoot', 'Cloud Basics'],
      TJA: ['Fiber Optic', 'OTDR', 'Splicing FTTH', 'ODP / ODC', 'Topologi FTTH', 'K3 Telekomunikasi', 'Redaman Optik'],
      PG: ['Unity 3D', 'C# Programming', 'Game Design', 'Blender', 'Figma', 'UI/UX Design', 'Video Editing', 'Motion Graphics']
    };

    function setupPklMatching() {
      const root = document.getElementById('pkl-matching-app');
      if (!root) return;

      const rawListings = root.getAttribute('data-initial-listings') || '[]';
      let allJobs: PklJob[] = [];
      try {
        allJobs = JSON.parse(rawListings);
      } catch {
        allJobs = [];
      }

      let currentJobs: PklJob[] = [...allJobs];
      let activeSkills: string[] = ['React', 'TypeScript', 'Tailwind CSS'];
      let isAiMatched = false;
      let activeStudentName = '';

      // Elements
      const majorSelect = document.getElementById('student-major') as HTMLSelectElement | null;
      const locationInput = document.getElementById('student-location-filter') as HTMLInputElement | null;
      const skillsContainer = document.getElementById('skills-tags-container');
      const skillInput = document.getElementById('skills-tag-input') as HTMLInputElement | null;
      const suggestedSkillsContainer = document.getElementById('suggested-skills-list');
      const summaryTextarea = document.getElementById('student-summary') as HTMLTextAreaElement | null;
      const studentNameDisplay = document.getElementById('student-name-display');

      const btnPullCv = document.getElementById('btn-pull-cv');
      const cvStatusAlert = document.getElementById('cv-status-alert');
      const cvStatusMessage = document.getElementById('cv-status-message');
      const btnCloseAlert = document.getElementById('btn-close-alert');

      const btnMatchAi = document.getElementById('btn-match-ai') as HTMLButtonElement | null;
