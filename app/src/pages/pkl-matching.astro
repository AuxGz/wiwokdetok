          modalContact.textContent = contactEmail;
        }
        if (modalApplyBtn) {
          modalApplyBtn.href = job.applyUrl || `mailto:${contactEmail}?subject=Lamaran%20PKL%20${encodeURIComponent(job.company)}%20-%20${encodeURIComponent(job.title)}`;
