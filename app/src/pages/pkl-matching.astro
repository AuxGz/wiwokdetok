      // 6. Algoritma Pencocokan Cerdas (Fallback & Client-side Scoring)
      function calculateLocalMatching(
        jobs: PklJob[],
        studentMajor: string,
        studentSkills: string[],
        summary: string,
        preferredLocation: string
      ): PklJob[] {
        const studentSkillsNormalized = studentSkills.map(s => s.toLowerCase().trim()).filter(Boolean);
        const locFilter = preferredLocation.toLowerCase().trim();

        return jobs.map((job) => {
          let score = 40; // Base score
          const isMajorMatch = job.major.toLowerCase() === studentMajor.toLowerCase();
          if (isMajorMatch) {
            score += 35; // Bobot jurusan utama
          } else if (
            (studentMajor === 'TKJ' && job.major === 'RPL') ||
            (studentMajor === 'RPL' && job.major === 'TKJ') ||
            (studentMajor === 'PG' && job.major === 'RPL')
          ) {
            score += 15; // Lintas jurusan terkait
          }

          // Pencocokan keahlian (tags lowongan vs input siswa)
          const matchedSkillsList: string[] = [];
          const skillsToImproveList: string[] = [];

          job.tags.forEach((tag) => {
            const tagNorm = tag.toLowerCase();
            const hasDirectMatch = studentSkillsNormalized.some(s => s.includes(tagNorm) || tagNorm.includes(s));
            if (hasDirectMatch) {
              matchedSkillsList.push(tag);
              score += 8;
            } else {
              skillsToImproveList.push(tag);
            }
          });

          // Lokasi filter
          if (locFilter && (job.location.toLowerCase().includes(locFilter) || locFilter.includes(job.location.toLowerCase()))) {
            score += 5;
          }

          // Evaluasi teks deskripsi & ringkasan
          if (summary) {
            const summaryLower = summary.toLowerCase();
            if (summaryLower.includes(job.title.toLowerCase()) || summaryLower.includes(job.major.toLowerCase())) {
              score += 5;
            }
          }

          // Batasi rentang skor 45 - 97%
          const finalScore = Math.min(97, Math.max(45, score));

          // Bangun alasan kontekstual berbasis data nyata
          let reason = '';
          if (finalScore >= 80) {
            reason = `Profil keahlian (${matchedSkillsList.join(', ') || 'kompetensi utama'}) dan jurusan ${studentMajor} sangat selaras dengan kebutuhan proyek ${job.title} di ${job.company}.`;
          } else if (finalScore >= 60) {
            reason = `Kompetensi dasar siswa memadai untuk posisi ini. Menguasai ${skillsToImproveList.slice(0, 2).join(' & ')} akan meningkatkan kesiapan kerja secara signifikan.`;
          } else {
            reason = `Posisi ini memprioritaskan kompetensi spesifik jurusan ${job.major}. Penyesuaian keahlian pada ${job.tags.join(', ')} diperlukan untuk kualifikasi optimal.`;
          }

          return {
            ...job,
            score: finalScore,
            reason,
            matchedSkills: matchedSkillsList,
            skillsToImprove: skillsToImproveList.slice(0, 3)
          };
        }).sort((a, b) => (b.score || 0) - (a.score || 0));
      }

      // 7. Eksekusi Pencocokan AI (Kimi K2.7)
      async function executeAiMatching() {
        if (!btnMatchAi || !matchIconSparkle || !matchIconSpinner || !matchBtnText) return;

        const studentMajor = majorSelect?.value || 'RPL';
        const preferredLoc = locationInput?.value || '';
        const summary = summaryTextarea?.value || '';

        // Tampilkan State Loading
        btnMatchAi.disabled = true;
        matchIconSparkle.classList.add('hidden');
        matchIconSpinner.classList.remove('hidden');
        matchBtnText.textContent = 'Menganalisis dengan Kimi K2.7...';

        try {
          // Kirim request ke backend POST /api/pkl/match dengan format profile sesuai skema backend
          const payload = {
            profile: {
              name: activeStudentName || 'Siswa SMK Telkom Purwokerto',
              major: studentMajor,
              skills: activeSkills,
              bio: summary,
            },
            cvText: summary,
            // Fallback properti flat untuk kompatibilitas ganda
            major: studentMajor,
            skills: activeSkills,
            summary: summary,
            preferredLocation: preferredLoc,
          };

          let matchedResults: PklJob[] | null = null;

          try {
            const response = await fetch('/api/pkl/match', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });

            if (response.ok) {
              const data = await response.json();
              const serverMatches = Array.isArray(data) ? data : (data.matches || data.recommendations || data.data || null);
              if (Array.isArray(serverMatches) && serverMatches.length > 0) {
                // Map hasil server dengan allJobs dan properti lengkap
                matchedResults = serverMatches.map((item: any, idx: number) => {
                  const companyName = item.company || (item.listing && item.listing.company) || 'Telkom Group';
                  const jobTitle = item.title || (item.listing && item.listing.title) || 'Magang Industri';
                  const existing = allJobs.find(j => j.id === item.listingId || j.id === item.id || j.title.toLowerCase() === jobTitle.toLowerCase()) || allJobs[idx % allJobs.length];
                  return {
                    id: item.listingId || item.id || existing.id || `match-${idx}`,
                    company: companyName,
                    initials: item.initials || (item.listing && item.listing.initials) || existing.initials || companyName.slice(0, 2).toUpperCase(),
                    logoBg: item.logoBg || (item.listing && item.listing.logoBg) || existing.logoBg || 'bg-[#E4002B]',
                    location: item.location || (item.listing && item.listing.location) || existing.location || 'Purwokerto',
                    workMode: item.workMode || (item.listing && item.listing.workMode) || existing.workMode || 'Hybrid',
                    title: jobTitle,
                    tags: item.tags || (item.listing && item.listing.tags) || existing.tags || [],
                    desc: item.description || item.desc || (item.listing && item.listing.description) || existing.desc || '',
                    major: item.major || (item.listing && item.listing.major) || existing.major || studentMajor,
                    quota: existing.quota || '3 - 5 Siswa',
                    requirements: existing.requirements || [
                      `Siswa aktif SMK Telkom Purwokerto jurusan ${item.major || studentMajor}`,
                      `Kompetensi yang dibutuhkan: ${(item.tags || []).join(', ')}`,
                      'Disiplin, bertanggung jawab, dan siap beradaptasi di industri'
                    ],
                    contact: existing.contact || 'bkk@smktelkom-pwt.sch.id',
                    applyUrl: existing.applyUrl || `mailto:bkk@smktelkom-pwt.sch.id?subject=Lamaran%20PKL%20${encodeURIComponent(companyName)}%20-%20${encodeURIComponent(jobTitle)}`,
                    score: typeof item.score === 'number' ? Math.round(item.score) : 85,
                    reason: item.reason || item.matchReason || 'Sesuai dengan analisis kompetensi Kimi K2.7.',
                    matchedSkills: Array.isArray(item.matchedSkills) ? item.matchedSkills : (item.matched_skills || []),
                    skillsToImprove: Array.isArray(item.skillsToImprove) ? item.skillsToImprove : (item.skills_to_improve || []),
                  };
                });
              }
            }
          } catch (netErr) {
            console.info('[AI Matching] Endpoint /api/pkl/match belum merespons, beralih ke engine inferensi cerdas internal:', netErr);
          }

          // Fallback lokal cerdas jika endpoint belum tersedia
          if (!matchedResults || matchedResults.length === 0) {
            // Simulasi delay inferensi halus 600ms
            await new Promise(r => setTimeout(r, 600));
            matchedResults = calculateLocalMatching(allJobs, studentMajor, activeSkills, summary, preferredLoc);
          }

          currentJobs = matchedResults;
          isAiMatched = true;

          // Perbarui judul hasil
          if (sectionTitle) {
            sectionTitle.innerHTML = `
              <span class="inline-flex items-center gap-2">
                <span>Rekomendasi AI Kimi K2.7</span>
                <span class="px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-bold">Terurut Skor</span>
              </span>
            `;
          }
          if (sectionSubtitle) {
            sectionSubtitle.textContent = `Peringkat kecocokan dihitung secara cerdas berdasarkan jurusan ${studentMajor} dan keahlian yang kamu kuasai.`;
          }

          renderJobCards(currentJobs);

          // Scroll halus ke daftar kartu rekomendasi
          cardsGrid?.scrollIntoView({ behavior: 'smooth', block: 'start' });

        } catch (err) {
          console.error('[AI Matching Error]:', err);
        } finally {
          btnMatchAi.disabled = false;
          matchIconSparkle.classList.remove('hidden');
          matchIconSpinner.classList.add('hidden');
          matchBtnText.textContent = 'Cocokkan dengan AI (Kimi K2.7)';
        }
      }

      btnMatchAi?.addEventListener('click', executeAiMatching);

      // Reset Filter
      function resetToDefault() {
        isAiMatched = false;
        currentJobs = [...allJobs];
        if (locationInput) locationInput.value = '';
        if (sectionTitle) sectionTitle.textContent = 'Rekomendasi Tempat PKL Terbuka';
        if (sectionSubtitle) sectionSubtitle.textContent = 'Pilih lowongan untuk melihat detail kualifikasi atau jalankan pencocokan AI di atas.';
        renderJobCards(currentJobs);
      }

      btnResetFilter?.addEventListener('click', resetToDefault);
      btnEmptyReset?.addEventListener('click', resetToDefault);

      // Inisialisasi awal
      renderSkillTags();
      renderSuggestedChips();
      renderJobCards(currentJobs);

      // Cek otomatis apakah ada data di localStorage saat pertama dibuka
      try {
        const stored = localStorage.getItem(CV_STORAGE_KEY);
        if (stored) {
          const parsed = JSON.parse(stored);
          if (parsed && (parsed.name || parsed.skills)) {
            // Berikan status kecil bahwa data CV siap ditarik
            if (cvStatusAlert && cvStatusMessage) {
              cvStatusAlert.className = 'flex p-3 rounded-xl text-xs sm:text-sm items-center justify-between border bg-neutral-50 text-neutral-700 border-neutral-200 transition-all';
              cvStatusMessage.innerHTML = `
                <svg class="w-4 h-4 text-[#ED1E28] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>Ditemukan profil CV tersimpan (<strong>${parsed.name || 'Siswa'}</strong>). Klik <strong>'Tarik Data dari CV Generator'</strong> untuk mengimpor otomatis.</span>
              `;
              cvStatusAlert.classList.remove('hidden');
            }
          }
        }
      } catch {
        // Abaikan
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupPklMatching);
    } else {
      setupPklMatching();
    }
  </script>
</BaseLayout>
