let pklListings = defaultPklListings;
try {
  const dbPkl = await prisma.pklListing.findMany({
    where: { isOpen: true },
    orderBy: { order: "asc" },
  });
  if (dbPkl.length > 0) {
    pklListings = dbPkl.map((p, idx) => ({
      id: p.id || `db-pkl-${idx}`,
      company: p.company,
      initials: p.initials || p.company.slice(0, 2).toUpperCase(),
      logoBg: p.logoBg || "bg-[#E4002B]",
      location: p.location,
      workMode: p.workMode,
      title: p.title,
      tags: p.tags,
      desc: p.description,
      major: p.major,
      quota: "3 - 5 Siswa",
      requirements: [
        `Siswa aktif SMK Telkom Purwokerto jurusan ${p.major}`,
        `Keahlian yang relevan: ${p.tags.join(", ")}`,
        "Disiplin, bertanggung jawab, dan siap beradaptasi di lingkungan profesional"
      ],
      contact: "bkk@smktelkom-pwt.sch.id",
      applyUrl: `mailto:bkk@smktelkom-pwt.sch.id?subject=Lamaran%20PKL%20${encodeURIComponent(p.company)}%20-%20${encodeURIComponent(p.title)}`
    }));
  }
} catch {
  // Gunakan data default jika database belum tersedia
}
