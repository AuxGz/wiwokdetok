---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";

// 8 Fasilitas Unggulan exact from Figma frame Fasilitas Sekolah #1044:2261
const facilities = [
  {
    badge: "Lapangan",
    title: "Lapangan Olahraga",
    desc: "Lapangan olahraga multifungsi meliputi lapangan basket, voli, dan futsal untuk mendukung aktivitas fisik dan prestasi olahraga siswa.",
    image: "/images/kegiatan/kegiatan-basket.png",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />`
  },
  {
    badge: "Perpustakaan",
    title: "Perpustakaan",
    desc: "Perpustakaan modern dengan koleksi ribuan buku, referensi digital, dan ruang baca nyaman untuk mendukung literasi siswa.",
    image: "/images/profile/indoor-coworking.png",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />`
  },
  {
    badge: "Lab Komputer",
    title: "Laboratorium Komputer",
    desc: "Ruang laboratorium komputer berkapasitas 40 unit PC dengan spesifikasi terkini untuk praktik pemrograman, desain grafis, dan multimedia.",
    image: "/images/profile/smart-school-fasilitas.png",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />`
  },
  {
    badge: "Ruang Kelas",
    title: "Ruang Kelas",
    desc: "Ruang kelas ber-AC dengan proyektor interaktif, meja ergonomis, dan suasana belajar kondusif untuk mendukung proses KBM.",
    image: "/images/brand/gedung-sekolah.png",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />`
  },
  {
    badge: "Masjid",
    title: "Masjid",
    desc: "Masjid sekolah yang indah dan representatif sebagai pusat kegiatan keagamaan, ibadah, dan pembinaan karakter islami siswa.",
    image: "/images/brand/gedung-sekolah.png",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z" />`
  },
  {
    badge: "Lab Jaringan",
    title: "Laboratorium Jaringan",
    desc: "Fasilitas praktik jaringan komputer lengkap dengan perangkat Cisco, server, dan infrastruktur jaringan nyata untuk simulasi industri.",
    image: "/images/profile/smart-school-fasilitas.png",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />`
  },
  {
    badge: "Aula",
    title: "Aula",
    desc: "Gedung serbaguna berkapasitas besar dilengkapi sistem audio visual canggih untuk kegiatan upacara, seminar, dan pentas seni.",
    image: "/images/kegiatan/extrakurikuler-banner.png",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z" />`
  },
  {
    badge: "UKS",
    title: "UKS (Unit Kesehatan Siswa)",
    desc: "Unit Kesehatan Siswa dengan peralatan medis lengkap, tenaga kesehatan terlatih, dan layanan konsultasi kesehatan untuk siswa.",
    image: "/images/profile/smart-school-playing.png",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />`
  }
];
---

<BaseLayout
  title="Fasilitas Sekolah - SMK Telkom Purwokerto"
  description="Fasilitas modern dan lengkap untuk mendukung proses belajar dan berkarya siswa SMK Telkom Purwokerto."
>
  <!-- Section 1: Hero Banner (Figma Fasilitas Kami #1044:2315: height 520px) -->
  <section class="relative w-full h-[480px] sm:h-[520px] overflow-hidden bg-black">
    <!-- Background Image -->
    <img
      src="/images/profile/smart-school-fasilitas.png"
      alt="Fasilitas SMK Telkom Purwokerto"
      class="absolute inset-0 w-full h-full object-cover object-center opacity-40"
      loading="eager"
    />

    <!-- Exact Gradient Overlay from Figma: linear-gradient(90deg, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.6) 50%, rgba(0,0,0,0.3) 100%) -->
    <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/60 to-black/30"></div>

    <!-- Exact Red Vertical Accent Bar on Left (width: 8px, fill: #BD0C12) -->
    <div class="absolute top-0 left-0 bottom-0 w-2 bg-[#BD0C12] z-20"></div>

    <!-- Hero Content (padding: 0px 96px in Figma) -->
    <div class="relative z-10 w-full h-full flex flex-col justify-center">
      <Container>
        <div class="max-w-3xl space-y-4 sm:space-y-6">
          <!-- Breadcrumb (Figma #1044:2321) -->
          <nav class="flex items-center gap-2 text-xs sm:text-sm font-medium">
            <a href="/" class="text-white/70 hover:text-white transition-colors">Beranda</a>
            <span class="text-white/40">/</span>
            <span class="text-[#ED1E28] font-semibold">Fasilitas</span>
          </nav>

          <!-- Eyebrow (Figma #1044:2330) -->
          <div class="flex items-center gap-2.5">
            <span class="w-8 h-0.5 bg-[#BD0C12]"></span>
            <span class="text-[#ED1E28] font-semibold text-xs sm:text-sm tracking-[0.1em] uppercase font-sans">
              SMK TELKOM PURWOKERTO
            </span>
          </div>

          <!-- Heading 1 (Figma #1044:2336: Poppins Bold 58px) -->
          <h1 class="font-poppins font-bold text-4xl sm:text-5xl md:text-[58px] text-white leading-[1.1] tracking-tight">
            Fasilitas Kami
          </h1>

          <!-- Subtitle (Figma #1044:2338) -->
          <p class="text-white/75 text-base sm:text-lg leading-relaxed max-w-xl">
            Kami menyediakan fasilitas modern dan lengkap untuk mendukung proses belajar dan berkarya siswa SMK Telkom Purwokerto.
          </p>

          <!-- Hero Stat Row (Figma #1044:2340: 12+, 1200+, 4) -->
          <div class="pt-4 flex items-center gap-6 sm:gap-10">
            <div>
              <p class="text-2xl sm:text-3xl font-bold text-white font-sans">12+</p>
              <p class="text-white/60 text-xs font-normal">Fasilitas Unggulan</p>
            </div>
            <div class="w-px h-8 bg-white/20"></div>
            <div>
              <p class="text-2xl sm:text-3xl font-bold text-white font-sans">1200+</p>
              <p class="text-white/60 text-xs font-normal">Siswa Aktif</p>
            </div>
            <div class="w-px h-8 bg-white/20"></div>
            <div>
              <p class="text-2xl sm:text-3xl font-bold text-white font-sans">4</p>
              <p class="text-white/60 text-xs font-normal">Program Keahlian</p>
            </div>
          </div>
        </div>
      </Container>
    </div>
  </section>

  <!-- Section 2: Facilities Grid (Figma Fasilitas #1703:2119: bg: #F7F8F9, padding: 40px 80px 80px) -->
  <section class="py-16 md:py-24 bg-[#F7F8F9]">
    <Container>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-[1360px] mx-auto">
        {facilities.map((fac) => (
          <div class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between border border-neutral-100">
            <!-- Image & Badge Container -->
            <div class="relative w-full aspect-[16/10] overflow-hidden bg-neutral-100">
              <img
                src={fac.image}
                alt={fac.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute top-4 left-4 px-4 py-1 rounded-full bg-[#BD0C12] text-white text-xs font-bold shadow-md">
                {fac.badge}
              </div>
            </div>

            <!-- Card Body Container -->
            <div class="p-6 sm:p-7 space-y-4 flex-1 flex flex-col justify-between">
              <div class="space-y-3">
                <div class="flex items-center gap-3">
                  <!-- Red Icon Box (Figma bg: #FEF2F2, radius: 12px) -->
                  <div class="w-10 h-10 rounded-xl bg-[#FEF2F2] flex items-center justify-center text-[#BD0C12] shrink-0">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <Fragment set:html={fac.icon} />
                    </svg>
                  </div>
                  <h3 class="font-bold text-lg sm:text-xl text-[#2B2C31] font-sans">
                    {fac.title}
                  </h3>
                </div>

                <p class="text-[#959597] text-sm leading-relaxed">
                  {fac.desc}
                </p>
              </div>

              <!-- Horizontal Border Divider (Figma #1703:1697: stroke #E7E8EA) -->
              <div class="pt-4 border-t border-[#E7E8EA] flex items-center justify-between text-xs text-neutral-400">
                <span>Fasilitas Resmi</span>
                <span class="text-[#BD0C12] font-semibold group-hover:translate-x-1 transition-transform">Standar Industri →</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>
</BaseLayout>
