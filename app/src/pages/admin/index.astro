---
import AdminLayout from "../../layouts/AdminLayout.astro";

// Default fallback statistik jika database belum terkoneksi
let stats = {
  news: 5,
  majors: 4,
  teachers: 17,
  facilities: 8,
  achievements: 6,
  extracurriculars: 6,
  partners: 7,
  pkl: 6,
  alumni: 4,
  faqs: 3,
  aiChunks: 124,
};

// Ambil statistik riil dari database jika tersedia
try {
  const { prisma } = await import("../../server/lib/prisma.js");
  const [
    newsCount,
    majorsCount,
    teachersCount,
    facilitiesCount,
    achievementsCount,
    ekskulCount,
    partnersCount,
    pklCount,
    alumniCount,
    faqsCount,
    chunksCount,
  ] = await Promise.all([
    prisma.newsArticle.count(),
    prisma.schoolMajor.count(),
    prisma.teacherLeader.count(),
    prisma.schoolFacility.count(),
    prisma.studentAchievement.count(),
    prisma.extracurricular.count(),
    prisma.industryPartner.count(),
    prisma.pklListing.count(),
    prisma.alumniStory.count(),
    prisma.faqItem.count(),
    prisma.knowledgeChunk.count().catch(() => 124),
  ]);

  stats = {
    news: newsCount,
    majors: majorsCount,
    teachers: teachersCount,
    facilities: facilitiesCount,
    achievements: achievementsCount,
    extracurriculars: ekskulCount,
    partners: partnersCount,
    pkl: pklCount,
    alumni: alumniCount,
    faqs: faqsCount,
    aiChunks: chunksCount,
  };
} catch {
  // Silent fallback ke data statistik default
}

const moduleCards = [
  { key: "berita", title: "Berita & Agenda", count: stats.news, desc: "Kelola artikel, pengumuman, dan liputan kegiatan", href: "/admin/berita", color: "from-red-500 to-rose-600" },
  { key: "jurusan", title: "Program Keahlian", count: stats.majors, desc: "Kelola kurikulum & keunggulan 4 jurusan", href: "/admin/jurusan", color: "from-blue-500 to-indigo-600" },
  { key: "guru", title: "Dewan Guru & Pimpinan", count: stats.teachers, desc: "Kelola data kepala sekolah & dewan guru", href: "/admin/guru", color: "from-emerald-500 to-teal-600" },
  { key: "fasilitas", title: "Fasilitas & Lab 3D", count: stats.facilities, desc: "Kelola sarana lab & foto panorama 360°", href: "/admin/fasilitas", color: "from-purple-500 to-violet-600" },
  { key: "prestasi", title: "Prestasi Siswa", count: stats.achievements, desc: "Daftar juara kompetisi vokasi & teknologi", href: "/admin/prestasi", color: "from-amber-500 to-orange-600" },
  { key: "ekstrakurikuler", title: "Ekstrakurikuler", count: stats.extracurriculars, desc: "Kelola kegiatan minat bakat & organisasi", href: "/admin/ekstrakurikuler", color: "from-cyan-500 to-blue-600" },
  { key: "mitra", title: "Mitra Industri", count: stats.partners, desc: "Kelola logo BUMN & perusahaan rekanan", href: "/admin/mitra", color: "from-rose-500 to-red-600" },
  { key: "pkl", title: "Lowongan PKL", count: stats.pkl, desc: "Kelola tempat magang & kriteria jurusan", href: "/admin/pkl", color: "from-teal-500 to-emerald-600" },
  { key: "alumni", title: "Cerita Sukses Alumni", count: stats.alumni, desc: "Testimoni dan rekam jejak lulusan", href: "/admin/alumni", color: "from-indigo-500 to-purple-600" },
  { key: "faq", title: "Pertanyaan (FAQ)", count: stats.faqs, desc: "Tanya jawab seputar PPDB & kurikulum", href: "/admin/faq", color: "from-slate-600 to-neutral-700" },
  { key: "pengaturan", title: "Pengaturan Website", count: "Konfigurasi", desc: "Kelola sambutan, kontak, & link PPDB", href: "/admin/pengaturan", color: "from-neutral-700 to-neutral-900" },
  { key: "ai-sync", title: "Sinkronisasi AI", count: `${stats.aiChunks} Chunks`, desc: "Pembaruan basis pengetahuan chatbot", href: "/admin/ai-sync", color: "from-red-600 to-amber-600" },
];
---

<AdminLayout title="Dasbor Manajemen Konten" activeModule="dashboard">
  <div class="space-y-8">
    <!-- Hero Banner Card -->
    <div class="relative overflow-hidden rounded-3xl bg-neutral-900 text-white p-6 sm:p-8 shadow-xl">
      <div class="absolute -right-16 -top-16 w-80 h-80 rounded-full bg-[#E31E24]/25 blur-[70px] pointer-events-none"></div>
      <div class="absolute right-32 -bottom-20 w-64 h-64 rounded-full bg-amber-500/15 blur-[60px] pointer-events-none"></div>

      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="space-y-2 max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-xs font-bold text-neutral-200 border border-white/10">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>Sistem Operasional Aktif</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
            Selamat Datang di Panel Admin SMK Telkom
          </h2>
          <p class="text-neutral-300 text-sm leading-relaxed">
            Kelola seluruh informasi portal sekolah dan sinkronkan data ke asisten cerdas AI SMK Telkom Purwokerto dalam satu tempat yang terpadu.
          </p>
        </div>

        <!-- Trigger Sync AI Cepat -->
        <div class="shrink-0 flex flex-col sm:flex-row gap-3">
          <button
            id="quick-ai-sync-btn"
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl bg-[#E31E24] hover:bg-[#c9181e] text-white font-bold text-sm shadow-lg shadow-red-600/30 transition-all cursor-pointer"
          >
            <svg id="sync-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            <span id="sync-btn-text">Sinkronkan ke Otak AI</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Feedback Notification -->
    <div
      id="dashboard-sync-alert"
      class="hidden p-4 rounded-2xl border text-sm font-semibold flex items-center justify-between transition-all"
    >
      <div class="flex items-center gap-3">
        <span id="sync-alert-icon"></span>
        <span id="sync-alert-text"></span>
      </div>
      <button id="close-alert-btn" class="text-xs font-bold underline cursor-pointer">Tutup</button>
    </div>

    <!-- 12 Modul Grid -->
    <div>
      <div class="flex items-center justify-between mb-4">
        <div>
          <h3 class="text-base font-extrabold text-neutral-900 tracking-tight">
            Modul Konten Sekolah
          </h3>
          <p class="text-xs text-neutral-500">Pilih modul di bawah ini untuk mengelola data</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {
          moduleCards.map((card) => (
            <a
              href={card.href}
              class="group relative bg-white rounded-2xl border border-neutral-200 hover:border-neutral-300 p-5 shadow-xs hover:shadow-lg transition-all duration-200 flex flex-col justify-between overflow-hidden"
            >
              <div class="space-y-3">
                <div class="flex items-center justify-between">
                  <div class={`w-10 h-10 rounded-xl bg-gradient-to-tr ${card.color} text-white flex items-center justify-center font-bold shadow-sm`}>
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </div>
                  <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-neutral-100 text-neutral-700">
                    {card.count}
                  </span>
                </div>

                <div>
                  <h4 class="text-sm font-bold text-neutral-900 group-hover:text-[#E31E24] transition-colors">
                    {card.title}
                  </h4>
                  <p class="text-xs text-neutral-500 line-clamp-2 mt-1 leading-relaxed">
                    {card.desc}
                  </p>
                </div>
              </div>

              <div class="mt-4 pt-3 border-t border-neutral-100 flex items-center justify-between text-xs font-bold text-[#E31E24]">
                <span>Buka Pengelola</span>
                <span class="group-hover:translate-x-1 transition-transform">→</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <script>
    const syncBtn = document.getElementById("quick-ai-sync-btn") as HTMLButtonElement;
    const syncText = document.getElementById("sync-btn-text") as HTMLElement;
    const syncIcon = document.getElementById("sync-icon") as HTMLElement;
    const alertBox = document.getElementById("dashboard-sync-alert") as HTMLElement;
    const alertText = document.getElementById("sync-alert-text") as HTMLElement;
    const alertIcon = document.getElementById("sync-alert-icon") as HTMLElement;
    const closeAlertBtn = document.getElementById("close-alert-btn") as HTMLElement;

    closeAlertBtn?.addEventListener("click", () => {
      alertBox?.classList.add("hidden");
    });

    syncBtn?.addEventListener("click", async () => {
      syncBtn.disabled = true;
      syncText.textContent = "Menyinkronkan data...";
      syncIcon.classList.add("animate-spin");
      alertBox?.classList.add("hidden");

      try {
        const res = await fetch("/api/admin/ai/sync", { method: "POST" });
        if (!res.ok) {
          throw new Error(`Sinkronisasi gagal dengan status HTTP ${res.status}`);
        }
        const json = await res.json();
        
        alertBox.className = "p-4 rounded-2xl border text-sm font-semibold flex items-center justify-between transition-all bg-emerald-50 text-emerald-800 border-emerald-300";
        alertText.textContent = json.message || "Sinkronisasi AI berhasil diselesaikan! Chatbot kini memiliki pengetahuan terbaru.";
        alertIcon.textContent = "✅";
        alertBox.classList.remove("hidden");
      } catch (err: any) {
        alertBox.className = "p-4 rounded-2xl border text-sm font-semibold flex items-center justify-between transition-all bg-red-50 text-red-800 border-red-300";
        alertText.textContent = err.message || "Gagal melakukan sinkronisasi AI.";
        alertIcon.textContent = "⚠️";
        alertBox.classList.remove("hidden");
      } finally {
        syncBtn.disabled = false;
        syncText.textContent = "Sinkronkan ke Otak AI";
        syncIcon.classList.remove("animate-spin");
      }
    });
  </script>
</AdminLayout>
