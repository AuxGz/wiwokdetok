---
import Container from "./Container.astro";
---

<header class="site-header">
  <Container>
    <div class="header-pill">
      <!-- Brand Logo -->
      <a href="/" class="brand-link" aria-label="Beranda SMK Telkom Purwokerto">
        <div class="brand-logo-wrap">
          <img src="/images/image 22.png" alt="Logo SMK Telkom Purwokerto" class="brand-logo-img" width="38" height="38" />
        </div>
        <div class="brand-text-group">
          <span class="brand-title">SMK Telkom Purwokerto</span>
          <span class="brand-subtitle">TELKOM SCHOOLS</span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="desktop-nav" aria-label="Navigasi Utama">
        <a href="/" class="nav-item active">Beranda</a>

        <div class="nav-item dropdown">
          <button class="dropdown-trigger" type="button" aria-expanded="false">
            <span>Tentang</span>
            <svg class="chevron-icon" width="12" height="12" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
          <div class="dropdown-menu">
            <a href="#about" class="dropdown-link">Profile Sekolah</a>
            <a href="#about" class="dropdown-link">Profile Guru</a>
            <a href="#about" class="dropdown-link">Fasilitas</a>
            <a href="#stats" class="dropdown-link">Prestasi</a>
          </div>
        </div>

        <div class="nav-item dropdown">
          <button class="dropdown-trigger" type="button" aria-expanded="false">
            <span>Program</span>
            <svg class="chevron-icon" width="12" height="12" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
          <div class="dropdown-menu">
            <a href="#jurusan" class="dropdown-link">Pengembangan Game (PG)</a>
            <a href="#jurusan" class="dropdown-link">Rekayasa Perangkat Lunak (RPL)</a>
            <a href="#jurusan" class="dropdown-link">Teknik Komputer & Jaringan (TKJ)</a>
            <a href="#jurusan" class="dropdown-link">Teknik Jaringan Akses (TJA)</a>
          </div>
        </div>

        <div class="nav-item dropdown">
          <button class="dropdown-trigger" type="button" aria-expanded="false">
            <span>Informasi</span>
            <svg class="chevron-icon" width="12" height="12" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
          <div class="dropdown-menu">
            <a href="#berita" class="dropdown-link">Berita & Agenda</a>
            <a href="#stats" class="dropdown-link">Prestasi</a>
            <a href="#alumni" class="dropdown-link">Alumni</a>
          </div>
        </div>

        <a href="/school-tour" class="nav-item">School Tour</a>
      </nav>

      <!-- Action Button -->
      <div class="header-actions">
        <a href="#ppdb" class="btn-ppdb-header">
          PPDB 2026
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button id="mobile-toggle" class="mobile-toggle" type="button" aria-label="Buka Menu Navigasi">
          <svg class="menu-icon" width="22" height="22" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Drawer -->
    <div id="mobile-menu" class="mobile-menu" hidden>
      <nav class="mobile-nav-links">
        <a href="/" class="mobile-nav-link">Beranda</a>
        <a href="#about" class="mobile-nav-link">Tentang Sekolah</a>
        <a href="#sambutan" class="mobile-nav-link">Sambutan Kepala Sekolah</a>
        <a href="#jurusan" class="mobile-nav-link">Program Keahlian</a>
        <a href="#kerjasama" class="mobile-nav-link">Kerjasama Industri</a>
        <a href="#berita" class="mobile-nav-link">Informasi & Berita</a>
        <a href="#alumni" class="mobile-nav-link">Cerita Sukses Alumni</a>
        <a href="/school-tour" class="mobile-nav-link">School Tour</a>
        <div class="mobile-ppdb-wrap">
          <a href="#ppdb" class="btn-ppdb-header" style="display: block; text-align: center;">Daftar PPDB 2026</a>
        </div>
      </nav>
    </div>
  </Container>
</header>

<script>
  const toggleBtn = document.getElementById("mobile-toggle");
  const mobileMenu = document.getElementById("mobile-menu");

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener("click", () => {
      const isHidden = mobileMenu.hasAttribute("hidden");
      if (isHidden) {
        mobileMenu.removeAttribute("hidden");
        toggleBtn.setAttribute("aria-expanded", "true");
      } else {
        mobileMenu.setAttribute("hidden", "");
        toggleBtn.setAttribute("aria-expanded", "false");
      }
    });

    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        mobileMenu.setAttribute("hidden", "");
        toggleBtn.setAttribute("aria-expanded", "false");
      });
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 1rem;
    z-index: 100;
    padding: 0.5rem 0 1rem 0;
    background: transparent;
  }

  .header-pill {
    background-color: #ffffff;
    border-radius: 9999px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05), 0 1px 3px rgba(0, 0, 0, 0.03);
    border: 1px solid rgba(0, 0, 0, 0.05);
    padding: 0.65rem 1.25rem 0.65rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 76px;
    transition: box-shadow 0.2s ease;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .brand-logo-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .brand-logo-img {
    width: 38px;
    height: 38px;
    object-fit: contain;
    display: block;
  }

  .brand-text-group {
    display: flex;
    flex-direction: column;
  }

  .brand-title {
    font-family: var(--font-poppins);
    font-size: 1.0625rem;
    font-weight: 700;
    color: #1e1e1e;
    line-height: 1.2;
  }

  .brand-subtitle {
    font-family: var(--font-inter);
    font-size: 0.725rem;
    font-weight: 600;
    color: #9ca3af;
    letter-spacing: 0.08em;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 2.25rem;
  }

  .nav-item {
    font-family: var(--font-jakarta);
    font-size: 1rem;
    font-weight: 500;
    color: #4b5563;
    padding: 0.5rem 0;
    position: relative;
    cursor: pointer;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .nav-item:hover,
  .nav-item.active {
    color: #1e1e1e;
    font-weight: 600;
  }

  .dropdown {
    position: relative;
  }

  .dropdown-trigger {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: #4b5563;
    font-family: var(--font-jakarta);
    font-size: 1rem;
    font-weight: 500;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: color 0.15s ease;
  }

  .dropdown-trigger:hover {
    color: #1e1e1e;
  }

  .chevron-icon {
    transition: transform 0.2s ease;
    color: #6b7280;
  }

  .dropdown-menu {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%) translateY(6px);
    min-width: 230px;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: var(--radius-md);
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
    padding: 0.5rem 0;
    opacity: 0;
    visibility: hidden;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 100;
  }

  .dropdown:hover .dropdown-menu,
  .dropdown:focus-within .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .dropdown:hover .chevron-icon {
    transform: rotate(180deg);
  }

  .dropdown-link {
    display: block;
    padding: 0.55rem 1.25rem;
    font-size: 0.8125rem;
    font-family: var(--font-jakarta);
    color: #374151;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .dropdown-link:hover {
    background-color: #f9fafb;
    color: #ed1e28;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .btn-ppdb-header {
    background-color: #ed1e28;
    color: #ffffff;
    font-family: var(--font-jakarta);
    font-size: 0.9375rem;
    font-weight: 700;
    padding: 0.75rem 2rem;
    border-radius: 9999px;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(237, 30, 40, 0.35);
    transition: transform 0.15s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease, background-color 0.2s ease;
    letter-spacing: 0.02em;
    display: inline-block;
  }

  .btn-ppdb-header:hover {
    background-color: #d81820;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(237, 30, 40, 0.45);
  }

  .btn-ppdb-header:active {
    transform: scale(0.97);
  }

  .mobile-toggle {
    display: none;
    color: #1e1e1e;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.375rem;
    border-radius: var(--radius-sm);
  }

  .mobile-menu {
    border: 1px solid #e5e7eb;
    border-radius: var(--radius-lg);
    background-color: #ffffff;
    padding: 1.25rem;
    margin-top: 0.75rem;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .mobile-nav-link {
    font-family: var(--font-jakarta);
    font-size: 0.9375rem;
    font-weight: 500;
    color: #374151;
    padding: 0.375rem 0.5rem;
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .mobile-nav-link:hover {
    background-color: #f3f4f6;
    color: #ed1e28;
  }

  .mobile-ppdb-wrap {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid #e5e7eb;
  }

  @media (max-width: 992px) {
    .desktop-nav {
      display: none;
    }
    .mobile-toggle {
      display: block;
    }
    .header-pill {
      padding: 0.65rem 1.25rem 0.65rem 2rem;
    }
  }
</style>
