---
import Container from "./Container.astro";
---

<header class="site-header">
  <Container>
    <div class="header-inner">
      <a href="/" class="brand-logo">
        <span class="brand-text">Website Sekolah</span>
      </a>
      <nav class="site-nav">
        <a href="/">Beranda</a>
        <a href="/api/health" target="_blank" rel="noopener">Status API</a>
      </nav>
    </div>
  </Container>
</header>

<style>
  .site-header {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: 1rem 0;
  }
  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .brand-text {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
  }
  .site-nav {
    display: flex;
    gap: 1.5rem;
  }
  .site-nav a {
    color: var(--color-text-muted);
    font-weight: 500;
  }
  .site-nav a:hover {
    color: var(--color-primary);
  }
</style>
