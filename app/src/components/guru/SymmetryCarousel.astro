---
import type { PimpinanItem } from "../../data/guru-data";

interface Props {
  items: PimpinanItem[];
}

const { items } = Astro.props;
---

<div class="symmetry-carousel-wrapper relative w-full py-4 select-none" id="symmetry-pimpinan-carousel">
  <!-- 3D Cylindrical Perspective Stage -->
  <div class="perspective-stage relative w-full h-[390px] sm:h-[440px] flex items-center justify-center overflow-hidden [perspective:1200px]">
    <!-- Background Ambient Glow behind Active Card -->
    <div class="ambient-glow absolute w-[340px] h-[340px] rounded-full bg-[#ed1e28]/10 blur-[90px] pointer-events-none -z-1 transition-all duration-700"></div>

    <!-- Cards Track -->
    <div class="cards-track relative w-full h-full flex items-center justify-center [transform-style:preserve-3d]">
      {
        items.map((item, idx) => (
          <div
            class="carousel-card absolute w-[260px] sm:w-[310px] h-[330px] sm:h-[370px] bg-white rounded-[26px] p-6 border-2 border-slate-100 flex flex-col items-center justify-between transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] cursor-pointer will-change-transform shadow-xs"
            data-index={idx}
            style="transform-style: preserve-3d; backface-visibility: hidden; -webkit-backface-visibility: hidden;"
          >
            <!-- Card Top: Category Badge -->
            <div class="w-full flex justify-between items-center">
              <span class="inline-flex items-center text-[11px] font-bold uppercase tracking-wider font-poppins px-3 py-1 rounded-full bg-[#fef2f2] text-[#ed1e28] border border-[#ed1e28]/20">
                {item.badge}
              </span>
              <span class="text-xs font-semibold text-slate-400 font-mono">
                {String(idx + 1).padStart(2, "0")}
              </span>
            </div>

            <!-- Card Center: Portrait & Avatar Frame -->
            <div class="relative my-auto flex flex-col items-center">
              <div class="avatar-ring relative w-28 h-28 sm:w-32 sm:h-32 rounded-full p-1 bg-gradient-to-tr from-[#ed1e28] via-[#ff6b6b] to-slate-200 shadow-md">
                <div class="w-full h-full rounded-full bg-white overflow-hidden p-1 flex items-center justify-center">
                  <img
                    src={item.portrait}
                    alt={item.name}
                    class="w-full h-full object-cover object-top rounded-full"
                    loading="eager"
                  />
                </div>
              </div>
            </div>

            <!-- Card Bottom: Quick Preview Info -->
            <div class="w-full text-center pt-3 border-t border-slate-100">
              <h4 class="font-poppins text-sm sm:text-base font-bold text-[#111827] truncate">
                {item.name}
              </h4>
              <p class="font-jakarta text-[11px] sm:text-xs text-[#ed1e28] font-semibold truncate mt-0.5">
                {item.title}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Synchronized Bottom Meta & Navigation (Symmetry Style) -->
  <div class="meta-stage mt-6 sm:mt-8 max-w-[760px] mx-auto px-4 text-center">
    <!-- Active Item Text Details -->
    <div class="meta-content min-h-[140px] flex flex-col items-center justify-start transition-all duration-300" id="carousel-meta-display">
      <div class="inline-block text-xs font-bold text-[#ed1e28] uppercase tracking-[0.14em] font-poppins mb-1.5" id="meta-badge">
        {items[0].badge} • {items[0].bidang}
      </div>
      <h3 class="font-poppins text-2xl sm:text-3xl font-bold text-[#111827] mb-2 leading-tight tracking-[-0.02em]" id="meta-name">
        {items[0].name}
      </h3>
      <div class="font-jakarta text-sm sm:text-base font-semibold text-[#ed1e28] mb-3" id="meta-title">
        {items[0].title}
      </div>
      <p class="font-jakarta text-xs sm:text-sm text-[#64748b] leading-[1.65] max-w-[580px] mx-auto m-0" id="meta-description">
        {items[0].description}
      </p>

      <!-- Subordinates / Kaur List if Available -->
      <div class="mt-4 flex flex-wrap justify-center gap-2" id="meta-subordinates">
        {
          items[0].subordinates.map((sub) => (
            <span class="inline-flex items-center gap-1.5 text-[11px] font-jakarta bg-slate-100 text-slate-700 px-3 py-1 rounded-full border border-slate-200">
              <span class="w-1.5 h-1.5 rounded-full bg-[#ed1e28]"></span>
              <strong>{sub.title}:</strong> {sub.name}
            </span>
          ))
        }
      </div>
    </div>

    <!-- Navigation Bar: Prev Button, Dots/Counter, Next Button -->
    <div class="nav-controls flex items-center justify-center gap-6 mt-8">
      <!-- Prev Button -->
      <button
        type="button"
        class="nav-btn-prev w-12 h-12 rounded-full border border-slate-200 bg-white text-slate-700 flex items-center justify-center hover:border-[#ed1e28] hover:text-[#ed1e28] hover:bg-[#fef2f2] active:scale-95 transition-all shadow-xs cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#ed1e28]/20"
        aria-label="Profil Sebelumnya"
        id="btn-carousel-prev"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <!-- Indicator Dots -->
      <div class="pagination-dots flex items-center gap-2" id="carousel-dots-container">
        {
          items.map((_, idx) => (
            <button
              type="button"
              class={`dot-btn h-2.5 rounded-full transition-all duration-300 cursor-pointer ${idx === 0 ? "w-8 bg-[#ed1e28]" : "w-2.5 bg-slate-300 hover:bg-slate-400"}`}
              data-index={idx}
              aria-label={`Ke profil ${idx + 1}`}
            />
          ))
        }
      </div>

      <!-- Next Button -->
      <button
        type="button"
        class="nav-btn-next w-12 h-12 rounded-full border border-slate-200 bg-white text-slate-700 flex items-center justify-center hover:border-[#ed1e28] hover:text-[#ed1e28] hover:bg-[#fef2f2] active:scale-95 transition-all shadow-xs cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#ed1e28]/20"
        aria-label="Profil Selanjutnya"
        id="btn-carousel-next"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </div>
</div>

<script define:vars={{ items }}>
  function setupSymmetryCarousel() {
    const root = document.getElementById("symmetry-pimpinan-carousel");
    if (!root) return;

    const cards = Array.from(root.querySelectorAll(".carousel-card"));
    const prevBtn = root.querySelector("#btn-carousel-prev");
    const nextBtn = root.querySelector("#btn-carousel-next");
    const dotsContainer = root.querySelector("#carousel-dots-container");
    const dots = dotsContainer ? Array.from(dotsContainer.querySelectorAll(".dot-btn")) : [];

    const metaDisplay = root.querySelector("#carousel-meta-display");
    const metaBadge = root.querySelector("#meta-badge");
    const metaName = root.querySelector("#meta-name");
    const metaTitle = root.querySelector("#meta-title");
    const metaDesc = root.querySelector("#meta-description");
    const metaSubs = root.querySelector("#meta-subordinates");

    let currentIndex = 0;
    const totalItems = items.length;

    const getSpacingOffset = () => {
      const w = window.innerWidth;
      if (w < 640) return 180; // mobile
      if (w < 1024) return 240; // tablet
      return 290; // desktop
    };

    function updateCarousel(newIdx) {
      currentIndex = (newIdx + totalItems) % totalItems;
      const spacing = getSpacingOffset();

      cards.forEach((card, idx) => {
        let delta = idx - currentIndex;
        if (delta > totalItems / 2) delta -= totalItems;
        if (delta < -totalItems / 2) delta += totalItems;

        if (delta === 0) {
          // Center Active Card
          card.style.transform = `translateX(0px) translateZ(0px) rotateY(0deg) scale(1)`;
          card.style.opacity = "1";
          card.style.zIndex = "30";
          card.style.pointerEvents = "auto";
          card.style.filter = "none";
          card.classList.add("border-[#ed1e28]", "shadow-[0_20px_45px_rgba(237,30,40,0.14)]");
          card.classList.remove("border-slate-100", "shadow-xs");
        } else if (delta === -1) {
          // Left Neighbor
          card.style.transform = `translateX(-${spacing}px) translateZ(-60px) rotateY(18deg) scale(0.86)`;
          card.style.opacity = "0.55";
          card.style.zIndex = "20";
          card.style.pointerEvents = "auto";
          card.style.filter = "grayscale(25%)";
          card.classList.remove("border-[#ed1e28]", "shadow-[0_20px_45px_rgba(237,30,40,0.14)]");
          card.classList.add("border-slate-100", "shadow-xs");
        } else if (delta === 1) {
          // Right Neighbor
          card.style.transform = `translateX(${spacing}px) translateZ(-60px) rotateY(-18deg) scale(0.86)`;
          card.style.opacity = "0.55";
          card.style.zIndex = "20";
          card.style.pointerEvents = "auto";
          card.style.filter = "grayscale(25%)";
          card.classList.remove("border-[#ed1e28]", "shadow-[0_20px_45px_rgba(237,30,40,0.14)]");
          card.classList.add("border-slate-100", "shadow-xs");
        } else if (delta === -2) {
          // Far Left
          card.style.transform = `translateX(-${spacing * 1.75}px) translateZ(-140px) rotateY(32deg) scale(0.72)`;
          card.style.opacity = "0.2";
          card.style.zIndex = "10";
          card.style.pointerEvents = "auto";
          card.style.filter = "grayscale(60%) blur(0.5px)";
          card.classList.remove("border-[#ed1e28]", "shadow-[0_20px_45px_rgba(237,30,40,0.14)]");
        } else if (delta === 2) {
          // Far Right
          card.style.transform = `translateX(${spacing * 1.75}px) translateZ(-140px) rotateY(-32deg) scale(0.72)`;
          card.style.opacity = "0.2";
          card.style.zIndex = "10";
          card.style.pointerEvents = "auto";
          card.style.filter = "grayscale(60%) blur(0.5px)";
          card.classList.remove("border-[#ed1e28]", "shadow-[0_20px_45px_rgba(237,30,40,0.14)]");
        } else {
          // Hidden Behind
          card.style.transform = `translateX(${delta > 0 ? spacing * 2 : -spacing * 2}px) translateZ(-250px) scale(0.5)`;
          card.style.opacity = "0";
          card.style.zIndex = "1";
          card.style.pointerEvents = "none";
        }
      });

      // Update Pagination Dots
      dots.forEach((dot, idx) => {
        if (idx === currentIndex) {
          dot.className = "dot-btn h-2.5 rounded-full transition-all duration-300 cursor-pointer w-8 bg-[#ed1e28]";
        } else {
          dot.className = "dot-btn h-2.5 rounded-full transition-all duration-300 cursor-pointer w-2.5 bg-slate-300 hover:bg-slate-400";
        }
      });

      // Update Meta Details with Subtle Fade
      if (metaDisplay) {
        metaDisplay.style.opacity = "0";
        metaDisplay.style.transform = "translateY(4px)";
        setTimeout(() => {
          const currentItem = items[currentIndex];
          if (metaBadge) metaBadge.textContent = `${currentItem.badge} • ${currentItem.bidang}`;
          if (metaName) metaName.textContent = currentItem.name;
          if (metaTitle) metaTitle.textContent = currentItem.title;
          if (metaDesc) metaDesc.textContent = currentItem.description;

          if (metaSubs) {
            metaSubs.innerHTML = "";
            if (currentItem.subordinates && currentItem.subordinates.length > 0) {
              currentItem.subordinates.forEach((sub) => {
                const badge = document.createElement("span");
                badge.className = "inline-flex items-center gap-1.5 text-[11px] font-jakarta bg-slate-100 text-slate-700 px-3 py-1 rounded-full border border-slate-200";
                badge.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-[#ed1e28]"></span><strong>${sub.title}:</strong> ${sub.name}`;
                metaSubs.appendChild(badge);
              });
            }
          }

          metaDisplay.style.opacity = "1";
          metaDisplay.style.transform = "translateY(0px)";
        }, 160);
      }
    }

    if (prevBtn) prevBtn.addEventListener("click", () => updateCarousel(currentIndex - 1));
    if (nextBtn) nextBtn.addEventListener("click", () => updateCarousel(currentIndex + 1));

    cards.forEach((card, idx) => {
      card.addEventListener("click", () => {
        if (idx !== currentIndex) {
          updateCarousel(idx);
        }
      });
    });

    dots.forEach((dot, idx) => {
      dot.addEventListener("click", () => updateCarousel(idx));
    });

    // Touch Swipe Gesture
    let touchStartX = 0;
    root.addEventListener("touchstart", (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    root.addEventListener("touchend", (e) => {
      const touchEndX = e.changedTouches[0].screenX;
      const diff = touchStartX - touchEndX;
      if (Math.abs(diff) > 40) {
        if (diff > 0) updateCarousel(currentIndex + 1);
        else updateCarousel(currentIndex - 1);
      }
    }, { passive: true });

    // Keyboard Navigation
    window.addEventListener("keydown", (e) => {
      const rect = root.getBoundingClientRect();
      const inView = rect.top < window.innerHeight && rect.bottom > 0;
      if (inView) {
        if (e.key === "ArrowLeft") updateCarousel(currentIndex - 1);
        if (e.key === "ArrowRight") updateCarousel(currentIndex + 1);
      }
    });

    window.addEventListener("resize", () => {
      updateCarousel(currentIndex);
    });

    // Initial positioning
    updateCarousel(0);
  }

  // Ensure execution regardless of DOM ready state
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupSymmetryCarousel);
  } else {
    setupSymmetryCarousel();
  }
</script>
