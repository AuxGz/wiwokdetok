---
import Container from "./Container.astro";
---

<footer class="bg-[#f8fafc] border-t border-slate-200 pt-20 pb-10 mt-auto">
  <Container>
    <div class="max-w-[1140px] mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-[1.4fr_1.6fr] gap-10 lg:gap-14 pb-14 border-b border-slate-200">
        <!-- Brand & Contact Section -->
        <div class="flex flex-col gap-6">
          <div class="flex items-center gap-3.5">
            <img src="/images/brand/logo-telkom-schools.png" alt="Logo SMK Telkom Purwokerto" class="w-9 h-9 object-contain" width="36" height="36" loading="lazy" decoding="async" />
            <div class="flex flex-col font-poppins font-extrabold leading-[1.15] text-lg text-[#111827]">
              <span>SMK Telkom Purwokerto</span>
            </div>
          </div>

          <div class="flex flex-col gap-4">
            <div class="flex items-start gap-3 font-jakarta text-sm text-[#4b5563] leading-normal">
              <svg class="shrink-0 mt-0.5" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ed1e28" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span>Jl. D.I. Panjaitan No. 128, Purwokerto Selatan, Banyumas, Jawa Tengah 53147</span>
            </div>

            <div class="flex items-start gap-3 font-jakarta text-sm text-[#4b5563] leading-normal">
              <svg class="shrink-0 mt-0.5" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ed1e28" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <span>0812-2970-1800</span>
            </div>

            <div class="flex items-start gap-3 font-jakarta text-sm text-[#4b5563] leading-normal">
              <svg class="shrink-0 mt-0.5" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ed1e28" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              <span>office@smktelkom-pwt.sch.id</span>
            </div>
          </div>

          <!-- Social Media Icons (Instagram, Facebook, YouTube, TikTok) -->
          <div class="flex gap-3 mt-2">
            <a href="https://www.instagram.com/smktelkompurwokerto/" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center w-[38px] h-[38px] rounded-full bg-[#ed1e28] hover:bg-[#dc1822] text-white hover:-translate-y-0.5 hover:shadow-[0_4px_12px_rgba(237,30,40,0.3)] transition-all duration-200" aria-label="Instagram SMK Telkom Purwokerto">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
            </a>
            <a href="https://www.facebook.com/smktelkompurwokerto/" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center w-[38px] h-[38px] rounded-full bg-[#ed1e28] hover:bg-[#dc1822] text-white hover:-translate-y-0.5 hover:shadow-[0_4px_12px_rgba(237,30,40,0.3)] transition-all duration-200" aria-label="Facebook SMK Telkom Purwokerto">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
              </svg>
            </a>
            <a href="https://www.youtube.com/@smktelkompurwokerto" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center w-[38px] h-[38px] rounded-full bg-[#ed1e28] hover:bg-[#dc1822] text-white hover:-translate-y-0.5 hover:shadow-[0_4px_12px_rgba(237,30,40,0.3)] transition-all duration-200" aria-label="YouTube SMK Telkom Purwokerto">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path>
                <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon>
              </svg>
            </a>
            <a href="https://www.tiktok.com/@smktelkompurwokerto" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center w-[38px] h-[38px] rounded-full bg-[#ed1e28] hover:bg-[#dc1822] text-white hover:-translate-y-0.5 hover:shadow-[0_4px_12px_rgba(237,30,40,0.3)] transition-all duration-200" aria-label="TikTok SMK Telkom Purwokerto">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.298-.002.595.042.88.13V9.4a6.33 6.33 0 0 0-1-.08A6.34 6.34 0 0 0 3 15.66a6.34 6.34 0 0 0 10.82 4.5 6.27 6.27 0 0 0 1.87-4.49V8.69a8.18 8.18 0 0 0 4.77 1.52V6.76c-.29-.01-.58-.03-.87-.07z" />
              </svg>
            </a>
          </div>

          <!-- Partner / Competition Logos -->
          <div class="pt-5 border-t border-slate-200/80 flex flex-col gap-3">
            <span class="font-jakarta text-[0.725rem] font-bold text-[#9ca3af] uppercase tracking-wider">
              Supported by
            </span>
            <div class="flex flex-col gap-3">
              <!-- Baris 1: Main Partners & Competition -->
              <div class="flex items-center gap-4 lg:gap-5 flex-wrap sm:flex-nowrap">
                <img
                  src="/images/partners/logo-jhic-2026.png"
                  alt="JHIC 2026"
                  class="h-9 w-auto object-contain shrink-0 transition-opacity duration-200 hover:opacity-80"
                  loading="lazy"
                  decoding="async"
                  width="61"
                  height="36"
                />
                <img
                  src="/images/partners/logo-jagoan-hosting.png"
                  alt="Jagoan Hosting"
                  class="h-7 w-auto object-contain shrink-0 transition-opacity duration-200 hover:opacity-80"
                  loading="lazy"
                  decoding="async"
                  width="95"
                  height="28"
                />
                <img
                  src="/images/partners/logo-komdigi.png"
                  alt="KOMDIGI"
                  class="h-8 w-auto object-contain shrink-0 transition-opacity duration-200 hover:opacity-80"
                  loading="lazy"
                  decoding="async"
                  width="46"
                  height="32"
                />
              </div>
              <!-- Baris 2: Ecosystem Partners -->
              <div class="flex items-center gap-4 lg:gap-5 flex-wrap sm:flex-nowrap">
                <img
                  src="/images/partners/logo-garuda-spark.png"
                  alt="Garuda Spark Innovation Hub"
                  class="h-8 w-auto object-contain shrink-0 transition-opacity duration-200 hover:opacity-80"
                  loading="lazy"
                  decoding="async"
                  width="59"
                  height="32"
                />
                <img
                  src="/images/partners/logo-ngalup.png"
                  alt="Ngalup.co"
                  class="h-[22px] w-auto object-contain shrink-0 transition-opacity duration-200 hover:opacity-80"
                  loading="lazy"
                  decoding="async"
                  width="139"
                  height="22"
                />
              </div>
            </div>
          </div>
        </div>

        <!-- Sitemap Columns -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[1fr_1fr_1.2fr] gap-8 sm:gap-10">
          <!-- Sekolah -->
          <div>
            <h4 class="font-jakarta text-base font-extrabold text-[#111827] mb-6 relative pb-2.5 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-7 after:h-[2.5px] after:bg-[#ed1e28] after:rounded-[1px]">Sekolah</h4>
            <ul class="list-none p-0 m-0 flex flex-col gap-3.5">
              <li><a href="/#about" class="font-jakarta text-sm text-[#4b5563] hover:text-[#ed1e28] hover:translate-x-0.5 transition-all duration-150 inline-block">Apa itu SMK Telkom Purwokerto</a></li>
              <li><a href="/#sambutan" class="font-jakarta text-sm text-[#4b5563] hover:text-[#ed1e28] hover:translate-x-0.5 transition-all duration-150 inline-block">Sambutan Kepala Sekolah</a></li>
              <li><a href="/#why-us" class="font-jakarta text-sm text-[#4b5563] hover:text-[#ed1e28] hover:translate-x-0.5 transition-all duration-150 inline-block">Mengapa Pilih Kami</a></li>
              <li><a href="/#kerjasama" class="font-jakarta text-sm text-[#4b5563] hover:text-[#ed1e28] hover:translate-x-0.5 transition-all duration-150 inline-block">Kerjasama Industri</a></li>
            </ul>
          </div>

          <!-- Informasi -->
          <div>
            <h4 class="font-jakarta text-base font-extrabold text-[#111827] mb-6 relative pb-2.5 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-7 after:h-[2.5px] after:bg-[#ed1e28] after:rounded-[1px]">Informasi</h4>
            <ul class="list-none p-0 m-0 flex flex-col gap-3.5">
              <li><a href="/#jurusan" class="font-jakarta text-sm text-[#4b5563] hover:text-[#ed1e28] hover:translate-x-0.5 transition-all duration-150 inline-block">Program Keahlian</a></li>
              <li><a href="/#berita" class="font-jakarta text-sm text-[#4b5563] hover:text-[#ed1e28] hover:translate-x-0.5 transition-all duration-150 inline-block">Berita Sekolah</a></li>
              <li><a href="/#faq" class="font-jakarta text-sm text-[#4b5563] hover:text-[#ed1e28] hover:translate-x-0.5 transition-all duration-150 inline-block">FAQ</a></li>
              <li><a href="/#ppdb" class="font-jakarta text-sm text-[#ed1e28] font-bold hover:translate-x-0.5 transition-all duration-150 inline-block">PPDB 2026</a></li>
              <li><a href="/profile-guru" class="font-jakarta text-sm text-[#4b5563] hover:text-[#ed1e28] hover:translate-x-0.5 transition-all duration-150 inline-block">Profile Guru</a></li>
              <li><a href="/profile-sekolah" class="font-jakarta text-sm text-[#4b5563] hover:text-[#ed1e28] hover:translate-x-0.5 transition-all duration-150 inline-block">Profile Sekolah</a></li>
              <li><a href="/#stats" class="font-jakarta text-sm text-[#4b5563] hover:text-[#ed1e28] hover:translate-x-0.5 transition-all duration-150 inline-block">Prestasi</a></li>
              <li><a href="/#about" class="font-jakarta text-sm text-[#4b5563] hover:text-[#ed1e28] hover:translate-x-0.5 transition-all duration-150 inline-block">Fasilitas</a></li>
            </ul>
          </div>

          <!-- Aplikasi -->
          <div>
            <h4 class="font-jakarta text-base font-extrabold text-[#111827] mb-6 relative pb-2.5 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-7 after:h-[2.5px] after:bg-[#ed1e28] after:rounded-[1px]">Aplikasi</h4>
            <div class="grid grid-cols-2 gap-6">
              <ul class="list-none p-0 m-0 flex flex-col gap-3.5">
                <li><a href="https://smktelkom-pwt.sch.id" target="_blank" rel="noopener noreferrer" class="font-jakarta text-sm text-[#4b5563] hover:text-[#ed1e28] hover:translate-x-0.5 transition-all duration-150 inline-block">MyLms</a></li>
                <li><a href="https://juara.smktelkom-pwt.sch.id" target="_blank" rel="noopener noreferrer" class="font-jakarta text-sm text-[#4b5563] hover:text-[#ed1e28] hover:translate-x-0.5 transition-all duration-150 inline-block">Juara</a></li>
                <li><a href="https://smktelkom-pwt.sch.id" target="_blank" rel="noopener noreferrer" class="font-jakarta text-sm text-[#4b5563] hover:text-[#ed1e28] hover:translate-x-0.5 transition-all duration-150 inline-block">Lions</a></li>
                <li><a href="https://smktelkom-pwt.sch.id" target="_blank" rel="noopener noreferrer" class="font-jakarta text-sm text-[#4b5563] hover:text-[#ed1e28] hover:translate-x-0.5 transition-all duration-150 inline-block">Aduan</a></li>
              </ul>
              <ul class="list-none p-0 m-0 flex flex-col gap-3.5">
                <li><a href="https://smktelkom-pwt.sch.id" target="_blank" rel="noopener noreferrer" class="font-jakarta text-sm text-[#4b5563] hover:text-[#ed1e28] hover:translate-x-0.5 transition-all duration-150 inline-block">Digits</a></li>
                <li><a href="https://smktelkom-pwt.sch.id" target="_blank" rel="noopener noreferrer" class="font-jakarta text-sm text-[#4b5563] hover:text-[#ed1e28] hover:translate-x-0.5 transition-all duration-150 inline-block">Bisa</a></li>
                <li><a href="https://starry.smktelkom-pwt.sch.id" target="_blank" rel="noopener noreferrer" class="font-jakarta text-sm text-[#4b5563] hover:text-[#ed1e28] hover:translate-x-0.5 transition-all duration-150 inline-block">Starry</a></li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom Bar -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between pt-8 gap-6 flex-wrap">
        <div class="flex items-center gap-2 font-jakarta text-[0.84375rem] text-slate-500">
          <strong class="font-bold text-[#111827]">SMK Telkom Purwokerto</strong>
          <span class="text-slate-400">•</span>
          <span>© 2026 Yayasan Pendidikan Telkom. All Rights Reserved.</span>
        </div>

        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 sm:gap-5 w-full sm:w-auto">
          <div class="flex flex-col text-left sm:text-right">
            <span class="font-jakarta text-[0.6875rem] font-extrabold text-slate-400 tracking-[0.06em]">ADA PERTANYAAN?</span>
            <span class="font-jakarta text-[0.84375rem] font-semibold text-slate-600">Chat WhatsApp Admin Sekarang</span>
          </div>
          <a href="https://wa.me/6281229701800" target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-2 bg-[#ed1e28] hover:bg-[#dc1822] text-white font-jakarta text-[0.84375rem] font-bold py-2.5 px-5.5 rounded-full shadow-[0_4px_12px_rgba(237,30,40,0.25)] hover:-translate-y-0.5 hover:shadow-[0_6px_16px_rgba(237,30,40,0.35)] transition-all duration-200">
            <span>Daftar PPDB</span>
            <span class="inline-block transition-transform duration-200 group-hover:translate-x-1">→</span>
          </a>
        </div>
      </div>
    </div>
  </Container>
</footer>
