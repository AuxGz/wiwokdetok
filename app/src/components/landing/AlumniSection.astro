---
import Container from "../Container.astro";

const alumniList = [
  {
    name: "PROF. DR. IR. MOH. KHAIRUDIN, M.T., PH.D.",
    role: "(Guru Besar Universitas Negeri Yogyakarta | Lulusan 1998)",
    quote: "Fondasi teknologi dan karakter yang saya dapatkan di SMK Telkom adalah pijakan awal kesuksesan. Kini saya bangga melihat almamater saya terus mencetak pemimpin masa depan.",
    image: "/images/alumni_khairudin.png",
    ringClass: "",
  },
  {
    name: "DR. TENIA WAHYUNINGRUM, S.KOM., M.T.",
    role: "(Direktur Telkom University Purwokerto | Lulusan 2001)",
    quote: "SMK Telkom Purwokerto adalah kawah candradimuka talenta digital. Lulusannya terbukti memiliki daya saing tinggi saat melanjutkan studi di Telkom University.",
    image: "/images/alumni_tenia.png",
    ringClass: "",
  },
  {
    name: "ALFA PUTRA KURNIA",
    role: "(Co-founder & CEO Arkademy.com | Alumni TKJ)",
    quote: "Menghadapi dunia bisnis butuh skill, knowledge, dan attitude. Semua fondasi adaptasi dunia kerja itu saya dapatkan lengkap di SMK Telkom Purwokerto.",
    image: "/images/alumni_alfa.png",
    ringClass: "avatar-blue-ring",
  },
];
---

<section class="alumni-section" id="alumni">
  <!-- Subtle Background Dot Grid Matrix matching Figma -->
  <svg class="alumni-bg-dots" viewBox="0 0 1440 600" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="alumni-dot-pat" x="0" y="0" width="28" height="28" patternUnits="userSpaceOnUse">
        <circle cx="14" cy="14" r="2" fill="#ed1e28" fill-opacity="0.12" />
      </pattern>
    </defs>
    <rect width="1440" height="600" fill="url(#alumni-dot-pat)" />
  </svg>

  <Container>
    <div class="alumni-inner">
      <!-- Section Header -->
      <div class="alumni-header">
        <div class="alumni-eyebrow">
          <span>Alumni</span> <span class="text-red">SMK Telkom Purwokerto</span>
        </div>
        <h2 class="alumni-title">Cerita Sukses Alumni</h2>
      </div>

      <!-- Carousel Wrap with Cards & Right Nav Button -->
      <div class="alumni-carousel-container">
        <div class="alumni-grid">
          {
            alumniList.map((item) => (
              <div class="alumni-card">
                <div class={`alumni-avatar-wrap ${item.ringClass}`}>
                  <img
                    src={item.image}
                    alt={item.name}
                    class="alumni-avatar-img"
                    width="76"
                    height="76"
                    loading="lazy"
                  />
                </div>

                <blockquote class="alumni-quote">
                  "{item.quote}"
                </blockquote>

                <div class="alumni-info">
                  <h3 class="alumni-name">{item.name}</h3>
                  <p class="alumni-role">{item.role}</p>
                </div>
              </div>
            ))
          }
        </div>

        <!-- Next Arrow Button -->
        <button type="button" class="carousel-next-btn" aria-label="Alumni Berikutnya">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>
  </Container>
</section>

<style>
  .alumni-section {
    position: relative;
    padding: 5rem 0 6rem 0;
    background-color: #ffffff;
    overflow: hidden;
  }

  .alumni-bg-dots {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  .alumni-inner {
    position: relative;
    z-index: 1;
    max-width: 1140px;
    margin-left: auto;
    margin-right: auto;
  }

  .alumni-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .alumni-eyebrow {
    font-family: var(--font-poppins);
    font-size: 1.15rem;
    font-weight: 700;
    color: #111827;
    margin-bottom: 0.35rem;
  }

  .text-red {
    color: #ed1e28;
  }

  .alumni-title {
    font-family: var(--font-poppins);
    font-size: 2.85rem;
    font-weight: 800;
    color: #ed1e28;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .alumni-carousel-container {
    position: relative;
    display: flex;
    align-items: center;
  }

  .alumni-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
    width: 100%;
  }

  .alumni-card {
    background-color: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 20px;
    padding: 2.75rem 2rem 2.25rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .alumni-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.08);
  }

  .alumni-avatar-wrap {
    width: 76px;
    height: 76px;
    border-radius: 50%;
    overflow: hidden;
    margin-bottom: 1.75rem;
    border: 3px solid #ffffff;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f1f5f9;
    flex-shrink: 0;
  }

  .avatar-blue-ring {
    border: 3px solid #0284c7;
    box-shadow: 0 4px 14px rgba(2, 132, 199, 0.25);
  }

  .alumni-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 50%;
  }

  .alumni-quote {
    font-family: var(--font-jakarta);
    font-size: 0.9375rem;
    line-height: 1.65;
    color: #4b5563;
    margin: 0 0 2rem 0;
    flex: 1;
  }

  .alumni-info {
    margin-top: auto;
  }

  .alumni-name {
    font-family: var(--font-jakarta);
    font-size: 0.875rem;
    font-weight: 800;
    color: #111827;
    margin-bottom: 0.25rem;
    letter-spacing: 0.02em;
    line-height: 1.3;
  }

  .alumni-role {
    font-family: var(--font-jakarta);
    font-size: 0.75rem;
    color: #64748b;
    margin: 0;
    line-height: 1.4;
  }

  /* Carousel Next Arrow */
  .carousel-next-btn {
    position: absolute;
    right: -24px;
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    color: #111827;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    cursor: pointer;
    transition: all 0.2s ease;
    z-index: 5;
  }

  .carousel-next-btn:hover {
    background-color: #ed1e28;
    color: #ffffff;
    border-color: #ed1e28;
    transform: translateY(-50%) scale(1.05);
  }

  @media (max-width: 992px) {
    .alumni-title {
      font-size: 2.25rem;
    }

    .alumni-grid {
      grid-template-columns: 1fr;
    }

    .carousel-next-btn {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .alumni-title {
      font-size: 1.85rem;
    }

    .alumni-card {
      padding: 2rem 1.5rem;
    }
  }
</style>
