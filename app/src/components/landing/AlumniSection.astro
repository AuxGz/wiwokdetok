---
import Container from "../Container.astro";

const defaultAlumniList = [
  {
    name: "PROF. DR. IR. MOH. KHAIRUDIN, M.T., PH.D.",
    role: "(Guru Besar Universitas Negeri Yogyakarta | Lulusan 1998)",
    quote: "Fondasi teknologi dan karakter yang saya dapatkan di SMK Telkom adalah pijakan awal kesuksesan. Kini saya bangga melihat almamater saya terus mencetak pemimpin masa depan.",
    image: "/images/alumni/alumni-khairudin.png",
    ringClass: "border-white shadow-[0_4px_14px_rgba(0,0,0,0.12)]",
  },
  {
    name: "DR. TENIA WAHYUNINGRUM, S.KOM., M.T.",
    role: "(Direktur Telkom University Purwokerto | Lulusan 2001)",
    quote: "SMK Telkom Purwokerto adalah kawah candradimuka talenta digital. Lulusannya terbukti memiliki daya saing tinggi saat melanjutkan studi di Telkom University.",
    image: "/images/alumni/alumni-tenia.png",
    ringClass: "border-white shadow-[0_4px_14px_rgba(0,0,0,0.12)]",
  },
  {
    name: "ALFA PUTRA KURNIA",
    role: "(Co-founder & CEO Arkademy.com | Alumni TKJ)",
    quote: "Menghadapi dunia bisnis butuh skill, knowledge, dan attitude. Semua fondasi adaptasi dunia kerja itu saya dapatkan lengkap di SMK Telkom Purwokerto.",
    image: "/images/alumni/alumni-alfa.png",
    ringClass: "border-white shadow-[0_4px_14px_rgba(0,0,0,0.12)]",
  },
  {
    name: "PRARIARGA MAOLANA B.",
    role: "(Manager PT PLN (Persero) ULP Purwokerto Kota | Alumni)",
    quote: "Menghadapi dunia bisnis dan perdagangan yang sangat kompleks dibutuhkan skill, knowledge, dan attitude. Semua bekal itu ada di SMK Telkom Purwokerto.",
    image: "/images/alumni/alumni-prariarga.png",
    ringClass: "border-white shadow-[0_4px_14px_rgba(0,0,0,0.12)]",
  },
];

let alumniList = defaultAlumniList;

try {
  const { prisma } = await import("../../server/lib/prisma.js");
  const dbAlumni = await prisma.alumniStory.findMany({
    orderBy: { order: "asc" },
  });

  if (dbAlumni && dbAlumni.length > 0) {
    alumniList = dbAlumni.map((a, idx) => ({
      name: a.name,
      role: a.role,
      quote: a.quote,
      image: a.imageUrl || defaultAlumniList[idx % defaultAlumniList.length]?.image || "/images/alumni/alumni-khairudin.png",
      ringClass: "border-white shadow-[0_4px_14px_rgba(0,0,0,0.12)]",
    }));
  }
} catch {
  // Gunakan data default jika database offline atau belum terisi
}
---

<section class="relative py-12 sm:py-16 lg:pt-20 lg:pb-24 bg-white overflow-hidden" id="alumni">
  <!-- Subtle Background Dot Grid Matrix matching Figma -->
  <svg class="absolute inset-0 w-full h-full pointer-events-none z-0" viewBox="0 0 1440 600" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="alumni-dot-pat" x="0" y="0" width="28" height="28" patternUnits="userSpaceOnUse">
        <circle cx="14" cy="14" r="2" fill="#ed1e28" fill-opacity="0.12" />
      </pattern>
    </defs>
    <rect width="1440" height="600" fill="url(#alumni-dot-pat)" />
  </svg>

  <Container>
    <div class="relative z-1 max-w-[1140px] mx-auto">
      <!-- Section Header -->
      <div class="text-center mb-10 sm:mb-14">
        <div class="font-poppins text-base sm:text-lg font-bold text-[#111827] mb-1.5">
          <span>Alumni</span> <span class="text-[#ed1e28]">SMK Telkom Purwokerto</span>
        </div>
        <h2 class="font-poppins text-3xl sm:text-[2.25rem] lg:text-[2.85rem] font-bold text-[#ed1e28] leading-[1.15] tracking-[-0.025em]">
          Cerita Sukses Alumni
        </h2>
      </div>

      <!-- Carousel Wrap with Cards & Left/Right Nav Buttons -->
      <div class="relative flex items-center">
        <!-- Prev Arrow Button (Left) -->
        <button
          type="button"
          class="carousel-prev-btn hidden lg:flex absolute -left-6 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-white border border-slate-200 text-[#111827] items-center justify-center shadow-[0_4px_16px_rgba(0,0,0,0.1)] cursor-pointer hover:bg-[#ed1e28] hover:text-white hover:border-[#ed1e28] hover:-translate-y-1/2 hover:scale-105 active:scale-95 transition-all duration-200 z-10 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#ed1e28]"
          aria-label="Alumni Sebelumnya"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <!-- Viewport (Clips off-screen slides while providing padding for card elevation/shadows) -->
        <div class="carousel-viewport overflow-hidden w-full py-4 -my-4 px-1 -mx-1">
          <div class="carousel-track flex gap-7 will-change-transform">
            {
              alumniList.map((item) => (
                <div class="alumni-card flex-none w-full md:w-[calc((100%-28px)/2)] lg:w-[calc((100%-56px)/3)] bg-white border border-black/[0.06] rounded-[20px] p-6 sm:p-8 lg:pt-11 lg:px-8 lg:pb-9 flex flex-col items-center text-center shadow-[0_10px_30px_rgba(0,0,0,0.04)] hover:-translate-y-1 hover:shadow-[0_16px_36px_rgba(0,0,0,0.08)] transition-all duration-250 select-none">
                  <div class={`w-[76px] h-[76px] aspect-square rounded-full overflow-hidden mb-7 border-[3px] flex items-center justify-center bg-slate-100 shrink-0 ${item.ringClass}`}>
                    <img
                      src={item.image}
                      alt={item.name}
                      class="w-full h-full object-cover block rounded-full pointer-events-none"
                      width="76"
                      height="76"
                      loading="lazy"
                      decoding="async"
                      draggable="false"
                    />
                  </div>

                  <blockquote class="font-jakarta text-[0.9375rem] leading-[1.65] text-[#4b5563] m-0 mb-8 flex-1">
                    "{item.quote}"
                  </blockquote>

                  <div class="mt-auto">
                    <h3 class="font-jakarta text-sm font-extrabold text-[#111827] mb-1 tracking-[0.02em] leading-[1.3]">{item.name}</h3>
                    <p class="font-jakarta text-xs text-[#64748b] m-0 leading-[1.4]">{item.role}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Next Arrow Button (Right) -->
        <button
          type="button"
          class="carousel-next-btn hidden lg:flex absolute -right-6 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-white border border-slate-200 text-[#111827] items-center justify-center shadow-[0_4px_16px_rgba(0,0,0,0.1)] cursor-pointer hover:bg-[#ed1e28] hover:text-white hover:border-[#ed1e28] hover:-translate-y-1/2 hover:scale-105 active:scale-95 transition-all duration-200 z-10 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#ed1e28]"
          aria-label="Alumni Berikutnya"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>

      <!-- Mobile Navigation Controls (< lg) -->
      <div class="flex lg:hidden justify-center items-center gap-4 mt-6">
        <button
          type="button"
          class="carousel-prev-btn-mobile w-11 h-11 rounded-full bg-white border border-slate-200 text-[#111827] flex items-center justify-center shadow-[0_4px_14px_rgba(0,0,0,0.08)] active:bg-[#ed1e28] active:text-white active:border-[#ed1e28] transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#ed1e28]"
          aria-label="Alumni Sebelumnya"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button
          type="button"
          class="carousel-next-btn-mobile w-11 h-11 rounded-full bg-white border border-slate-200 text-[#111827] flex items-center justify-center shadow-[0_4px_14px_rgba(0,0,0,0.08)] active:bg-[#ed1e28] active:text-white active:border-[#ed1e28] transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#ed1e28]"
          aria-label="Alumni Berikutnya"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>
  </Container>
</section>

<script>
  function initAlumniCarousel() {
    const track = document.querySelector(".carousel-track") as HTMLElement | null;
    const prevBtns = document.querySelectorAll(".carousel-prev-btn, .carousel-prev-btn-mobile");
    const nextBtns = document.querySelectorAll(".carousel-next-btn, .carousel-next-btn-mobile");
    if (!track) return;

    let isAnimating = false;
    const duration = 320;
    const ease = "cubic-bezier(0.23, 1, 0.32, 1)";

    function getStep(): number {
      const firstCard = track?.firstElementChild as HTMLElement | null;
      if (!firstCard || !track) return 389;
      const cardRect = firstCard.getBoundingClientRect();
      const style = window.getComputedStyle(track);
      const gap = parseFloat(style.columnGap || style.gap || "28") || 28;
      return cardRect.width + gap;
    }

    function slideNext() {
      if (isAnimating || !track || track.children.length <= 1) return;
      isAnimating = true;

      const step = getStep();
      const firstCard = track.firstElementChild as HTMLElement;
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (prefersReducedMotion) {
        track.appendChild(firstCard);
        isAnimating = false;
        return;
      }

      track.style.transition = `transform ${duration}ms ${ease}`;
      track.style.transform = `translateX(-${step}px)`;

      const onTransitionEnd = (e: TransitionEvent) => {
        if (e.target !== track || e.propertyName !== "transform") return;
        track.removeEventListener("transitionend", onTransitionEnd);
        track.style.transition = "none";
        track.appendChild(firstCard);
        track.style.transform = "translateX(0)";
        void track.offsetHeight;
        isAnimating = false;
      };

      track.addEventListener("transitionend", onTransitionEnd);

      setTimeout(() => {
        if (isAnimating) {
          track.removeEventListener("transitionend", onTransitionEnd);
          track.style.transition = "none";
          track.appendChild(firstCard);
          track.style.transform = "translateX(0)";
          void track.offsetHeight;
          isAnimating = false;
        }
      }, duration + 50);
    }

    function slidePrev() {
      if (isAnimating || !track || track.children.length <= 1) return;
      isAnimating = true;

      const step = getStep();
      const lastCard = track.lastElementChild as HTMLElement;
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (prefersReducedMotion) {
        track.insertBefore(lastCard, track.firstElementChild);
        isAnimating = false;
        return;
      }

      track.style.transition = "none";
      track.insertBefore(lastCard, track.firstElementChild);
      track.style.transform = `translateX(-${step}px)`;
      void track.offsetHeight;

      track.style.transition = `transform ${duration}ms ${ease}`;
      track.style.transform = "translateX(0)";

      const onTransitionEnd = (e: TransitionEvent) => {
        if (e.target !== track || e.propertyName !== "transform") return;
        track.removeEventListener("transitionend", onTransitionEnd);
        track.style.transition = "none";
        isAnimating = false;
      };

      track.addEventListener("transitionend", onTransitionEnd);

      setTimeout(() => {
        if (isAnimating) {
          track.removeEventListener("transitionend", onTransitionEnd);
          track.style.transition = "none";
          isAnimating = false;
        }
      }, duration + 50);
    }

    nextBtns.forEach((btn) => btn.addEventListener("click", slideNext));
    prevBtns.forEach((btn) => btn.addEventListener("click", slidePrev));

    let touchStartX = 0;
    let touchEndX = 0;

    track.addEventListener(
      "touchstart",
      (e: TouchEvent) => {
        touchStartX = e.changedTouches[0].screenX;
      },
      { passive: true }
    );

    track.addEventListener(
      "touchend",
      (e: TouchEvent) => {
        touchEndX = e.changedTouches[0].screenX;
        const diff = touchEndX - touchStartX;
        if (Math.abs(diff) > 40) {
          if (diff < 0) {
            slideNext();
          } else {
            slidePrev();
          }
        }
      },
      { passive: true }
    );
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAlumniCarousel);
  } else {
    initAlumniCarousel();
  }
</script>
