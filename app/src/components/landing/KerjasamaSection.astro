---
import Container from "../Container.astro";

const partners = [
  { name: "Dinkominfo Banyumas", logo: "/images/mitra/mitra-telkom.png", scale: 1.28 },
  { name: "Bank Jateng", logo: "/images/mitra/mitra-oracle.png", scale: 1.0 },
  { name: "PLN Indonesia Power", logo: "/images/mitra/mitra-pln.png", scale: 1.7 },
  { name: "nusantara.media", logo: "/images/mitra/mitra-cisco.png", scale: 0.88 },
  { name: "Telkom Indonesia", logo: "/images/mitra/mitra-mikrotik.png", scale: 1.3 },
  { name: "METRODATA", logo: "/images/mitra/mitra-redhat.png", scale: 1.35 },
  { name: "Dicoding", logo: "/images/mitra/mitra-aws.png", scale: 1.65 },
];
---

<section class="py-6 sm:py-7 bg-white border-y border-slate-100 overflow-hidden" id="kerjasama">
  <Container>
    <div class="flex items-center justify-between flex-wrap gap-5 max-w-[1140px] mx-auto mb-3.5">
      <div class="inline-flex items-center gap-3">
        <span class="inline-block w-[26px] h-[2.5px] bg-[#ed1e28] rounded-[1px]"></span>
        <span class="font-poppins text-sm sm:text-[0.9375rem] font-bold text-[#ed1e28] tracking-[0.08em] uppercase">KERJASAMA INDUSTRI</span>
        <span class="inline-block w-[26px] h-[2.5px] bg-[#ed1e28] rounded-[1px]"></span>
      </div>
      <p class="font-jakarta text-sm sm:text-base text-slate-600 m-0">
        182 mitra aktif untuk PKL, kelas industri, dan penyaluran kerja.
      </p>
    </div>
  </Container>

  <!-- Infinite Scrolling Marquee Track from Right to Left -->
  <div class="relative w-full overflow-hidden py-1.5 [mask-image:linear-gradient(to_right,transparent_0%,black_8%,black_92%,transparent_100%)] [-webkit-mask-image:linear-gradient(to_right,transparent_0%,black_8%,black_92%,transparent_100%)]" id="mitra-marquee">
    <div class="flex items-center gap-16 w-max animate-marquee will-change-transform" id="mitra-track">
      {
        [...partners, ...partners, ...partners, ...partners].map((partner, index) => (
          <div class="shrink-0 flex items-center justify-center w-[175px] h-[62px] px-2" data-index={index} title={partner.name}>
            <img
              src={partner.logo}
              alt={partner.name}
              class="max-w-[150px] max-h-[52px] w-auto h-auto object-contain block select-none pointer-events-none [transform-origin:center] drop-shadow-[0_1px_3px_rgba(0,0,0,0.04)]"
              style={`transform: scale(${partner.scale});`}
              loading="eager"
              decoding="async"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
