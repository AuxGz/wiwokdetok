---
// Chatbot floating widget for interactive support
---

<div class="fixed bottom-4 right-4 sm:bottom-8 sm:right-8 z-50" id="chatbot-widget">
  <!-- Popup Message Box -->
  <div class="chatbot-popup absolute bottom-[70px] right-0 w-[290px] sm:w-[330px] max-w-[calc(100vw-2rem)] bg-white border border-[#e7e8ea] rounded-2xl shadow-[0_8px_16px_rgba(85,86,91,0.12)] overflow-hidden [transform-origin:bottom_right]" id="chatbot-popup" hidden>
    <div class="bg-[#ed1e28] text-white py-4 px-5 flex items-center gap-3">
      <div class="w-9 h-9 rounded-full bg-white/20 flex items-center justify-center shrink-0">
        <img src="/images/brand/chatbot-avatar.png" alt="" width="22" height="20" />
      </div>
      <div>
        <strong class="block font-poppins text-sm font-bold leading-tight">Layanan Informasi Siswa</strong>
        <span class="text-[0.6875rem] text-[#fee2e2]">Online • Respons Cepat</span>
      </div>
      <button type="button" class="ml-auto text-white/80 hover:text-white p-1 cursor-pointer" id="close-chat" aria-label="Tutup Obrolan">
        <svg width="16" height="16" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="p-5 flex flex-col gap-4 bg-[#f8fafc]">
      <div class="bg-white border border-[#e7e8ea] rounded-xl rounded-tl-sm p-3.5 sm:px-4 text-sm text-[#2b2c31] leading-relaxed shadow-sm">
        Halo! 👋 Selamat datang di SMK Telkom Purwokerto. Ada yang bisa kami bantu mengenai informasi PPDB 2026 atau program keahlian?
      </div>
      <div class="flex flex-col gap-2">
        <a href="#ppdb" class="block bg-white border border-[#e7e8ea] rounded-md py-2 px-3.5 text-[0.8125rem] font-medium text-[#2b2c31] hover:border-[#ed1e28] hover:text-[#ed1e28] hover:bg-[#fef2f2] transition-colors duration-150">Informasi PPDB 2026</a>
        <a href="#jurusan" class="block bg-white border border-[#e7e8ea] rounded-md py-2 px-3.5 text-[0.8125rem] font-medium text-[#2b2c31] hover:border-[#ed1e28] hover:text-[#ed1e28] hover:bg-[#fef2f2] transition-colors duration-150">Pilihan Jurusan</a>
        <a href="https://wa.me/6281229701800" target="_blank" rel="noopener" class="flex items-center justify-between bg-[#22c55e] hover:bg-[#16a34a] text-white text-[0.8125rem] font-semibold py-2.5 px-3.5 rounded-md transition-colors duration-150">
          <span>Hubungi via WhatsApp</span>
          <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Trigger Button -->
  <button type="button" class="group relative w-14 h-14 rounded-full bg-[#ed1e28] hover:bg-[#dc2626] text-white flex items-center justify-center shadow-[0_8px_24px_rgba(237,30,40,0.4)] hover:scale-105 transition-all duration-200 cursor-pointer" id="open-chat" aria-label="Buka Chatbot Layanan Sekolah">
    <div class="absolute inset-0 rounded-full border-2 border-[#ed1e28] animate-ping opacity-75 pointer-events-none"></div>
    <img src="/images/brand/chatbot-avatar.png" alt="" class="w-9 h-auto block select-none pointer-events-none" width="36" height="33" />
  </button>
</div>

<script>
  const openBtn = document.getElementById("open-chat");
  const closeBtn = document.getElementById("close-chat");
  const popup = document.getElementById("chatbot-popup");

  function toggleChat(show?: boolean) {
    if (!popup || !openBtn) return;
    const isHidden = popup.hasAttribute("hidden");
    const nextState = show !== undefined ? show : isHidden;

    if (nextState) {
      popup.removeAttribute("hidden");
      openBtn.setAttribute("aria-expanded", "true");
    } else {
      popup.setAttribute("hidden", "");
      openBtn.setAttribute("aria-expanded", "false");
    }
  }

  if (openBtn && popup) {
    openBtn.setAttribute("aria-expanded", "false");
    openBtn.addEventListener("click", () => toggleChat());
  }

  if (closeBtn) {
    closeBtn.addEventListener("click", () => toggleChat(false));
  }

  document.addEventListener("keydown", (e: KeyboardEvent) => {
    if (e.key === "Escape" && popup && !popup.hasAttribute("hidden")) {
      toggleChat(false);
      openBtn?.focus();
    }
  });

  // Klik di luar menutup popup
  document.addEventListener("click", (e: MouseEvent) => {
    if (popup && !popup.hasAttribute("hidden")) {
      const widget = document.getElementById("chatbot-widget");
      if (widget && !widget.contains(e.target as Node)) {
        toggleChat(false);
      }
    }
  });
</script>
