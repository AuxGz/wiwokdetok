---
import Container from "../Container.astro";

let namaKepala = "Aris Puji Santoso, S.Kom., M.M";
let jabatanKepala = "Kepala SMK Telkom Purwokerto";
let paragraf1 = "Selamat datang di portal resmi SMK Telkom Purwokerto. Kami percaya pendidikan vokasi yang baik lahir dari kedekatan dengan dunia industri, sehingga setiap program keahlian dirancang bersama mitra kerja dan diuji langsung melalui praktik nyata.";
let paragraf2 = "Melalui portal ini, seluruh layanan sekolah kami satukan agar siswa, orang tua, dan mitra industri mendapatkan informasi yang sama dan selalu terbarui.";
let fotoKepala = "/images/guru/kepala-sekolah.png";

try {
  const { prisma } = await import("../../server/lib/prisma.js");
  const settings = await prisma.systemSetting.findMany({
    where: {
      key: {
        in: ["sambutan_kepala", "sambutan_jabatan", "sambutan_p1", "sambutan_p2", "sambutan_foto"],
      },
    },
  });

  if (settings && settings.length > 0) {
    for (const s of settings) {
      if (s.key === "sambutan_kepala" && s.value) namaKepala = s.value;
      if (s.key === "sambutan_jabatan" && s.value) jabatanKepala = s.value;
      if (s.key === "sambutan_p1" && s.value) paragraf1 = s.value;
      if (s.key === "sambutan_p2" && s.value) paragraf2 = s.value;
      if (s.key === "sambutan_foto" && s.value) fotoKepala = s.value;
    }
  }

  const principal = await prisma.teacherLeader.findFirst({
    where: {
      position: { contains: "Kepala Sekolah", mode: "insensitive" },
    },
  });
  if (principal) {
    if (!settings.some((s) => s.key === "sambutan_kepala")) namaKepala = principal.name;
    if (principal.imageUrl && !settings.some((s) => s.key === "sambutan_foto")) fotoKepala = principal.imageUrl;
  }
} catch {
  // Gunakan data default jika database offline atau belum terisi
}
---

<section class="py-12 sm:py-16 lg:pt-20 lg:pb-16 bg-[#f8f8f8] overflow-visible" id="sambutan">
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-[520px_1fr] gap-12 lg:gap-20 items-center max-w-[1140px] mx-auto">
      <!-- Foto Kepala Sekolah dengan Red Card di Belakang -->
      <div class="flex justify-center items-center relative h-auto lg:h-[580px]">
        <div class="relative w-[320px] sm:w-[440px] lg:w-[520px] h-[390px] sm:h-[500px] lg:h-[580px] flex justify-center items-end">
          <!-- Dashed Halo Arc behind head -->
          <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[240px] sm:w-[300px] lg:w-[360px] h-[240px] sm:h-[300px] lg:h-[360px] z-1 pointer-events-none flex items-center justify-center" aria-hidden="true">
            <div class="w-full h-full animate-sambutan-halo flex items-center justify-center">
              <svg class="w-full h-full animate-spin-slow" viewBox="0 0 360 360" fill="none">
                <circle cx="180" cy="180" r="176" stroke="#94a3b8" stroke-width="2" stroke-dasharray="10 10" />
              </svg>
            </div>
          </div>

          <!-- Red Shape with Large Rounded Corners & Watermark Rings -->
          <div class="absolute w-[310px] sm:w-[420px] lg:w-[500px] h-[270px] sm:h-[360px] lg:h-[420px] bg-gradient-to-br from-[#ed1e28] via-[#dc2626] to-[#dc2626] rounded-[80px_50px_80px_50px] sm:rounded-[110px_70px_110px_70px] lg:rounded-[140px_90px_140px_90px] left-1/2 bottom-0 -translate-x-1/2 z-2 overflow-hidden animate-sambutan-card" aria-hidden="true">
            <div class="absolute rounded-full border-[28px] border-white/8 pointer-events-none w-[220px] h-[220px] -left-[90px] top-1/2 -translate-y-1/2"></div>
            <div class="absolute rounded-full border-[28px] border-white/8 pointer-events-none w-[360px] h-[360px] -left-[160px] top-1/2 -translate-y-1/2"></div>
            <div class="absolute rounded-full border-[28px] border-white/8 pointer-events-none w-[220px] h-[220px] -right-[90px] top-1/2 -translate-y-1/2"></div>
            <div class="absolute rounded-full border-[28px] border-white/8 pointer-events-none w-[360px] h-[360px] -right-[160px] top-1/2 -translate-y-1/2"></div>
          </div>

          <!-- Foto Kepala Sekolah -->
          <img
            src={fotoKepala}
            alt={`Kepala SMK Telkom Purwokerto - ${namaKepala}`}
            class="absolute z-3 w-[285px] sm:w-[365px] lg:w-[440px] max-w-none h-auto left-1/2 -translate-x-1/2 bottom-0 drop-shadow-[0_20px_36px_rgba(0,0,0,0.16)] pointer-events-none animate-sambutan-photo"
            width="530"
            height="796"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>

      <!-- Sambutan Copy -->
      <div class="flex flex-col pb-2">
        <div class="inline-flex items-center gap-2.5 font-poppins text-[0.8125rem] font-bold text-[#ed1e28] tracking-[0.06em] uppercase mb-5 animate-sambutan-eyebrow">
          <span class="inline-block w-[22px] h-[2px] bg-[#ed1e28] rounded-[1px]"></span>
          <span>SAMBUTAN</span>
        </div>

        <h2 class="font-poppins text-3xl sm:text-[2.15rem] lg:text-[2.25rem] font-bold leading-[1.2] text-[#111827] tracking-[-0.025em] mb-6 animate-sambutan-heading">
          <span class="text-[#ed1e28]">Sambutan</span> Kepala Sekolah
        </h2>

        <div class="animate-sambutan-text">
          <p class="font-jakarta text-[0.9375rem] leading-[1.7] text-gray-700 mb-5">
            {paragraf1}
          </p>

          <p class="font-jakarta text-[0.9375rem] leading-[1.7] text-gray-700 mb-7">
            {paragraf2}
          </p>
        </div>

        <div class="border-t border-gray-200 pt-5 animate-sambutan-profile">
          <h3 class="font-jakarta text-[1.0625rem] font-extrabold text-[#111827] mb-1">{namaKepala}</h3>
          <p class="font-jakarta text-sm text-gray-500 m-0">{jabatanKepala}</p>
        </div>
      </div>
    </div>
  </Container>
</section>
