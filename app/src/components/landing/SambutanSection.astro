---
import Container from "../Container.astro";
---

<section class="sambutan-section" id="sambutan">
  <Container>
    <div class="sambutan-grid">
      <!-- Foto Kepala Sekolah dengan Red Card di Belakang -->
      <div class="principal-visual">
        <div class="photo-frame-wrapper">
          <!-- Dashed Halo Arc behind head -->
          <div class="dashed-halo-arc" aria-hidden="true">
            <svg width="270" height="270" viewBox="0 0 270 270" fill="none">
              <circle cx="135" cy="135" r="133" stroke="#94a3b8" stroke-width="2" stroke-dasharray="7 7" />
            </svg>
          </div>

          <!-- Red Shape with Large Rounded Corners & Watermark Rings -->
          <div class="red-bg-card" aria-hidden="true">
            <div class="card-ring ring-left-1"></div>
            <div class="card-ring ring-left-2"></div>
            <div class="card-ring ring-right-1"></div>
            <div class="card-ring ring-right-2"></div>
          </div>

          <!-- Foto Kepala Sekolah -->
          <img
            src="/images/kepalaSekolah.png"
            alt="Kepala SMK Telkom Purwokerto - Aris Puji Santoso, S.Kom., M.M"
            class="principal-photo-img"
            width="530"
            height="796"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>

      <!-- Sambutan Copy -->
      <div class="sambutan-content">
        <div class="section-tagline">
          <span class="tagline-dash"></span>
          <span>SAMBUTAN</span>
        </div>

        <h2 class="sambutan-title">
          <span class="text-red">Sambutan</span> Kepala Sekolah
        </h2>

        <p class="sambutan-desc">
          Selamat datang di portal resmi SMK Telkom Purwokerto. Kami percaya pendidikan vokasi yang baik lahir dari kedekatan dengan dunia industri — karena itu setiap program keahlian dirancang bersama mitra kerja dan diuji langsung melalui praktik nyata.
        </p>

        <p class="sambutan-desc">
          Melalui portal ini, seluruh layanan sekolah kami satukan agar siswa, orang tua, dan mitra industri mendapatkan informasi yang sama dan selalu terbarui.
        </p>

        <div class="principal-signoff">
          <h3 class="principal-name">Aris Puji Santoso, S.Kom., M.M</h3>
          <p class="principal-role">Kepala SMK Telkom Purwokerto</p>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  .sambutan-section {
    padding: 4.5rem 0 3.5rem 0;
    background-color: #ffffff;
    overflow: visible;
  }

  .sambutan-grid {
    display: grid;
    grid-template-columns: 390px 1fr;
    gap: 3.5rem;
    align-items: flex-end;
    max-width: 1080px;
    margin-left: auto;
    margin-right: auto;
  }

  .principal-visual {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    position: relative;
    height: 440px;
  }

  .photo-frame-wrapper {
    position: relative;
    width: 390px;
    height: 440px;
    display: flex;
    justify-content: center;
    align-items: flex-end;
  }

  .dashed-halo-arc {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 270px;
    height: 270px;
    z-index: 1;
    pointer-events: none;
  }

  .red-bg-card {
    position: absolute;
    width: 390px;
    height: 330px;
    background-color: #ed1e28;
    border-radius: 84px;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    z-index: 2;
    overflow: hidden;
  }

  .card-ring {
    position: absolute;
    border-radius: 50%;
    border: 24px solid rgba(255, 255, 255, 0.08);
    pointer-events: none;
  }

  .ring-left-1 {
    width: 180px;
    height: 180px;
    left: -70px;
    top: 50%;
    transform: translateY(-50%);
  }

  .ring-left-2 {
    width: 290px;
    height: 290px;
    left: -130px;
    top: 50%;
    transform: translateY(-50%);
  }

  .ring-right-1 {
    width: 180px;
    height: 180px;
    right: -70px;
    top: 50%;
    transform: translateY(-50%);
  }

  .ring-right-2 {
    width: 290px;
    height: 290px;
    right: -130px;
    top: 50%;
    transform: translateY(-50%);
  }

  .principal-photo-img {
    position: absolute;
    z-index: 3;
    width: 335px;
    max-width: none;
    height: auto;
    left: 50%;
    transform: translateX(-50%);
    bottom: 0;
    filter: drop-shadow(0 20px 36px rgba(0, 0, 0, 0.16));
    transition: transform 0.25s ease;
  }

  .principal-photo-img:hover {
    transform: translateX(-50%) translateY(-4px);
  }

  .sambutan-content {
    display: flex;
    flex-direction: column;
    padding-bottom: 0.5rem;
  }

  .section-tagline {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-family: var(--font-poppins);
    font-size: 0.8125rem;
    font-weight: 700;
    color: #ed1e28;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  .tagline-dash {
    display: inline-block;
    width: 22px;
    height: 2px;
    background-color: #ed1e28;
    border-radius: 1px;
  }

  .sambutan-title {
    font-family: var(--font-poppins);
    font-size: 2.15rem;
    white-space: nowrap;
    font-weight: 800;
    line-height: 1.2;
    color: #111827;
    letter-spacing: -0.025em;
    margin-bottom: 1.35rem;
  }

  .text-red {
    color: #ed1e28;
  }

  .sambutan-desc {
    font-family: var(--font-jakarta);
    font-size: 0.9375rem;
    line-height: 1.7;
    color: #4b5563;
    margin-bottom: 1.25rem;
  }

  .sambutan-desc:last-of-type {
    margin-bottom: 1.75rem;
  }

  .principal-signoff {
    border-top: 1px solid #f3f4f6;
    padding-top: 1.25rem;
  }

  .principal-name {
    font-family: var(--font-jakarta);
    font-size: 1.0625rem;
    font-weight: 800;
    color: #111827;
    margin-bottom: 0.25rem;
  }

  .principal-role {
    font-family: var(--font-jakarta);
    font-size: 0.875rem;
    color: #6b7280;
    margin: 0;
  }

  @media (max-width: 992px) {
    .sambutan-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
      align-items: center;
    }

    .principal-visual {
      align-items: center;
      height: auto;
    }

    .sambutan-title {
      font-size: 2.15rem;
      white-space: normal;
    }

    .photo-frame-wrapper {
      max-width: 360px;
      height: 420px;
    }

    .dashed-halo-arc {
      width: 260px;
      height: 260px;
      top: 10px;
    }

    .dashed-halo-arc svg {
      width: 260px;
      height: 260px;
    }

    .red-bg-card {
      width: 340px;
      height: 290px;
      border-radius: 72px;
    }

    .principal-photo-img {
      width: 300px;
      bottom: 12px;
    }
  }

  @media (max-width: 640px) {
    .sambutan-section {
      padding: 3rem 0;
    }

    .sambutan-title {
      font-size: 1.85rem;
    }

    .photo-frame-wrapper {
      max-width: 310px;
      height: 360px;
    }

    .red-bg-card {
      width: 290px;
      height: 250px;
      border-radius: 60px;
    }

    .principal-photo-img {
      width: 260px;
      bottom: 10px;
    }

    .dashed-halo-arc {
      width: 220px;
      height: 220px;
      top: 5px;
    }

    .dashed-halo-arc svg {
      width: 220px;
      height: 220px;
    }
  }
</style>
