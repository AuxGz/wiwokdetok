---
import Container from "../Container.astro";

const majorsData = [
  {
    code: "PG",
    titleRed: "Pengembangan",
    titleDark: "Game",
    desc: "Program yang mempelajari perancangan, pembuatan, dan pengembangan video game interaktif untuk berbagai platform (PC, konsol, mobile).",
    studentImg: "/images/jurusan/siswa-vr.png",
    pillars: [
      {
        title: "Game Programming & Engine",
        desc: "Membangun logika permainan, kecerdasan buatan (AI) musuh, dan mekanik menggunakan game engine standar industri seperti Unity atau Unreal Engine.",
        icon: "cog",
      },
      {
        title: "2D/3D Game Art & Assets",
        desc: "Merancang dan memproduksi aset visual, mulai dari karakter, lingkungan, objek, hingga animasi dalam format 2D maupun 3D.",
        icon: "box",
      },
      {
        title: "Game Design & Mechanics",
        desc: "Merancang alur cerita, aturan gameplay, tingkat kesulitan (level design), dan antarmuka pemain (UI/UX) agar permainan interaktif dan menyenangkan.",
        icon: "puzzle",
      },
    ],
    careers: "Game Developer, Game Programmer, Game Designer, 2D/3D Artist, Technical Artist, dan Game QA Tester.",
  },
  {
    code: "RPL",
    titleRed: "Rekayasa",
    titleDark: "Perangkat Lunak",
    desc: "Program yang mempelajari pemrograman, basis data, dan rekayasa aplikasi web maupun mobile dengan alur kerja industri.",
    studentImg: "/images/jurusan/siswa-pplg.png",
    pillars: [
      {
        title: "Software Development",
        desc: "Membangun aplikasi web dan mobile yang fungsional, dari perancangan sampai rilis.",
        icon: "laptop",
      },
      {
        title: "Database & Back-end",
        desc: "Merancang basis data, REST API, dan integrasi layanan dengan Laravel serta MySQL.",
        icon: "database",
      },
      {
        title: "UI/UX & Quality",
        desc: "Merancang antarmuka dan menguji kelayakan aplikasi sebelum diserahkan ke pengguna.",
        icon: "layers",
      },
    ],
    careers: "Software Engineer, Web Developer, Mobile App Developer, Database Administrator, QA Engineer, System Analyst.",
  },
  {
    code: "TKJ",
    titleRed: "Teknik Komputer",
    titleDark: "Jaringan",
    desc: "Program keahlian yang berfokus pada perakitan keras komputer, instalasi sistem operasi, serta perancangan, administrasi, dan keamanan infrastruktur jaringan.",
    studentImg: "/images/jurusan/siswa-game.png",
    pillars: [
      {
        title: "Network Infrastructure & Design",
        desc: "Merancang, membangun, dan mengonfigurasi topologi jaringan (LAN/WAN/WLAN) menggunakan perangkat standar industri seperti router, switch, dan MikroTik.",
        icon: "server",
      },
      {
        title: "System & Server Admin",
        desc: "Mengonfigurasi dan memelihara sistem operasi jaringan serta pengelolaan layanan server terpusat.",
        icon: "database",
      },
      {
        title: "Cyber Security & Troubleshooting",
        desc: "Mengamankan lalu lintas data jaringan dari ancaman siber dan menangani perbaikan infrastruktur keras/lunak.",
        icon: "shield",
      },
    ],
    careers: "Network Engineer, Network Administrator, System Administrator, IT Support/Helpdesk, dan Teknisi Komputer/Jaringan.",
  },
  {
    code: "TJA",
    titleRed: "Teknik Jaringan",
    titleDark: "Akses",
    desc: "Program keahlian yang berfokus pada teknologi telekomunikasi, meliputi instalasi jaringan kabel fiber optik (FTTH), sistem transmisi radio, hingga infrastruktur komunikasi nirkabel dan seluler.",
    studentImg: "/images/jurusan/siswa-tjkt.png",
    pillars: [
      {
        title: "Fiber Optic & Broadband Network",
        desc: "Mempelajari teknik instalasi, penyambungan kabel (splicing), dan pengukuran kualitas jaringan fiber optik untuk layanan internet rumah (FTTH).",
        icon: "wifi",
      },
      {
        title: "Wireless & Cellular Technology",
        desc: "Memahami sistem komunikasi radio, gelombang microwave, dan teknologi seluler termasuk perangkat pada menara telekomunikasi (BTS).",
        icon: "antenna",
      },
      {
        title: "Telecommunication Infrastructure",
        desc: "Melakukan perancangan, pemeliharaan (maintenance), dan perbaikan (troubleshooting) pada perangkat akses pelanggan dan sentral telekomunikasi.",
        icon: "server",
      },
    ],
    careers: "Teknisi Fiber Optik (Splicer), Teknisi Instalasi (Installer), Drive Tester, Rigger (Teknisi Menara BTS), dan Network Access Engineer.",
  },
];

const studentPositionMap: Record<string, string> = {
  PG: "h-[370px] sm:h-[450px] lg:h-[540px] left-[calc(50%+16px)] sm:left-[calc(50%+20px)] lg:left-[calc(50%+25px)] -translate-x-1/2 bottom-0",
  RPL: "h-[370px] sm:h-[450px] lg:h-[540px] left-[calc(50%-8px)] sm:left-[calc(50%-10px)] lg:left-[calc(50%-12px)] -translate-x-1/2 bottom-[-2px]",
  TKJ: "h-[395px] sm:h-[480px] lg:h-[570px] left-[calc(50%-7px)] sm:left-[calc(50%-8px)] lg:left-[calc(50%-10px)] -translate-x-1/2 bottom-0",
  TJA: "h-[400px] sm:h-[485px] lg:h-[575px] left-[calc(50%+5px)] sm:left-[calc(50%+6px)] lg:left-[calc(50%+8px)] -translate-x-1/2 bottom-0",
};
---

<section class="relative py-12 sm:py-16 lg:pt-18 lg:pb-24 bg-white overflow-hidden" id="jurusan">
  <Container>
    <div class="relative z-1 max-w-[1200px] mx-auto">
      <!-- Section Header -->
      <div class="text-center mb-9">
        <div class="inline-flex items-center gap-2.5 mb-3.5">
          <span class="inline-block w-[22px] h-[2px] bg-[#ed1e28] rounded-[1px]"></span>
          <span class="font-poppins text-[0.8125rem] font-bold text-[#ed1e28] tracking-[0.08em] uppercase">PROGRAM KEAHLIAN</span>
          <span class="inline-block w-[22px] h-[2px] bg-[#ed1e28] rounded-[1px]"></span>
        </div>
        <h2 class="font-poppins text-3xl sm:text-[2.15rem] lg:text-[2.75rem] font-bold leading-[1.15] text-[#111827] tracking-[-0.025em]">
          Pilih jurusan di SMK Telkom<br />Purwokerto
        </h2>
      </div>

      <!-- Tab Switcher Bar -->
      <div class="flex justify-center mb-10 sm:mb-14">
        <div class="relative inline-flex items-center bg-[#f8fafc] border border-slate-200 rounded-full p-1 sm:p-1.5 gap-1 sm:gap-1.5 shadow-[0_2px_10px_rgba(0,0,0,0.03)]" role="tablist">
          <span class="tab-indicator absolute top-1 sm:top-1.5 left-0 h-[calc(100%-0.5rem)] sm:h-[calc(100%-0.75rem)] bg-gradient-to-br from-[#ed1e28] to-[#dc2626] rounded-full shadow-[0_4px_14px_rgba(237,30,40,0.32)] pointer-events-none z-1 will-change-transform" id="tabIndicator" aria-hidden="true"></span>
          {
            majorsData.map((m, idx) => (
              <button
                type="button"
                role="tab"
                class={`tab-btn relative z-2 inline-flex items-center gap-1.5 sm:gap-2 py-2 sm:py-2.5 px-3.5 sm:px-6 rounded-full bg-transparent border-0 text-[#475569] [&.active]:text-white font-jakarta text-[0.8125rem] sm:text-sm font-bold cursor-pointer transition-colors duration-250 outline-none select-none ${idx === 0 ? "active" : ""}`}
                data-major-code={m.code}
                id={`tab-${m.code}`}
                aria-selected={idx === 0 ? "true" : "false"}
              >
                {m.code === "PG" && (
                  <svg class="w-3.5 h-3.5 sm:w-[18px] sm:h-[18px] transition-transform duration-250" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                    <polyline points="2 17 12 22 22 17"></polyline>
                    <polyline points="2 12 12 17 22 12"></polyline>
                  </svg>
                )}
                {m.code === "RPL" && (
                  <svg class="w-3.5 h-3.5 sm:w-[18px] sm:h-[18px] transition-transform duration-250" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="16 18 22 12 16 6"></polyline>
                    <polyline points="8 6 2 12 8 18"></polyline>
                  </svg>
                )}
                {m.code === "TKJ" && (
                  <svg class="w-3.5 h-3.5 sm:w-[18px] sm:h-[18px] transition-transform duration-250" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
                    <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
                    <line x1="6" y1="6" x2="6.01" y2="6"></line>
                    <line x1="6" y1="18" x2="6.01" y2="18"></line>
                  </svg>
                )}
                {m.code === "TJA" && (
                  <svg class="w-3.5 h-3.5 sm:w-[18px] sm:h-[18px] transition-transform duration-250" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="2"></circle>
                    <path d="M16.24 7.76a6 6 0 0 1 0 8.49m-8.48-.01a6 6 0 0 1 0-8.49"></path>
                  </svg>
                )}
                <span>{m.code}</span>
              </button>
            ))
          }
        </div>
      </div>

      <!-- Major Content Panels -->
      <div>
        {
          majorsData.map((m, idx) => (
            <div
              class={`major-panel hidden [&.active]:grid grid-cols-1 lg:grid-cols-[1fr_1.15fr] gap-12 lg:gap-[4.5rem] items-center ${idx === 0 ? "active" : ""}`}
              id={`panel-${m.code}`}
              role="tabpanel"
              aria-labelledby={`tab-${m.code}`}
            >
              <!-- Left Visual: Photo with Authentic Red Organic Backdrop -->
              <div class="animate-major-visual will-change-transform flex justify-center items-center">
                <div class="relative w-full max-w-[300px] sm:max-w-[360px] lg:max-w-[440px] flex justify-center items-end h-[420px] sm:h-[500px] lg:h-[580px]">
                  <!-- Red Backdrop Card matching Figma -->
                  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[265px] sm:w-[320px] lg:w-[380px] h-[275px] sm:h-[330px] lg:h-[390px] bg-gradient-to-br from-[#ed1e28] via-[#dc2626] to-[#c41d24] rounded-[42px] sm:rounded-[50px] lg:rounded-[60px] overflow-hidden pointer-events-none z-1" aria-hidden="true">
                    <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 330 340" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="165" cy="170" r="85" stroke="rgba(255, 255, 255, 0.08)" stroke-width="24" />
                      <circle cx="165" cy="170" r="145" stroke="rgba(255, 255, 255, 0.07)" stroke-width="24" />
                      <circle cx="165" cy="170" r="205" stroke="rgba(255, 255, 255, 0.05)" stroke-width="24" />
                    </svg>
                  </div>

                  <!-- Student Cutout Image -->
                  <img
                    src={m.studentImg}
                    alt={`Siswa Jurusan ${m.code}`}
                    class={`absolute z-2 w-auto object-contain object-bottom block ${studentPositionMap[m.code]}`}
                    width="478"
                    height="660"
                    loading="eager"
                    decoding="async"
                  />
                </div>
              </div>

              <!-- Right Details: Copy & Pillars -->
              <div class="flex flex-col">
                <h3 class="animate-major-heading will-change-transform font-poppins text-3xl sm:text-[2.15rem] lg:text-[2.5rem] font-bold leading-[1.15] text-[#111827] tracking-[-0.025em] mb-4.5">
                  <span class="text-[#ed1e28]">{m.titleRed}</span> {m.titleDark}
                </h3>

                <p class="animate-major-desc will-change-transform font-jakarta text-[0.9375rem] leading-[1.7] text-[#4b5563] mb-7">{m.desc}</p>

                <!-- Pillars -->
                <div class="animate-major-pillars will-change-transform flex flex-col gap-5 mb-7">
                  {m.pillars.map((pillar) => (
                    <div class="flex items-start gap-4">
                      <div class="w-10 h-10 rounded-[10px] bg-[#fef2f2] flex items-center justify-center shrink-0 mt-0.5">
                        {pillar.icon === "cog" && (
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ed1e28" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="3"></circle>
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                          </svg>
