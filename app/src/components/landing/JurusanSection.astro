                        {pillar.icon === "puzzle" && (
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="#ed1e28" stroke="#ed1e28" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19.439 7.85c0-1.571-1.274-2.85-2.844-2.85H15a1 1 0 0 1-1-1V2.561C14 1.146 12.854 0 11.439 0c-1.414 0-2.56 1.146-2.56 2.561V4a1 1 0 0 1-1 1H6.44c-1.57 0-2.845 1.279-2.845 2.85V9.3c0 .553.448 1 1 1h1.44a2.56 2.56 0 0 1 0 5.12H4.595a1 1 0 0 0-1 1v1.445c0 1.57 1.275 2.845 2.845 2.845H9a1 1 0 0 1 1 1v1.439c0 1.415 1.146 2.561 2.561 2.561 1.415 0 2.561-1.146 2.561-2.561V22a1 1 0 0 1 1-1h1.439c1.57 0 2.845-1.275 2.845-2.845v-1.445a1 1 0 0 1 1-1 2.56 2.56 0 0 0 0-5.12 1 1 0 0 1-1-1V7.85z"></path>
                          </svg>
                        )}
                        {pillar.icon === "gamepad" && (
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ed1e28" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="6" width="20" height="12" rx="2"></rect>
                            <line x1="6" y1="12" x2="10" y2="12"></line>
                            <line x1="8" y1="10" x2="8" y2="14"></line>
                            <line x1="15" y1="13" x2="15.01" y2="13"></line>
                            <line x1="18" y1="11" x2="18.01" y2="11"></line>
                          </svg>
                        )}
                        {pillar.icon === "laptop" && (
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ed1e28" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                            <line x1="2" y1="20" x2="22" y2="20"></line>
                          </svg>
                        )}
                        {pillar.icon === "database" && (
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ed1e28" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                            <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                            <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
                          </svg>
                        )}
                        {pillar.icon === "layers" && (
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ed1e28" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                            <polyline points="2 17 12 22 22 17"></polyline>
                            <polyline points="2 12 12 17 22 12"></polyline>
                          </svg>
                        )}
                        {pillar.icon === "server" && (
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ed1e28" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
                            <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
                            <line x1="6" y1="6" x2="6.01" y2="6"></line>
                            <line x1="6" y1="18" x2="6.01" y2="18"></line>
                          </svg>
                        )}
                        {pillar.icon === "shield" && (
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ed1e28" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                          </svg>
                        )}
                        {pillar.icon === "wifi" && (
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ed1e28" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M5 12.55a11 11 0 0 1 14.08 0"></path>
                            <path d="M1.42 9a16 16 0 0 1 21.16 0"></path>
                            <path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path>
                            <line x1="12" y1="20" x2="12.01" y2="20"></line>
                          </svg>
