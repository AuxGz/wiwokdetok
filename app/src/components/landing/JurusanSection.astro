                      </div>
                      <div class="flex flex-col">
                        <h4 class="font-jakarta text-[0.9375rem] font-extrabold text-[#111827] mb-1">{pillar.title}</h4>
                        <p class="font-jakarta text-[0.84375rem] leading-[1.6] text-[#64748b] m-0">{pillar.desc}</p>
                      </div>
                    </div>
                  ))}
                </div>

                <!-- Career Section & Action Button -->
                <div class="animate-major-footer will-change-transform">
                  <div class="mb-8">
                    <span class="block font-jakarta text-sm font-bold text-[#ed1e28] mb-1">Prospek Kerja:</span>
                    <p class="font-jakarta text-sm leading-[1.6] text-[#4b5563] m-0">{m.careers}</p>
                  </div>

                  <a href="#ppdb" class="group inline-flex items-center gap-2 bg-[#ed1e28] text-white font-jakarta text-sm font-bold py-3 px-7 rounded-full shadow-[0_4px_14px_rgba(237,30,40,0.3)] self-start hover:bg-[#dc1822] hover:-translate-y-0.5 hover:shadow-[0_6px_18px_rgba(237,30,40,0.4)] transition-all duration-200">
                    <span>Pelajari lebih lanjut</span>
                    <span class="transition-transform duration-200 group-hover:translate-x-1">→</span>
                  </a>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </Container>
</section>

<script>
  function initMajorTabs() {
    const tabButtons = document.querySelectorAll(".tab-btn");
    const panels = document.querySelectorAll(".major-panel");
    const indicator = document.getElementById("tabIndicator");

    function updateIndicator(btn: Element | null, animate = true) {
      if (!indicator || !btn) return;
      const bar = btn.parentElement;
      if (!bar) return;

      const barRect = bar.getBoundingClientRect();
      const btnRect = btn.getBoundingClientRect();
      const x = btnRect.left - barRect.left;
      const width = btnRect.width;

      if (!animate) {
        indicator.style.transition = "none";
      } else {
        indicator.style.transition = "transform 0.32s cubic-bezier(0.2, 0, 0, 1), width 0.32s cubic-bezier(0.2, 0, 0, 1)";
      }

      indicator.style.transform = `translateX(${x}px)`;
      indicator.style.width = `${width}px`;
    }

    const activeBtn = document.querySelector(".tab-btn.active");
    if (activeBtn) {
      requestAnimationFrame(() => updateIndicator(activeBtn, false));
    }

    tabButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        if (btn.classList.contains("active")) return;
        const targetCode = btn.getAttribute("data-major-code");
        if (!targetCode) return;

        // Deactivate all tabs & panels
        tabButtons.forEach((b) => {
          b.classList.remove("active");
          b.setAttribute("aria-selected", "false");
        });
        panels.forEach((p) => p.classList.remove("active"));

        // Activate selected tab & panel
        btn.classList.add("active");
        btn.setAttribute("aria-selected", "true");
        updateIndicator(btn, true);

        const activePanel = document.getElementById(`panel-${targetCode}`);
        if (activePanel) {
          const animElements = activePanel.querySelectorAll(
            ".animate-major-visual, .animate-major-heading, .animate-major-desc, .animate-major-pillars, .animate-major-footer"
          );
          animElements.forEach((el) => {
            (el as HTMLElement).style.animation = "none";
            void (el as HTMLElement).offsetHeight;
            (el as HTMLElement).style.animation = "";
          });
          activePanel.classList.add("active");
        }
      });
    });

    window.addEventListener("resize", () => {
      const curActive = document.querySelector(".tab-btn.active");
      if (curActive) {
        updateIndicator(curActive, false);
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMajorTabs);
  } else {
    initMajorTabs();
  }
</script>
