---
import Container from "../Container.astro";
---

<section class="py-14 sm:py-20 lg:pt-22 lg:pb-20 bg-white overflow-hidden" id="why-us">
  <Container>
    <div class="max-w-[1140px] mx-auto">
      <!-- Section Header: Slide from Top -->
      <div class="why-us-header why-us-item slide-from-top delay-header">
        <div class="inline-flex items-center gap-2.5 font-poppins text-[0.8125rem] font-bold text-[#ed1e28] tracking-[0.06em] uppercase mb-5">
          <span class="inline-block w-[22px] h-[2px] bg-[#ed1e28] rounded-[1px]"></span>
          <span>MENGAPA MEMILIH KAMI</span>
        </div>

        <h2 class="font-poppins text-3xl sm:text-4xl lg:text-[2.75rem] font-bold leading-[1.15] text-[#111827] tracking-[-0.025em] mb-8 sm:mb-12">
          Mengapa <span class="text-[#ed1e28]">SMK Telkom Purwokerto</span> pilihan yang tepat
        </h2>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-[1.35fr_0.85fr] gap-7 items-stretch">
        <!-- Left Bento Cluster: 2 Small Cards + 1 Wide Bottom Card -->
        <div class="flex flex-col gap-7">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-7">
            <!-- Card 1: Slide from Left -->
            <div class="group bg-[#f8fafc] rounded-[20px] p-6 sm:p-8 lg:p-9 flex flex-col border border-black/[0.04] shadow-[0_4px_16px_rgba(0,0,0,0.03)] hover:-translate-y-1.5 hover:shadow-[0_18px_40px_rgba(0,0,0,0.08)] hover:border-[#ed1e28]/16 why-us-item slide-from-left delay-card-1">
              <div class="why-us-badge w-11 h-11 rounded-full bg-white border border-[#fee2e2] flex items-center justify-center mb-6 shadow-[0_2px_6px_rgba(0,0,0,0.04)] group-hover:scale-110 group-hover:rotate-4 group-hover:border-[#fca5a5] group-hover:bg-[#fef2f2] group-hover:shadow-[0_6px_16px_rgba(237,30,40,0.16)]">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ed1e28" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
              </div>
              <h3 class="font-jakarta text-lg sm:text-[1.1875rem] font-extrabold text-[#111827] mb-3.5 leading-[1.3]">Kelas Industri</h3>
              <p class="font-jakarta text-sm leading-[1.65] text-[#64748b] m-0">
                Kurikulum disusun bersama Telkom Group dan mitra industri lokal, sehingga materi yang dipelajari siswa selalu selaras dengan kebutuhan kerja terkini.
              </p>
            </div>

            <!-- Card 2: Slide from Top (Desktop) / Right (Mobile) -->
            <div class="group bg-[#f8fafc] rounded-[20px] p-6 sm:p-8 lg:p-9 flex flex-col border border-black/[0.04] shadow-[0_4px_16px_rgba(0,0,0,0.03)] hover:-translate-y-1.5 hover:shadow-[0_18px_40px_rgba(0,0,0,0.08)] hover:border-[#ed1e28]/16 why-us-item slide-from-top-card delay-card-2">
              <div class="why-us-badge w-11 h-11 rounded-full bg-white border border-[#fee2e2] flex items-center justify-center mb-6 shadow-[0_2px_6px_rgba(0,0,0,0.04)] group-hover:scale-110 group-hover:rotate-4 group-hover:border-[#fca5a5] group-hover:bg-[#fef2f2] group-hover:shadow-[0_6px_16px_rgba(237,30,40,0.16)]">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ed1e28" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
              </div>
              <h3 class="font-jakarta text-lg sm:text-[1.1875rem] font-extrabold text-[#111827] mb-3.5 leading-[1.3]">Sertifikasi Kompetensi</h3>
              <p class="font-jakarta text-sm leading-[1.65] text-[#64748b] m-0">
                Uji kompetensi keahlian melalui LSP P1 internal dan sertifikasi mitra industri, menjadi bukti kemampuan siswa saat melamar kerja.
              </p>
            </div>
          </div>

          <!-- Card 4: Slide from Bottom (Wide Card) -->
          <div class="group bg-[#f8fafc] rounded-[20px] p-6 sm:p-8 lg:p-9 flex flex-col flex-1 border border-black/[0.04] shadow-[0_4px_16px_rgba(0,0,0,0.03)] hover:-translate-y-1.5 hover:shadow-[0_18px_40px_rgba(0,0,0,0.08)] hover:border-[#ed1e28]/16 why-us-item slide-from-bottom delay-card-wide">
            <div class="why-us-badge w-11 h-11 rounded-full bg-white border border-[#fee2e2] flex items-center justify-center mb-6 shadow-[0_2px_6px_rgba(0,0,0,0.04)] group-hover:scale-110 group-hover:rotate-4 group-hover:border-[#fca5a5] group-hover:bg-[#fef2f2] group-hover:shadow-[0_6px_16px_rgba(237,30,40,0.16)]">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ed1e28" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                <polyline points="2 17 12 22 22 17"></polyline>
                <polyline points="2 12 12 17 22 12"></polyline>
              </svg>
            </div>
            <h3 class="font-jakarta text-lg sm:text-[1.1875rem] font-extrabold text-[#111827] mb-3.5 leading-[1.3]">4 Program Keahlian & Pembinaan Karakter</h3>
            <p class="font-jakarta text-sm leading-[1.65] text-[#64748b] m-0">
              RPL, PG, TKJ, dan TJAT masing-masing punya laboratorium, jalur sertifikasi, dan mitra industri sendiri. Ditopang program asrama opsional serta pendampingan akademik harian, siswa tumbuh matang secara teknis maupun sikap kerja.
            </p>
          </div>
        </div>

        <!-- Right Side: Card 3 - Slide from Right (Red Card) -->
        <div class="group relative bg-[#ed1e28] rounded-[20px] p-7 sm:p-9 lg:p-11 text-white overflow-hidden flex flex-col shadow-[0_14px_36px_rgba(237,30,40,0.22)] hover:-translate-y-1.5 hover:shadow-[0_24px_52px_rgba(237,30,40,0.32)] why-us-item slide-from-right delay-card-red">
          <!-- Concentric Ring Background Texture -->
          <svg class="absolute inset-0 w-full h-full pointer-events-none z-1 opacity-90 transition-transform duration-500 group-hover:scale-105" viewBox="0 0 400 600" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="200" cy="180" r="160" stroke="rgba(255, 255, 255, 0.08)" stroke-width="32" />
            <circle cx="200" cy="180" r="240" stroke="rgba(255, 255, 255, 0.06)" stroke-width="32" />
            <circle cx="200" cy="480" r="180" stroke="rgba(255, 255, 255, 0.07)" stroke-width="32" />
          </svg>

          <div class="relative z-2 flex flex-col h-full">
            <div class="why-us-badge w-11 h-11 rounded-full bg-white/18 flex items-center justify-center mb-6 group-hover:scale-110 group-hover:-rotate-4 group-hover:bg-white/28">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="9" y1="9" x2="15" y2="9"></line>
                <line x1="9" y1="13" x2="15" y2="13"></line>
                <line x1="9" y1="17" x2="13" y2="17"></line>
              </svg>
            </div>

            <h3 class="font-jakarta text-xl sm:text-[1.35rem] font-extrabold text-white mb-5">Visi & Misi Kami</h3>

            <p class="font-jakarta text-[0.9375rem] leading-[1.65] text-white/92 mb-5">
              Menjadi SMK rujukan nasional yang menghasilkan lulusan berkarakter, adaptif teknologi, dan berdaya saing global.
            </p>

            <p class="font-jakarta text-[0.9375rem] leading-[1.65] text-white/92 mb-8">
              Kami mewujudkannya lewat pembelajaran berbasis proyek, kemitraan erat dengan industri, dan ekosistem digital sekolah yang terintegrasi (satu data untuk siswa, orang tua, dan mitra).
            </p>

            <a href="#ppdb" class="group/btn inline-flex items-center justify-center gap-2 bg-white text-[#ed1e28] font-jakarta text-sm font-bold py-3 px-7 rounded-full shadow-[0_4px_12px_rgba(0,0,0,0.1)] self-start mt-auto hover:-translate-y-0.5 hover:scale-[1.03] hover:shadow-[0_8px_22px_rgba(0,0,0,0.2)] active:scale-[0.97] transition-all duration-200">
              <span>Daftar PPDB</span>
              <span class="inline-block transition-transform duration-200 group-hover/btn:translate-x-1">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  /* Base state before entering */
  .why-us-item {
    opacity: 0;
    will-change: opacity, transform;
    transition: opacity 700ms cubic-bezier(0.16, 1, 0.3, 1),
                transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Multi-directional slide starting offsets */
  .slide-from-top {
    transform: translateY(-28px);
  }

  .slide-from-left {
    transform: translateX(-48px) scale(0.97);
  }

  /* Card 2: slide from top on desktop, from right on mobile */
  .slide-from-top-card {
    transform: translateX(48px) scale(0.97);
  }
  @media (min-width: 640px) {
    .slide-from-top-card {
      transform: translateY(-40px) scale(0.97);
    }
  }

  .slide-from-bottom {
    transform: translateY(42px) scale(0.97);
  }

  .slide-from-right {
    transform: translateX(54px) scale(0.97);
  }

  /* Icon badges inside cards */
  .why-us-badge {
    opacity: 0;
    transform: scale(0.65);
    transition: opacity 500ms cubic-bezier(0.34, 1.56, 0.64, 1),
                transform 500ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* Triggered load animation: all glide smoothly into place */
  :global(#why-us.is-visible) .why-us-item {
    opacity: 1;
    transform: translate(0, 0) scale(1);
  }

  :global(#why-us.is-visible) .why-us-badge {
    opacity: 1;
    transform: scale(1);
  }

  /* Stagger delays */
  .delay-header { transition-delay: 20ms; }
  .delay-card-1 { transition-delay: 90ms; }
  .delay-card-2 { transition-delay: 170ms; }
  .delay-card-red { transition-delay: 250ms; }
  .delay-card-wide { transition-delay: 330ms; }

  /* Badge pop stagger delays */
  :global(#why-us.is-visible) .delay-card-1 .why-us-badge { transition-delay: 220ms; }
  :global(#why-us.is-visible) .delay-card-2 .why-us-badge { transition-delay: 300ms; }
  :global(#why-us.is-visible) .delay-card-red .why-us-badge { transition-delay: 380ms; }
  :global(#why-us.is-visible) .delay-card-wide .why-us-badge { transition-delay: 460ms; }

  /* After load animation completes: enable fluid hover states */
  :global(#why-us.animation-done) .why-us-item {
    transition: transform 250ms cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 250ms ease,
                border-color 250ms ease;
    transition-delay: 0ms !important;
    will-change: transform, box-shadow;
  }

  :global(#why-us.animation-done) .why-us-badge {
    transition: transform 220ms ease,
                background-color 220ms ease,
                border-color 220ms ease,
                box-shadow 220ms ease;
    transition-delay: 0ms !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .why-us-item,
    .why-us-badge {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  const whyUsSection = document.getElementById("why-us");
  if (whyUsSection) {
    const isReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (isReduced) {
      whyUsSection.classList.add("is-visible", "animation-done");
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            // Trigger ketika sekitar 25% dari konten seksi telah masuk ke layar
            if (entry.isIntersecting || entry.intersectionRatio >= 0.25) {
              whyUsSection.classList.add("is-visible");
              observer.unobserve(entry.target);
              setTimeout(() => {
                whyUsSection.classList.add("animation-done");
              }, 950);
            }
          });
        },
        {
          threshold: 0.25,
          rootMargin: "0px",
        }
      );
      observer.observe(whyUsSection);
    }
  }
</script>
