---
import Container from "../Container.astro";
---

<section class="py-12 sm:py-16 lg:pt-12 lg:pb-24 bg-white" id="ppdb">
  <Container>
    <div class="max-w-[1140px] mx-auto">
      <div class="relative bg-gradient-to-br from-[#ed1e28] via-[#dc2626] to-[#c41d24] rounded-2xl sm:rounded-[32px] py-14 sm:py-18 px-6 sm:px-12 text-white overflow-hidden shadow-[0_24px_48px_-12px_rgba(237,30,40,0.32)] text-center">
        <!-- Circular Rings Pattern Overlay -->
        <svg class="absolute inset-0 w-full h-full pointer-events-none z-1" viewBox="0 0 1200 400" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="150" cy="200" r="160" stroke="rgba(255, 255, 255, 0.07)" stroke-width="32" />
          <circle cx="150" cy="200" r="260" stroke="rgba(255, 255, 255, 0.05)" stroke-width="32" />
          <circle cx="1050" cy="200" r="180" stroke="rgba(255, 255, 255, 0.07)" stroke-width="32" />
          <circle cx="1050" cy="200" r="280" stroke="rgba(255, 255, 255, 0.05)" stroke-width="32" />
        </svg>

        <div class="relative z-2 max-w-[780px] mx-auto flex flex-col items-center">
          <!-- Status Badge -->
          <div class="inline-block bg-white/18 border border-white/30 font-jakarta text-xs font-bold tracking-[0.08em] py-1.5 px-4.5 rounded-full mb-6">
            <span>PENDAFTARAN DIBUKA</span>
          </div>

          <!-- Title -->
          <h2 class="font-poppins text-3xl sm:text-4xl lg:text-[2.75rem] font-bold leading-[1.15] text-white mb-5 tracking-[-0.025em]">
            Mulai langkahmu di PPDB 2026/2027
          </h2>

          <!-- Subtitle -->
          <p class="font-jakarta text-sm sm:text-base leading-[1.65] text-white/90 mb-9 max-w-[620px]">
            Satu alur pendaftaran, satu akun, satu status. Pantau progres seleksi langsung dari dashboard calon siswa.
          </p>

          <!-- Action Buttons -->
          <div class="flex items-center gap-4 mb-12 flex-wrap justify-center">
            <a href="https://wa.me/6281229701800" target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-3 bg-white text-[#ed1e28] font-jakarta text-[0.9375rem] font-bold py-2 pl-6 pr-2.5 rounded-full shadow-[0_4px_14px_rgba(0,0,0,0.12)] hover:bg-[#fef2f2] hover:-translate-y-0.5 hover:shadow-[0_6px_18px_rgba(0,0,0,0.16)] transition-all duration-200">
              <span>Daftar PPDB 2026</span>
              <span class="w-8 h-8 rounded-full bg-[#ed1e28] text-white flex items-center justify-center shrink-0 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="7" y1="17" x2="17" y2="7"></line>
                  <polyline points="7 7 17 7 17 17"></polyline>
                </svg>
              </span>
            </a>

            <a href="https://wa.me/6281229701800?text=Halo%20Admin,%20saya%20ingin%20unduh%20brosur%20PPDB%20SMK%20Telkom%20Purwokerto" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center py-3.5 px-7 rounded-full border-[1.5px] border-white/80 bg-transparent hover:bg-white/15 hover:border-white text-white font-jakarta text-[0.9375rem] font-bold transition-all duration-200">
              <span>Unduh Brosur</span>
            </a>
          </div>

          <!-- Bottom Highlights Divider -->
          <div class="flex items-center justify-center gap-6 sm:gap-8 pt-7 border-t border-white/20 w-full flex-wrap">
            <div class="inline-flex items-center gap-2 font-jakarta text-sm text-white/90">
              <span class="text-xs">◆</span>
              <span>Gelombang 2 (sisa 148 kursi)</span>
            </div>
            <div class="inline-flex items-center gap-2 font-jakarta text-sm text-white/90">
              <span class="text-xs">◆</span>
              <span>Beasiswa prestasi tersedia</span>
            </div>
            <div class="inline-flex items-center gap-2 font-jakarta text-sm text-white/90">
              <span class="text-xs">◆</span>
              <span>Pendaftaran 100% daring</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
