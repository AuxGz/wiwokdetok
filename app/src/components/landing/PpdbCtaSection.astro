---
import Container from "../Container.astro";
---

<section class="ppdb-cta-section" id="ppdb">
  <Container>
    <div class="ppdb-container-inner">
      <div class="ppdb-banner-card">
        <!-- Circular Rings Pattern Overlay -->
        <svg class="ppdb-bg-rings" viewBox="0 0 1200 400" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="150" cy="200" r="160" stroke="rgba(255, 255, 255, 0.07)" stroke-width="32" />
          <circle cx="150" cy="200" r="260" stroke="rgba(255, 255, 255, 0.05)" stroke-width="32" />
          <circle cx="1050" cy="200" r="180" stroke="rgba(255, 255, 255, 0.07)" stroke-width="32" />
          <circle cx="1050" cy="200" r="280" stroke="rgba(255, 255, 255, 0.05)" stroke-width="32" />
        </svg>

        <div class="ppdb-card-content">
          <!-- Status Badge -->
          <div class="ppdb-status-badge">
            <span>PENDAFTARAN DIBUKA</span>
          </div>

          <!-- Title -->
          <h2 class="ppdb-main-title">
            Mulai langkahmu di PPDB 2026/2027
          </h2>

          <!-- Subtitle -->
          <p class="ppdb-subtitle">
            Satu alur pendaftaran, satu akun, satu status. Pantau progres seleksi langsung dari dashboard calon siswa.
          </p>

          <!-- Action Buttons -->
          <div class="ppdb-buttons-row">
            <a href="https://wa.me/6281229701800" target="_blank" rel="noopener noreferrer" class="btn-daftar-now">
              <span>Daftar Sekarang</span>
              <span class="btn-icon-circle">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="7" y1="17" x2="17" y2="7"></line>
                  <polyline points="7 7 17 7 17 17"></polyline>
                </svg>
              </span>
            </a>

            <a href="#about" class="btn-unduh-brosur">
              <span>Unduh Brosur</span>
            </a>
          </div>

          <!-- Bottom Highlights Divider -->
          <div class="ppdb-highlights-row">
            <div class="highlight-item">
              <span class="diamond-icon">◆</span>
              <span>Gelombang 2 — sisa 148 kursi</span>
            </div>
            <div class="highlight-item">
              <span class="diamond-icon">◆</span>
              <span>Beasiswa prestasi tersedia</span>
            </div>
            <div class="highlight-item">
              <span class="diamond-icon">◆</span>
              <span>Pendaftaran 100% daring</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  .ppdb-cta-section {
    padding: 3rem 0 6rem 0;
    background-color: #ffffff;
  }

  .ppdb-container-inner {
    max-width: 1140px;
    margin-left: auto;
    margin-right: auto;
  }

  .ppdb-banner-card {
    position: relative;
    background-color: #ed1e28;
    border-radius: 24px;
    padding: 4.5rem 3rem 3.5rem 3rem;
    color: #ffffff;
    overflow: hidden;
    box-shadow: 0 18px 42px rgba(237, 30, 40, 0.25);
    text-align: center;
  }

  .ppdb-bg-rings {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .ppdb-card-content {
    position: relative;
    z-index: 2;
    max-width: 780px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ppdb-status-badge {
    display: inline-block;
    background-color: rgba(255, 255, 255, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.3);
    font-family: var(--font-jakarta);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 0.4rem 1.15rem;
    border-radius: 9999px;
    margin-bottom: 1.5rem;
  }

  .ppdb-main-title {
    font-family: var(--font-poppins);
    font-size: 2.75rem;
    font-weight: 800;
    line-height: 1.15;
    color: #ffffff;
    margin-bottom: 1.25rem;
    letter-spacing: -0.025em;
  }

  .ppdb-subtitle {
    font-family: var(--font-jakarta);
    font-size: 1rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 2.25rem;
    max-width: 620px;
  }

  .ppdb-buttons-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 3rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn-daftar-now {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background-color: #ffffff;
    color: #ed1e28;
    font-family: var(--font-jakarta);
    font-size: 0.9375rem;
    font-weight: 700;
    padding: 0.65rem 0.65rem 0.65rem 1.65rem;
    border-radius: 9999px;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
    transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
  }

  .btn-daftar-now:hover {
    background-color: #fef2f2;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.16);
  }

  .btn-icon-circle {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: #ed1e28;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .btn-unduh-brosur {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.75rem;
    border-radius: 9999px;
    border: 1.5px solid rgba(255, 255, 255, 0.8);
    background-color: transparent;
    color: #ffffff;
    font-family: var(--font-jakarta);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .btn-unduh-brosur:hover {
    background-color: rgba(255, 255, 255, 0.15);
    border-color: #ffffff;
  }

  .ppdb-highlights-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    padding-top: 1.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    width: 100%;
    flex-wrap: wrap;
  }

  .highlight-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-jakarta);
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.9);
  }

  .diamond-icon {
    font-size: 0.75rem;
    color: #ffffff;
  }

  @media (max-width: 992px) {
    .ppdb-main-title {
      font-size: 2.25rem;
    }
  }

  @media (max-width: 640px) {
    .ppdb-banner-card {
      padding: 3rem 1.5rem 2.5rem 1.5rem;
    }

    .ppdb-main-title {
      font-size: 1.75rem;
    }

    .ppdb-highlights-row {
      flex-direction: column;
      gap: 0.75rem;
    }
  }
</style>
