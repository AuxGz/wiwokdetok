---
import Container from "../Container.astro";
---

<section class="relative py-12 lg:pt-12 lg:pb-24 bg-white overflow-visible" id="about">
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-[1.05fr_0.95fr] gap-14 lg:gap-16 items-center max-w-[1140px] mx-auto">
      <!-- Left Column: Copy -->
      <div class="flex flex-col">
        <div class="animate-about-eyebrow inline-flex items-center gap-2.5 font-poppins text-[0.8125rem] font-bold text-[#ed1e28] tracking-[0.06em] uppercase mb-5">
          <span class="inline-block w-[22px] h-[2px] bg-[#ed1e28] rounded-[1px]"></span>
          <span>TENTANG KAMI</span>
        </div>

        <h2 class="animate-about-heading font-poppins text-3xl sm:text-4xl lg:text-[2.85rem] font-bold leading-[1.12] text-[#111827] tracking-[-0.025em] mb-5.5">
          Apa itu <span class="text-[#ed1e28]">SMK Telkom<br />Purwokerto</span>?
        </h2>

        <p class="animate-about-desc font-jakarta text-[0.9375rem] leading-[1.7] text-[#4b5563] mb-4.5">
          SMK Telkom Purwokerto berada di bawah naungan Yayasan Pendidikan Telkom (YPT) dan menjadi bagian dari jaringan Telkom Schools. Sejak angkatan pertama, sekolah ini fokus mencetak lulusan siap kerja di bidang perangkat lunak, jaringan, dan industri kreatif.
        </p>

        <p class="animate-about-desc font-jakarta text-[0.9375rem] leading-[1.7] text-[#4b5563] [&_strong]:font-bold [&_strong]:text-[#1f2937]">
          Terdapat empat program keahlian: <strong>RPL</strong>, <strong>PG</strong>, <strong>TKJ</strong>, dan <strong>TJAT</strong>, masing-masing dengan laboratorium, sertifikasi, dan jalur karier yang jelas.
        </p>
      </div>

      <!-- Right Column: Visual Photo Stack with Red Accent Card -->
      <div class="flex justify-center lg:justify-end items-center relative">
        <div class="group relative w-full max-w-[480px] lg:max-w-[550px] mx-auto lg:ml-auto">
          <!-- Red Accent Card Behind -->
          <div class="animate-about-card absolute top-[11.5%] bottom-[4.5%] left-[22%] right-[1.2%] bg-[#ed1e28] rounded-2xl z-1 pointer-events-none transition-transform duration-250 group-hover:translate-x-0.5 group-hover:translate-y-0.5" aria-hidden="true"></div>

          <!-- Campus Building Photo -->
          <img
            src="/images/brand/gedung-sekolah.png"
            alt="Gedung SMK Telkom Purwokerto"
            class="animate-about-photo relative z-2 w-full h-auto block transition-transform duration-250 group-hover:-translate-y-0.5"
            width="607"
            height="333"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </Container>
</section>
