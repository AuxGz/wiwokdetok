---
import Container from "../Container.astro";

const defaultStats = [
  {
    number: "910+",
    display: "910+",
    label: "Siswa aktif",
  },
  {
    number: "4",
    display: "4",
    label: "Program keahlian",
  },
  {
    number: "182+",
    display: "182+",
    label: "Mitra industri",
  },
  {
    number: "150",
    display: "150",
    label: "Prestasi (5 thn)",
  },
];

let stats = defaultStats.map((s) => ({ ...s }));

try {
  const { prisma } = await import("../../server/lib/prisma.js");
  const settings = await prisma.systemSetting.findMany({
    where: {
      key: {
        in: ["stats_siswa", "stats_jurusan", "stats_mitra", "stats_prestasi"],
      },
    },
  });

  if (settings && settings.length > 0) {
    const valMap: Record<string, string> = {};
    for (const s of settings) {
      if (s.value) valMap[s.key] = s.value;
    }

    if (valMap.stats_siswa) {
      stats[0].number = valMap.stats_siswa;
      stats[0].display = valMap.stats_siswa;
    }
    if (valMap.stats_jurusan) {
      stats[1].number = valMap.stats_jurusan;
      stats[1].display = valMap.stats_jurusan;
    }
    if (valMap.stats_mitra) {
      stats[2].number = valMap.stats_mitra;
      stats[2].display = valMap.stats_mitra;
    }
    if (valMap.stats_prestasi) {
      stats[3].number = valMap.stats_prestasi;
      stats[3].display = valMap.stats_prestasi;
    }
  }
} catch {
  // Gunakan data default jika database offline atau belum terisi
}
---

<section class="pt-6 pb-16 bg-white" id="stats">
  <Container>
    <div class="bg-white border border-black/[0.06] rounded-[20px] shadow-[0_10px_30px_rgba(0,0,0,0.05)] py-8 sm:py-10 px-6 sm:px-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-0 items-center">
      {
        stats.map((item) => (
          <div class="flex flex-col items-start px-0 lg:px-8 first:lg:pl-4 relative lg:[&:not(:last-child)]:border-r lg:[&:not(:last-child)]:border-slate-100">
            <div class="stat-num font-poppins text-4xl sm:text-[2.75rem] font-extrabold text-[#111827] leading-[1.1] mb-1.5 tracking-[-0.02em] [font-variant-numeric:tabular-nums]" data-value={item.display}>{item.display}</div>
            <div class="font-jakarta text-[0.8125rem] text-gray-500 font-medium">{item.label}</div>
          </div>
        ))
      }
    </div>
  </Container>
</section>

<script>
  const isReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!isReduced) {
    const statCards = document.querySelectorAll(".stat-num");

    // Initialize to 0 so the count-up starts visibly from zero
    statCards.forEach((c) => {
      const rawVal = c.getAttribute("data-value") || "";
      const suffix = rawVal.replace(/[0-9]/g, "");
      c.textContent = `0${suffix}`;
    });

    const observer = new IntersectionObserver((entries, obs) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const numEl = entry.target as HTMLElement;
          if (numEl && !numEl.classList.contains("counted")) {
            numEl.classList.add("counted");
            const rawVal = numEl.getAttribute("data-value") || "";
            const target = parseInt(rawVal.replace(/\D/g, ""), 10);
            const suffix = rawVal.replace(/[0-9]/g, "");
            const duration = 2600; // 2.6s steady and smooth count-up
            let startTime: number | null = null;

            const step = (now: number) => {
              if (startTime === null) startTime = now;
              const elapsed = now - startTime;
              const progress = Math.max(0, Math.min(elapsed / duration, 1));
              const ease = 1 - Math.pow(1 - progress, 2); // easeOutQuad: gradual and visibly rolling
              const current = Math.round(ease * target);
              numEl.textContent = `${current.toLocaleString("id-ID")}${suffix}`;
              if (progress < 1) {
                requestAnimationFrame(step);
              } else {
                numEl.textContent = rawVal;
              }
            };
            requestAnimationFrame(step);

            // Safety timeout to ensure final values always display
            setTimeout(() => {
              numEl.textContent = rawVal;
            }, duration + 50);
          }
          obs.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });

    statCards.forEach((c) => observer.observe(c));
  }
</script>
