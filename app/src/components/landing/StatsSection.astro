---
import Container from "../Container.astro";

const stats = [
  {
    number: "910+",
    display: "910+",
    label: "Siswa aktif",
  },
  {
    number: "4",
    display: "4",
    label: "Program keahlian",
  },
  {
    number: "182+",
    display: "182+",
    label: "Mitra industri",
  },
  {
    number: "150",
    display: "150",
    label: "Prestasi (5 thn)",
  },
];
---

<section class="stats-section" id="stats">
  <Container>
    <div class="stats-bar-card">
      {
        stats.map((item) => (
          <div class="stat-col-item">
            <div class="stat-num" data-value={item.display}>{item.display}</div>
            <div class="stat-label">{item.label}</div>
          </div>
        ))
      }
    </div>
  </Container>
</section>

<script>
  const isReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!isReduced) {
    const statCards = document.querySelectorAll(".stat-num");

    // Initialize to 0 so the count-up starts visibly from zero
    statCards.forEach((c) => {
      const rawVal = c.getAttribute("data-value") || "";
      const suffix = rawVal.replace(/[0-9]/g, "");
      c.textContent = `0${suffix}`;
    });

    const observer = new IntersectionObserver((entries, obs) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const numEl = entry.target as HTMLElement;
          if (numEl && !numEl.classList.contains("counted")) {
            numEl.classList.add("counted");
            const rawVal = numEl.getAttribute("data-value") || "";
            const target = parseInt(rawVal.replace(/\D/g, ""), 10);
            const suffix = rawVal.replace(/[0-9]/g, "");
            const duration = 2600; // 2.6s steady and smooth count-up
            let startTime: number | null = null;

            const step = (now: number) => {
              if (startTime === null) startTime = now;
              const elapsed = now - startTime;
              const progress = Math.max(0, Math.min(elapsed / duration, 1));
              const ease = 1 - Math.pow(1 - progress, 2); // easeOutQuad: gradual and visibly rolling
              const current = Math.round(ease * target);
              numEl.textContent = `${current.toLocaleString("id-ID")}${suffix}`;
              if (progress < 1) {
                requestAnimationFrame(step);
              } else {
                numEl.textContent = rawVal;
              }
            };
            requestAnimationFrame(step);

            // Safety timeout to ensure final values always display
            setTimeout(() => {
              numEl.textContent = rawVal;
            }, duration + 50);
          }
          obs.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });

    statCards.forEach((c) => observer.observe(c));
  }
</script>

<style>
  .stats-section {
    padding: 1.5rem 0 4rem 0;
    background-color: #ffffff;
  }

  .stats-bar-card {
    background-color: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 20px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    padding: 2.5rem 2rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: center;
  }

  .stat-col-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 0 2rem;
    position: relative;
  }

  .stat-col-item:first-child {
    padding-left: 1rem;
  }

  .stat-col-item:not(:last-child) {
    border-right: 1px solid #f1f5f9;
  }

  .stat-num {
    font-family: var(--font-poppins);
    font-size: 2.75rem;
    font-weight: 800;
    color: #111827;
    line-height: 1.1;
    margin-bottom: 0.35rem;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    font-family: var(--font-jakarta);
    font-size: 0.8125rem;
    color: #6b7280;
    font-weight: 500;
  }

  @media (max-width: 900px) {
    .stats-bar-card {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
      padding: 2rem 1.5rem;
    }
    .stat-col-item:not(:last-child) {
      border-right: none;
    }
    .stat-col-item {
      padding: 0;
    }
  }

  @media (max-width: 500px) {
    .stats-bar-card {
      grid-template-columns: 1fr;
    }
  }
</style>
