---
import Container from "../Container.astro";

const newsList = [
  {
    badge: "PPDB",
    date: "13 Agustus 2026",
    title: "SMPB SMK Telkom Purwokerto 2027/2028 Jalur EASY Resmi dibuka!",
    summary: "Kabar gembira! Pendaftaran SPMB SMK Telkom Purwokerto TA 2027/2028 Jalur EASY untuk calon peserta didik baru telah resmi dibuka.",
    image: "/images/image 25.png",
    featured: false,
  },
  {
    badge: "Prestasi",
    date: "11 Agustus 2026",
    title: "SMK Telkom Purwokerto: Menuju School of Global Technopreneur",
    summary: "Program School of Global Technopreneur SMK Telkom Purwokerto dirancang untuk mencetak lulusan yang jago teknologi, berkarakter, dan siap menjadi wirausahawan di tingkat global.",
    image: "/images/image 24.png",
    featured: true,
  },
  {
    badge: "Kerjasama",
    date: "28 Juli 2026",
    title: "Siswa SMK Telkom Purwokerto meraih berbagai prestasi olahraga mulai dari tingkat kabupaten sampai internasional.",
    summary: "Sepanjang Juni 2026, siswa SMK Telkom Purwokerto sukses memborong prestasi olahraga dari tingkat kabupaten hingga turnamen terbuka nasional dan internasional.",
    image: "/images/image 26.png",
    featured: false,
  },
];
---

<section class="py-12 sm:py-16 lg:pt-20 lg:pb-24 bg-white" id="berita">
  <Container>
    <div class="max-w-[1140px] mx-auto">
      <!-- Section Header -->
      <div class="flex justify-between items-end mb-10 sm:mb-14 gap-6 flex-wrap">
        <div class="flex flex-col">
          <div class="inline-flex items-center gap-2.5 mb-3.5">
            <span class="inline-block w-[22px] h-[2px] bg-[#ed1e28] rounded-[1px]"></span>
            <span class="font-poppins text-[0.8125rem] font-bold text-[#ed1e28] tracking-[0.06em] uppercase">BERITA</span>
          </div>
          <h2 class="font-poppins text-3xl sm:text-[2.25rem] lg:text-[2.75rem] font-bold leading-[1.15] text-[#111827] tracking-[-0.025em]">
            Kabar terbaru dari sekolah.
          </h2>
        </div>

        <div class="relative flex items-center justify-center">
          <a href="#berita" class="group inline-flex items-center gap-2 py-2.5 px-6 rounded-full border border-slate-200 bg-white text-[#111827] font-jakarta text-sm font-semibold shadow-[0_1px_3px_rgba(0,0,0,0.04)] hover:border-[#ed1e28] hover:text-[#ed1e28] hover:-translate-y-0.5 hover:shadow-[0_4px_12px_rgba(237,30,40,0.12)] transition-all duration-200">
            <span>Semua berita</span>
            <span class="inline-block transition-transform duration-200 group-hover:translate-x-1">→</span>
          </a>
        </div>
      </div>

      <!-- News Cards Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        {
          newsList.map((item) => (
            <article class="group bg-white border border-[#e8ecf4] rounded-[20px] overflow-hidden flex flex-col shadow-[0_4px_20px_rgba(0,0,0,0.04)] hover:-translate-y-1 hover:shadow-[0_14px_28px_rgba(0,0,0,0.08)] transition-all duration-250">
              <div class="relative w-full h-[215px] bg-slate-100 overflow-hidden">
                <span class="absolute top-4 left-4 z-2 bg-[#ed1e28] text-white font-jakarta text-xs font-bold py-1.5 px-3.5 rounded-full tracking-[0.02em] shadow-[0_2px_8px_rgba(0,0,0,0.2)]">{item.badge}</span>
                <img
                  src={item.image}
                  alt={item.title}
                  class="w-full h-full object-cover object-top block transition-transform duration-300 group-hover:scale-105"
                  width="380"
                  height="220"
                  loading="lazy"
                />
              </div>

              <div class="p-6 sm:p-7 flex flex-col flex-1">
                <span class="font-jakarta text-[0.8125rem] text-slate-400 mb-2.5">{item.date}</span>
                <h3 class="font-poppins text-lg font-bold leading-[1.45] text-[#111827] mb-3">
                  <a href="#berita" class="hover:text-[#ed1e28] transition-colors duration-150">{item.title}</a>
                </h3>
                <p class="font-jakarta text-sm text-[#64748b] leading-[1.6] m-0">{item.summary}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </Container>
</section>
