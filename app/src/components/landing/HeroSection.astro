---
import Container from "../Container.astro";
---

<section class="relative pt-2 pb-6 bg-white overflow-visible" id="hero">
  <Container>
    <div class="relative bg-gradient-to-br from-[#d62730] via-[#cd1820] to-[#c41d24] rounded-[20px] sm:rounded-[32px] pt-10 sm:pt-12 lg:pt-15 px-6 sm:px-8 lg:px-14 pb-0 shadow-[0_24px_48px_-12px_rgba(214,39,48,0.32)] overflow-hidden">
      <!-- Watermark Concentric Circles matching Figma exactly -->
      <svg class="absolute inset-0 w-full h-full pointer-events-none z-1" viewBox="0 0 1440 520" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
        <circle cx="200" cy="180" r="130" stroke="rgba(0, 0, 0, 0.065)" stroke-width="42" />
        <circle cx="200" cy="180" r="250" stroke="rgba(0, 0, 0, 0.055)" stroke-width="42" />
        <circle cx="200" cy="180" r="370" stroke="rgba(0, 0, 0, 0.045)" stroke-width="42" />
        
        <circle cx="620" cy="400" r="140" stroke="rgba(0, 0, 0, 0.05)" stroke-width="42" />
        <circle cx="620" cy="400" r="260" stroke="rgba(0, 0, 0, 0.04)" stroke-width="42" />

        <circle cx="1060" cy="190" r="140" stroke="rgba(0, 0, 0, 0.065)" stroke-width="42" />
        <circle cx="1060" cy="190" r="260" stroke="rgba(0, 0, 0, 0.055)" stroke-width="42" />
        <circle cx="1060" cy="190" r="380" stroke="rgba(0, 0, 0, 0.045)" stroke-width="42" />
      </svg>

      <div class="relative z-2 grid grid-cols-1 lg:grid-cols-[1.12fr_0.88fr] gap-6 items-end text-center lg:text-left">
        <!-- Left Column: Copy & Actions -->
        <div class="flex flex-col z-2 pb-8 lg:pb-15 items-center lg:items-start">
          <h1 class="font-poppins text-white font-bold text-4xl sm:text-[2.75rem] lg:text-[3.25rem] leading-[1.12] tracking-[-0.02em] mb-5 animate-fade-up">
            School Of Global<br />Technopreneur
          </h1>

          <p class="font-jakarta text-[0.9375rem] leading-[1.68] text-white/92 max-w-[480px] mb-9 animate-fade-up stagger-1 [&_em]:italic [&_em]:text-white [&_em]:font-semibold">
            SMK Telkom Purwokerto siap mengubah minat digitalmu menjadi keahlian profesional. Berbasis <em>Project-Based Learning</em>, sertifikasi internasional, dan terhubung langsung dengan ekosistem industri teknologi raksasa. <em>Together, We Create Future Digital Leaders.</em>
          </p>

          <div class="flex items-center justify-center lg:justify-start gap-4 flex-wrap mb-9 animate-fade-up stagger-2">
            <a href="#ppdb" class="group bg-white text-[#ed1e28] font-jakarta text-sm font-bold py-1.5 pl-5.5 pr-2 rounded-full inline-flex items-center gap-3 shadow-[0_6px_18px_rgba(0,0,0,0.12)] hover:bg-[#fafafa] hover:-translate-y-0.5 hover:shadow-[0_10px_24px_rgba(0,0,0,0.18)] active:scale-[0.98] transition-all duration-150">
              <span>Daftar PPDB 2026</span>
              <span class="w-8 h-8 rounded-full bg-[#ed1e28] flex items-center justify-center shrink-0 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                  <path d="M2.5 9.5L9.5 2.5M9.5 2.5H4.5M9.5 2.5V7.5" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </a>
            
            <a href="#jurusan" class="bg-white/10 border border-white/55 hover:border-white hover:bg-white/22 text-white font-jakarta text-sm font-semibold py-3 px-6.5 rounded-full inline-flex items-center backdrop-blur-md hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-200">
              <span>Jelajahi Sekolah</span>
            </a>
          </div>

          <div class="flex items-center justify-center lg:justify-start gap-6 flex-wrap animate-fade-up stagger-3">
            <span class="flex items-center gap-1.5 font-jakarta text-[0.8125rem] font-medium text-white/95">
              <span class="text-white text-[0.85rem] font-bold opacity-95">◆</span>
              <span>Akreditasi A</span>
            </span>
            <span class="flex items-center gap-1.5 font-jakarta text-[0.8125rem] font-medium text-white/95">
              <span class="text-white text-[0.85rem] font-bold opacity-95">◆</span>
              <span>4 Program Keahlian</span>
            </span>
            <span class="flex items-center gap-1.5 font-jakarta text-[0.8125rem] font-medium text-white/95">
              <span class="text-white text-[0.85rem] font-bold opacity-95">◆</span>
              <span>Kelas Industri Telkom</span>
            </span>
          </div>
        </div>

        <!-- Right Column: Visual Stage with White Circle, Student Photo, and Floating Card -->
        <div class="relative flex justify-center lg:justify-end items-end h-full animate-fade-up stagger-1">
          <div class="relative w-full max-w-[530px] flex justify-center items-end h-[360px] sm:h-[440px] lg:h-[520px] ml-auto">
            <!-- White Circle Backdrop -->
            <div class="absolute -bottom-[130px] sm:-bottom-[180px] lg:-bottom-[235px] left-1/2 lg:left-[54%] -translate-x-1/2 w-[380px] sm:w-[500px] lg:w-[620px] h-[380px] sm:h-[500px] lg:h-[620px] rounded-full bg-white pointer-events-none z-1 shadow-[0_10px_30px_rgba(0,0,0,0.08)]"></div>

            <!-- Authentic Student Photo -->
            <img
              src="/images/Siswa SMK Telkom Purwokerto.png"
              alt="Siswa SMK Telkom Purwokerto membawa laptop"
              class="relative z-2 h-[360px] sm:h-[440px] lg:h-[520px] w-auto max-w-none object-contain block mb-0 lg:-translate-x-[15px] drop-shadow-[0_14px_28px_rgba(0,0,0,0.22)]"
              width="460"
              height="530"
              loading="eager"
            />

            <!-- Floating Stats Card -->
            <div class="absolute bottom-4 sm:bottom-6 lg:bottom-[45px] left-1/2 -translate-x-1/2 lg:left-auto lg:right-[15px] lg:translate-x-0 z-3 bg-white rounded-[20px] py-2.5 sm:py-[0.85rem] px-3.5 sm:px-[1.4rem] shadow-[0_16px_36px_rgba(0,0,0,0.16),0_2px_6px_rgba(0,0,0,0.04)] flex items-center gap-3 sm:gap-5 border border-black/[0.03] animate-float-soft whitespace-nowrap scale-[0.88] sm:scale-100 origin-bottom">
              <div class="flex flex-col text-left">
                <span class="font-poppins text-xl sm:text-[1.375rem] font-extrabold text-[#1e1e1e] leading-[1.1]">92,4%</span>
                <span class="font-jakarta text-[0.6875rem] text-gray-500 leading-[1.35] font-medium mt-1">
                  Lulusan Langsung Kerja /<br />Kuliah / Wirausaha
                </span>
              </div>

              <div class="w-px h-[38px] bg-gray-200 shrink-0"></div>

              <div class="flex flex-col text-left">
                <span class="font-poppins text-xl sm:text-[1.375rem] font-extrabold text-[#ed1e28] leading-[1.1]">182</span>
                <span class="font-jakarta text-[0.6875rem] text-gray-500 leading-[1.35] font-medium mt-1">
                  Mitra Industri<br />Aktif
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
