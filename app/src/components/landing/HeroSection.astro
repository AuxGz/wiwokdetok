---
import Container from "../Container.astro";
---

<section class="hero-section" id="hero">
  <Container>
    <div class="hero-banner">
      <!-- Watermark Concentric Circles matching Figma exactly -->
      <svg class="hero-circles-svg" viewBox="0 0 1440 520" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
        <circle cx="200" cy="180" r="130" stroke="rgba(0, 0, 0, 0.065)" stroke-width="42" />
        <circle cx="200" cy="180" r="250" stroke="rgba(0, 0, 0, 0.055)" stroke-width="42" />
        <circle cx="200" cy="180" r="370" stroke="rgba(0, 0, 0, 0.045)" stroke-width="42" />
        
        <circle cx="620" cy="400" r="140" stroke="rgba(0, 0, 0, 0.05)" stroke-width="42" />
        <circle cx="620" cy="400" r="260" stroke="rgba(0, 0, 0, 0.04)" stroke-width="42" />

        <circle cx="1060" cy="190" r="140" stroke="rgba(0, 0, 0, 0.065)" stroke-width="42" />
        <circle cx="1060" cy="190" r="260" stroke="rgba(0, 0, 0, 0.055)" stroke-width="42" />
        <circle cx="1060" cy="190" r="380" stroke="rgba(0, 0, 0, 0.045)" stroke-width="42" />
      </svg>

      <div class="hero-grid">
        <!-- Left Column: Copy & Actions -->
        <div class="hero-left-col">
          <h1 class="hero-title animate-fade-up">
            School Of Global<br />Technopreneur
          </h1>

          <p class="hero-description animate-fade-up stagger-1">
            SMK Telkom Purwokerto siap mengubah minat digitalmu menjadi keahlian profesional. Berbasis <em>Project-Based Learning</em>, sertifikasi internasional, dan terhubung langsung dengan ekosistem industri teknologi raksasa. <em>Together, We Create Future Digital Leaders.</em>
          </p>

          <div class="hero-actions animate-fade-up stagger-2">
            <a href="#ppdb" class="btn-ppdb-pill">
              <span>Daftar PPDB 2026</span>
              <span class="arrow-circle" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                  <path d="M2.5 9.5L9.5 2.5M9.5 2.5H4.5M9.5 2.5V7.5" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </a>
            
            <a href="#jurusan" class="btn-jelajahi-pill">
              <span>Jelajahi Sekolah</span>
            </a>
          </div>

          <div class="hero-highlights animate-fade-up stagger-3">
            <span class="hl-item">
              <span class="hl-diamond">◆</span>
              <span>Akreditasi A</span>
            </span>
            <span class="hl-item">
              <span class="hl-diamond">◆</span>
              <span>4 Program Keahlian</span>
            </span>
            <span class="hl-item">
              <span class="hl-diamond">◆</span>
              <span>Kelas Industri Telkom</span>
            </span>
          </div>
        </div>

        <!-- Right Column: Visual Stage with White Circle, Student Photo, and Floating Card -->
        <div class="hero-right-col animate-fade-up stagger-1">
          <div class="stage-container">
            <!-- White Circle Backdrop -->
            <div class="white-circle-backdrop"></div>

            <!-- Authentic Student Photo -->
            <img
              src="/images/Siswa SMK Telkom Purwokerto.png"
              alt="Siswa SMK Telkom Purwokerto membawa laptop"
              class="hero-student-photo"
              width="460"
              height="530"
              loading="eager"
            />

            <!-- Floating Stats Card -->
            <div class="floating-stats-card">
              <div class="stat-col">
                <span class="stat-val-dark">92,4%</span>
                <span class="stat-lbl">
                  Lulusan Langsung Kerja /<br />Kuliah / Wirausaha
                </span>
              </div>

              <div class="stat-divider"></div>

              <div class="stat-col">
                <span class="stat-badge-red">96</span>
                <span class="stat-lbl">
                  Mitra Industri<br />Aktif
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  .hero-section {
    position: relative;
    padding: 0.5rem 0 1.5rem 0;
    background-color: #ffffff;
    overflow: visible;
  }

  .hero-banner {
    position: relative;
    background: linear-gradient(135deg, #d62730 0%, #cd1820 60%, #c41d24 100%);
    border-radius: 32px;
    padding: 3.75rem 3.5rem 0 3.5rem;
    box-shadow: 0 24px 48px -12px rgba(214, 39, 48, 0.32);
    overflow: hidden;
  }

  .hero-circles-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .hero-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1.12fr 0.88fr;
    gap: 1.5rem;
    align-items: end;
  }

  /* Left Column */
  .hero-left-col {
    display: flex;
    flex-direction: column;
    z-index: 2;
    padding-bottom: 3.75rem;
  }

  .hero-title {
    font-family: var(--font-poppins);
    font-size: 3.25rem;
    font-weight: 700;
    line-height: 1.12;
    color: #ffffff;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }

  .hero-description {
    font-family: var(--font-jakarta);
    font-size: 0.9375rem;
    line-height: 1.68;
    color: rgba(255, 255, 255, 0.92);
    max-width: 480px;
    margin-bottom: 2.25rem;
  }

  .hero-description em {
    font-style: italic;
    color: #ffffff;
    font-weight: 600;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2.25rem;
  }

  /* White Primary Pill Button */
  .btn-ppdb-pill {
    background-color: #ffffff;
    color: #ed1e28;
    font-family: var(--font-jakarta);
    font-size: 0.875rem;
    font-weight: 700;
    padding: 0.4rem 0.45rem 0.4rem 1.4rem;
    border-radius: 9999px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
    transition: transform 0.15s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease, background-color 0.15s ease;
  }

  .btn-ppdb-pill:hover {
    background-color: #fafafa;
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.18);
  }

  .btn-ppdb-pill:active {
    transform: scale(0.98);
  }

  .arrow-circle {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: #ed1e28;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .btn-ppdb-pill:hover .arrow-circle {
    transform: translate(1px, -1px);
  }

  /* Outline Pill Button */
  .btn-jelajahi-pill {
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.55);
    color: #ffffff;
    font-family: var(--font-jakarta);
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.75rem 1.65rem;
    border-radius: 9999px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-jelajahi-pill:hover {
    background-color: rgba(255, 255, 255, 0.22);
    border-color: #ffffff;
    transform: translateY(-2px);
  }

  .btn-jelajahi-pill:active {
    transform: scale(0.98);
  }

  /* Highlights Underneath */
  .hero-highlights {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .hl-item {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-jakarta);
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.95);
  }

  .hl-diamond,
  .hl-check,
  .hl-dot {
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 700;
    opacity: 0.95;
  }

  /* Right Column: Visual Stage */
  .hero-right-col {
    position: relative;
    display: flex;
    justify-content: flex-end;
    align-items: flex-end;
    height: 100%;
  }

  .stage-container {
    position: relative;
    width: 100%;
    max-width: 530px;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    height: 520px;
    margin-left: auto;
  }

  /* White Circle Backdrop matching Figma:
     In Figma, top crest is at collar level (~145px from top),
     and curves smoothly down behind laptop and backpack to the bottom edge. */
  .white-circle-backdrop {
    position: absolute;
    bottom: -235px;
    left: 54%;
    transform: translateX(-50%);
    width: 620px;
    height: 620px;
    border-radius: 50%;
    background-color: #ffffff;
    pointer-events: none;
    z-index: 1;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
  }

  /* Student Photo:
     Scaled and anchored to the bottom edge, head sticking up into red area */
  .hero-student-photo {
    position: relative;
    z-index: 2;
    height: 520px;
    width: auto;
    max-width: none;
    object-fit: contain;
    display: block;
    margin-bottom: 0;
    transform: translateX(-15px);
    filter: drop-shadow(0 14px 28px rgba(0, 0, 0, 0.22));
  }

  /* Floating Stats Card matching Figma */
  .floating-stats-card {
    position: absolute;
    bottom: 45px;
    right: 15px;
    z-index: 3;
    background-color: #ffffff;
    border-radius: 20px;
    padding: 0.85rem 1.4rem;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.16), 0 2px 6px rgba(0, 0, 0, 0.04);
    display: flex;
    align-items: center;
    gap: 1.25rem;
    border: 1px solid rgba(0, 0, 0, 0.03);
    animation: float-soft 4s ease-in-out infinite;
  }

  @keyframes float-soft {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-4px);
    }
  }

  .stat-col {
    display: flex;
    flex-direction: column;
  }

  .stat-val-dark {
    font-family: var(--font-poppins);
    font-size: 1.375rem;
    font-weight: 800;
    color: #1e1e1e;
    line-height: 1.1;
  }

  .stat-val-red {
    font-family: var(--font-poppins);
    font-size: 1.375rem;
    font-weight: 800;
    color: #ed1e28;
    line-height: 1.1;
  }

  .stat-badge-red {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #ed1e28;
    color: #ffffff;
    font-family: var(--font-poppins);
    font-size: 0.875rem;
    font-weight: 800;
    padding: 0.15rem 0.55rem;
    border-radius: 6px;
    width: fit-content;
    line-height: 1.2;
  }

  .stat-lbl {
    font-family: var(--font-jakarta);
    font-size: 0.6875rem;
    color: #6b7280;
    line-height: 1.35;
    font-weight: 500;
    margin-top: 0.25rem;
  }

  .stat-divider {
    width: 1px;
    height: 38px;
    background-color: #e5e7eb;
    flex-shrink: 0;
  }

  @media (max-width: 1024px) {
    .hero-banner {
      padding: 3rem 2rem 0 2rem;
    }
    .hero-grid {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 2rem;
    }
    .hero-left-col {
      align-items: center;
      padding-bottom: 2rem;
    }
    .hero-actions {
      justify-content: center;
    }
    .hero-highlights {
      justify-content: center;
    }
    .hero-title {
      font-size: 2.75rem;
    }
    .stage-container {
      height: 440px;
    }
    .hero-student-photo {
      height: 440px;
      transform: none;
    }
    .white-circle-backdrop {
      width: 500px;
      height: 500px;
      bottom: -180px;
      left: 50%;
    }
    .floating-stats-card {
      right: 50%;
      transform: translateX(50%);
      bottom: 25px;
    }
    @keyframes float-soft {
      0%, 100% {
        transform: translate(50%, 0);
      }
      50% {
        transform: translate(50%, -4px);
      }
    }
  }

  @media (max-width: 640px) {
    .hero-banner {
      padding: 2.5rem 1.5rem 0 1.5rem;
      border-radius: 20px;
    }
    .hero-title {
      font-size: 2.25rem;
    }
    .stage-container {
      height: 360px;
    }
    .hero-student-photo {
      height: 360px;
    }
    .white-circle-backdrop {
      width: 380px;
      height: 380px;
      bottom: -130px;
    }
    .floating-stats-card {
      padding: 0.65rem 1rem;
      gap: 0.85rem;
    }
  }
</style>
