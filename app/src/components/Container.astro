---
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<div class={`container ${className}`.trim()}>
  <slot />
</div>

<style>
  .container {
    width: 100%;
    max-width: 1140px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
</style>
