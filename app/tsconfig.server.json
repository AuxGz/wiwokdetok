{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist/node",
    "rootDir": "./src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/server/**/*", "src/generated/**/*"],
  "exclude": ["node_modules", "dist", "tests", "src/pages", "src/components", "src/layouts", "src/styles"]
}
