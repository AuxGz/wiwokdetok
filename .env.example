# ==============================================================================
# LINGKUNGAN APLIKASI
# ==============================================================================
NODE_ENV=development
PORT=3000

# Pada development lokal: mengarah ke port frontend Astro (4321)
# Pada produksi: diatur ke domain HTTPS publik sekolah (misal https://www.sekolah.sch.id)
PUBLIC_SITE_URL=http://localhost:4321

# ==============================================================================
# POSTGRESQL & DATABASE KREDENSIAL
# CATATAN KEAMANAN: Seluruh password database WAJIB URL-safe.
# Disarankan menghasilkan nilai hex acak dengan: openssl rand -hex 24
# ==============================================================================
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_SUPERUSER_HEX_PASSWORD

APP_DB_USER=app_user
APP_DB_PASSWORD=CHANGE_ME_APP_HEX_PASSWORD

CMS_DB_USER=directus_user
CMS_DB_PASSWORD=CHANGE_ME_CMS_HEX_PASSWORD

# Prisma Connection URL (untuk host dev mengarah ke localhost, di docker dioverride ke postgres)
DATABASE_URL=postgresql://app_user:CHANGE_ME_APP_HEX_PASSWORD@localhost:5432/app_db?schema=public

# Shadow Database URL untuk alur kerja 'prisma migrate dev' (HANYA untuk development lokal, TIDAK dipakai di production)
SHADOW_DATABASE_URL=postgresql://app_user:CHANGE_ME_APP_HEX_PASSWORD@localhost:5432/app_shadow_db?schema=public

# ==============================================================================
# DIRECTUS CMS CONFIGURATION
# Untuk host dev: gunakan localhost:8055
# Di dalam Docker container: Compose meng-override ke http://directus:8055
# ==============================================================================
DIRECTUS_URL=http://localhost:8055
DIRECTUS_SECRET=CHANGE_ME_RANDOM_SECRET_MIN_32_HEX_CHARS
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=CHANGE_ME_ADMIN_HEX_PASSWORD

# URL publik yang digunakan admin untuk mengakses Directus:
# - Mode SSH Tunnel: http://localhost:8055
# - Mode Subdomain Webuzo: https://cms.sekolah.sch.id
DIRECTUS_PUBLIC_URL=http://localhost:8055
