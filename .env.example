# ==============================================================================
# LINGKUNGAN APLIKASI
# ==============================================================================
NODE_ENV=development
PORT=3000

# Pada development lokal: mengarah ke port frontend Astro (4321)
# Pada produksi: diatur ke domain HTTPS publik sekolah (contoh: https://www.sekolah.sch.id)
PUBLIC_SITE_URL=http://localhost:4321

# ==============================================================================
# POSTGRESQL & DATABASE KREDENSIAL
# CATATAN KEAMANAN: Seluruh password database WAJIB URL-safe (hindari karakter @, :, /, dsb).
# Disarankan menghasilkan nilai hex acak dengan: openssl rand -hex 24
# ==============================================================================
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_SUPERUSER_HEX_PASSWORD

APP_DB_USER=app_user
APP_DB_PASSWORD=CHANGE_ME_APP_HEX_PASSWORD

# Prisma Connection URL (pada host lokal dev mengarah ke localhost:5432, di dalam Docker Compose menggunakan hostname 'postgres')
DATABASE_URL=postgresql://app_user:CHANGE_ME_APP_HEX_PASSWORD@localhost:5432/app_db?schema=public

# Shadow Database URL khusus alur kerja 'prisma migrate dev' (hanya digunakan saat membuat file migrasi di dev lokal)
SHADOW_DATABASE_URL=postgresql://app_user:CHANGE_ME_APP_HEX_PASSWORD@localhost:5432/app_shadow_db?schema=public
